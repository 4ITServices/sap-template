{
  "name": "sap-template-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Stop the container when the VS Code window/project is CLOSED, so containers
  // don't pile up and exhaust the Docker VM's RAM. Unstopped containers from
  // closed projects accumulate until the kernel OOM-killer fires and takes down
  // the active window's extension host (symptom: "command not found" loops).
  // While the project stays OPEN the container — and the detached tmux session
  // below — still survives window reloads, reconnects and host sleep; only a
  // real close/quit stops it. For a deliberately always-on service, run it as a
  // plain `docker run` daemon rather than flipping this back to "none".
  "shutdownAction": "stopContainer",
  // tini as PID 1: reap zombie/orphan processes from agentic background tasks
  // and avoid the process-group signal cascade that can crash Claude (exit 137).
  "init": true,

  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "initializeCommand": "mkdir -p ${HOME}/.claude",

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "humao.rest-client",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-azureresourcegroups",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        // Run the integrated terminal inside a persistent tmux session so a
        // long Claude Code run survives window reload, full VS Code restart,
        // SSH drop and host sleep. Each tab gets its own session
        // (`claude-<pid>`) so several Claude Code instances run in parallel;
        // on revival each reopened tab reattaches a detached one. List/reattach
        // from any shell: `tmux ls` then `tmux attach -t <name>`.
        "terminal.integrated.defaultProfile.linux": "tmux",
        "terminal.integrated.profiles.linux": {
          "tmux": {
            "path": "bash",
            "args": ["${workspaceFolder}/.devcontainer/tmux-session.sh"],
            "icon": "terminal-tmux"
          },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        },
        // Tasks/debuggers use a plain shell, never tmux.
        "terminal.integrated.automationProfile.linux": { "path": "bash" },
        // Survive window reloads by reconnecting to the live process.
        "terminal.integrated.enablePersistentSessions": true,
        // Never let an extension's env contribution auto-relaunch (= kill) a
        // terminal that is about to host, or is hosting, a Claude session.
        "terminal.integrated.environmentChangesRelaunch": false,
        "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
        // Keep far more transcript in the buffer / restored after a reload.
        "terminal.integrated.scrollback": 20000,
        "terminal.integrated.persistentSessionScrollback": 1000,
        // Silence the Python extension's env-collection churn (venv activation
        // + .env injection) — the main trigger of the relaunch prompt.
        "python.terminal.activateEnvironment": false,
        "python.envFile": ""
      }
    }
  },

  "onCreateCommand": {
    "git-config": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global user.email 'jeanbaptiste.mack@outlook.com' && git config --global user.name 'jeanbaptistemack'",
    "claude-dirs": "mkdir -p /home/vscode/.claude/tmp /home/vscode/.claude/logs /tmp/claude-code"
  },

  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-create.sh",

  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-start.sh",

  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:HOME}/.claude/bin:${containerEnv:PATH}",
    "TMPDIR": "/tmp/claude-code"
  },

  "containerEnv": {
    "HISTFILE": "${containerWorkspaceFolder}/.bash_history"
  }
}