# =============================================================================
# {{ project_name }} — Références des secrets (secrets_source=keyvault)
# VERSIONNÉ : ce fichier ne contient AUCUNE valeur secrète, seulement :
#   kv://<coffre>/<secret>   un secret Key Vault (coffre partagé : kv-4it-dev-partage)
#   kv://perso/<secret>      le coffre perso de la personne connectée à az
#                            (personnes.conf → kv-4it-dev-perso-<alias>)
#   gh://token               le jeton de `gh auth token`
#   une valeur en clair      configuration non secrète
# Résolu en mémoire par le lanceur : `secrets check` (noms seulement),
# `secrets run -- <commande>`. Voir .env.example pour la marche à suivre.
#
# Container partagé : kv://perso/… lit le coffre de CELUI QUI A FAIT `az login`
# (profil par défaut, ou `profil <alias>` dans un terminal).
# Fichier à la main du projet : `copier update` ne l'écrase jamais.
# Ajouter un secret : secrets set kv://perso/<nom>  (ou un gestionnaire, pour
# le coffre partagé), puis une ligne ici.
# =============================================================================

# --- GitHub ---
# Jeton GitHub de la personne (fine-grained PAT ou jeton gh), déposé une fois :
#   secrets set kv://perso/github-pat
GITHUB_PERSONAL_ACCESS_TOKEN=kv://perso/github-pat
GH_TOKEN=kv://perso/github-pat
{%- if project_type != "base" %}

# --- SAP Connexion (HTTP/ADT) ---
SAP_URL=https://192.168.50.112:44300
SAP_USER=kv://perso/sap-user
SAP_PASSWORD=kv://perso/sap-password
SAP_CLIENT=100
SAP_LANGUAGE=FR
SAP_VERIFY_SSL=false

# Mode de déploiement (adt, rfc, local)
DEPLOYMENT_MODE=adt

# Désactiver la vérification TLS (certificat auto-signé SAP dev)
NODE_TLS_REJECT_UNAUTHORIZED=0
{%- endif %}
{%- if project_type == "mcp-server" or project_type == "abap-project" %}

# --- SAP RFC (pyrfc / node-rfc) ---
SAP_ASHOST=192.168.50.112
SAP_SYSNR=00
# Liste blanche des fonctions RFC autorisées (séparées par virgules, vide = toutes)
SAP_RFC_ALLOWLIST=
{%- endif %}
{%- if project_type == "mcp-server" %}

# --- SAP GUI VM (Windows) — héberge sap-gui-mcp (remote) ---
# L'URL du serveur sap-gui-mcp se règle dans .mcp.json (entrée sap-gui-mcp),
# pas ici. MCP_VM_USER/MCP_VM_PORT servent à l'outillage VM (WinRM/Ansible).
MCP_VM_USER=kv://perso/mcp-vm-user
MCP_VM_PORT=8001

# SAP WebGUI (transaction browser) — quotes obligatoires (le fichier est
# lu par le lanceur : garder les guillemets)
SAP_WEBGUI_URL="https://192.168.50.112:44300/sap/bc/gui/sap/its/webgui?sap-client=100&sap-language=FR"

# Connexion SAP GUI (format: "nom_connexion" dans saplogon.ini)
SAP_CONNECTION=

# --- Serveur MCP ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- sap-adt-mcp — SAP Docs semantic search (optionnel) ---
# Activé automatiquement si data/sap_docs.sqlite existe + une de ces clés est
# définie. Sans clé, fallback BM25 (plein-texte, sans embeddings).
# VOYAGE_API_KEY=kv://kv-4it-dev-partage/voyage-api-key
# OPENAI_API_KEY=
{%- endif %}
{%- if project_type == "abap-project" or project_type == "fabric-pipeline" %}

# --- HANA Direct ---
SAP_HANA_HOST=192.168.50.111
SAP_HANA_PORT=30041
SAP_HANA_USER=SAPHANADB
SAP_HANA_PASSWORD=kv://kv-4it-dev-partage/sap-hana-password
SAP_HANA_SCHEMA=SAPHANADB
{%- endif %}
{%- if project_type == "fabric-pipeline" %}

# --- Azure / Microsoft Fabric ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# secret du principal de service : kv://kv-4it-dev-partage/<secret>
AZURE_CLIENT_SECRET=
{%- if enable_iac %}
AZURE_SUBSCRIPTION_ID_DEV=
AZURE_SUBSCRIPTION_ID_PRD=
{%- else %}
AZURE_SUBSCRIPTION_ID=
{%- endif %}

# OneLake / Fabric
ONELAKE_WORKSPACE_ID=
ONELAKE_LAKEHOUSE_ID=
FABRIC_CAPACITY_ID=

# ADLS Gen2 (accès direct)
AZURE_STORAGE_ACCOUNT=
AZURE_ADLS_ENDPOINT=
# AZURE_SAS_TOKEN=kv://kv-4it-dev-partage/azure-sas-token
{%- endif %}
{%- if enable_iac and project_type != "fabric-pipeline" %}

# --- Azure IaC (souscriptions DEV / PRD) ---
AZURE_SUBSCRIPTION_ID_DEV=
AZURE_SUBSCRIPTION_ID_PRD=
{%- endif %}
{%- if enable_iac %}

# --- OpenTofu State Storage (généré par bootstrap) ---
TF_STATE_RESOURCE_GROUP_DEV=rg-{{ iac_short_name }}-tfstate-dev
TF_STATE_STORAGE_ACCOUNT_DEV=st{{ iac_short_name }}tfstatedev
TF_STATE_RESOURCE_GROUP_PRD=rg-{{ iac_short_name }}-tfstate-prd
TF_STATE_STORAGE_ACCOUNT_PRD=st{{ iac_short_name }}tfstateprd
{%- endif %}


# --- Variables propres au projet (hooks post-*-project.sh, NetBird…) ---
# Exemple : la clé NetBird du container, lue par post-start-project.sh
# NETBIRD_SETUP_KEY_DEVCONTAINER=kv://kv-4it-dev-partage/netbird-setup-key-devcontainer
