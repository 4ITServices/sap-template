# =============================================================================
# Environment of every dbt run in this workspace — the variables the project's
# Jinja reads with env_var(). No secret here: this file is committed.
#
# Loaded by `just v1|v2` and the `dbt` shell function, by dbt Power User
# (python.envFile) and by dbt v2 + its extension (a .env link in the project
# directory points here). A variable already set in the shell wins.
#
# PROJECT-OWNED (copier _skip_if_exists). DBT_PROFILES_DIR is not negotiable:
# whatever is written here, the wrappers put it back on profiles/.
# Plain KEY=value lines, no `export`, no quotes needed.
# =============================================================================
DBT_SEND_ANONYMOUS_USAGE_STATS=false
