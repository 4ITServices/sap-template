#!/bin/sh
# =============================================================================
# gh — enveloppe de gh (TEMPLATE-OWNED, secrets_source=keyvault), liée en
# ~/.local/bin/gh (avant /usr/bin dans le PATH) par secrets_install.
#
# La fonction de terminal `gh` (lib-secrets.sh, via ~/.bashrc) n'existe que
# dans un shell interactif : ~/.bashrc s'arrête tout de suite ailleurs. Les
# commandes de Claude Code, les scripts et les serveurs MCP lançaient donc gh
# sans jeton. Cette enveloppe donne à gh le jeton GitHub du projet, partout :
#
# Même ordre que git (git-credential-secrets get) :
#   1. GH_TOKEN déjà défini → gh tel quel ;
#   2. sinon la référence de `git-credential-secrets ref` (SECRETS_GITHUB_REF,
#      puis GH_TOKEN / GITHUB_PERSONAL_ACCESS_TOKEN de .env.refs, puis
#      kv://perso/github-pat), lue en mémoire. Raccourci sans lecture du
#      coffre : si elle vient de GITHUB_PERSONAL_ACCESS_TOKEN et que cette
#      variable est déjà dans l'environnement (claude et post-start tournent
#      sous `secrets run`), c'est la même valeur ;
#   3. échec → gh sans jeton (GITHUB_TOKEN ou son propre `gh auth login`).
# gh://token (`gh auth token`) dépend d'un `gh auth login`, perdu au rebuild :
# préférer kv://perso/github-pat.
# Le jeton passe par l'environnement de gh, jamais sur une ligne de commande.
# =============================================================================
reel=''
moi="$0"
case "$moi" in */*) ;; *) moi=$(command -v -- "$moi" 2>/dev/null) ;; esac
IFS_AVANT=$IFS; IFS=:
for d in $PATH; do
  [ -n "$d" ] && [ -x "$d/gh" ] && [ ! -d "$d/gh" ] || continue
  [ "$d/gh" -ef "$moi" ] && continue
  # une autre copie de cette enveloppe (autre projet) : l'en-tête suffit
  head -c 1024 "$d/gh" 2>/dev/null | grep -aqF 'enveloppe de gh (TEMPLATE-OWNED' && continue
  reel="$d/gh"; break
done
IFS=$IFS_AVANT
[ -n "$reel" ] || { echo "gh : binaire gh introuvable dans le PATH" >&2; exit 127; }

# Garde : la référence gh://token se résout par `gh auth token`, donc par cette
# enveloppe ; sans garde, elle se relancerait sans fin. Appel imbriqué → gh nu.
if [ -z "${GH_TOKEN:-}" ] && [ -z "${_SECRETS_GH_ENVELOPPE:-}" ]; then
  _SECRETS_GH_ENVELOPPE=1; export _SECRETS_GH_ENVELOPPE
  aide="$(dirname "$moi")/git-credential-secrets"
  command -v git-credential-secrets >/dev/null 2>&1 && aide=git-credential-secrets
  if [ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ] && [ "$("$aide" source 2>/dev/null)" = GITHUB_PERSONAL_ACCESS_TOKEN ]; then
    GH_TOKEN=$GITHUB_PERSONAL_ACCESS_TOKEN; export GH_TOKEN
  else
    t=$("$aide" jeton 2>/dev/null) || t=''
    [ -n "$t" ] && { GH_TOKEN=$t; export GH_TOKEN; }
    unset t
  fi
  unset _SECRETS_GH_ENVELOPPE
fi
exec "$reel" "$@"
