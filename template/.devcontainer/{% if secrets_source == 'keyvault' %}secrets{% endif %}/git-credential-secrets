#!/usr/bin/env bash
# git-credential-secrets — jeton GitHub lu dans Key Vault, à chaque demande,
# avec l'identité az de la personne : rien n'est écrit sur disque.
#
#   git-credential-secrets get           assistant d'identifiants git (https://github.com)
#                                        déclaré par lib-secrets.sh : credential.https://github.com.helper = secrets
#   git-credential-secrets ref [DOSSIER] référence retenue (aucune valeur) — diagnostic
#   git-credential-secrets jeton [DOSSIER]  jeton sur la sortie standard, pour une capture
#                                        en mémoire (fonction `gh` de lib-secrets.sh)
#
# Référence retenue, la première trouvée :
#   1. $SECRETS_GITHUB_REF ;
#   2. GH_TOKEN, sinon GITHUB_PERSONAL_ACCESS_TOKEN, dans le .env.refs du dépôt
#      courant (git rev-parse --show-toplevel, sinon le dossier courant, ou
#      DOSSIER), puis dans celui de
#      $SECRETS_WORKSPACE — seulement si la valeur est une référence (kv://…, gh://token) ;
#   3. kv://perso/github-pat.
# Un GH_TOKEN déjà présent dans l'environnement (claude ou post-start, lancés
# sous `secrets run`) sert tel quel pour `get`.
# En cas d'échec (pas de session az, pas de jeton), ne répond rien : git passe
# à l'assistant suivant ou demande un identifiant.
set -o pipefail

DEFAUT="kv://perso/github-pat"

# premiere_ref FICHIER NOM — valeur de NOM dans FICHIER si c'est une référence
premiere_ref() {
  [ -f "$1" ] || return 1
  awk -v n="$2" '
    { sub(/^[[:space:]]*(export[[:space:]]+)?/, "") }
    index($0, "=") && substr($0, 1, index($0, "=") - 1) ~ "^" n "[[:space:]]*$" {
      v = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]"\x27]+|[[:space:]"\x27]*([[:space:]]#.*)?$/, "", v)
      if (v ~ /^(kv:\/\/[A-Za-z0-9-]+\/[A-Za-z0-9-]+|gh:\/\/token)$/) { print v; ok = 1; exit }
    }
    END { exit !ok }' "$1"
}

github_ref() {
  local ici="${1:-}" ws f nom
  if [ -n "${SECRETS_GITHUB_REF:-}" ]; then echo "$SECRETS_GITHUB_REF"; return 0; fi
  [ -n "$ici" ] || ici="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  for ws in "$ici" "${SECRETS_WORKSPACE:-}"; do
    [ -n "$ws" ] || continue
    f="$ws/.env.refs"
    for nom in GH_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN; do
      premiere_ref "$f" "$nom" && return 0
    done
  done
  echo "$DEFAUT"
}

# jeton REF → sortie standard. `secrets mcp-headers` résout UNE référence sans
# fichier ; la valeur ne passe que par des tubes.
jeton() {
  secrets mcp-headers "t=$1" 2>/dev/null | jq -er '.t // empty' 2>/dev/null
}

case "${1:-}" in
  ref) github_ref "${2:-}" ;;
  jeton) jeton "$(github_ref "${2:-}")" ;;
  get)
    hote=""; proto=""
    while IFS= read -r ligne && [ -n "$ligne" ]; do
      case "$ligne" in host=*) hote="${ligne#host=}" ;; protocol=*) proto="${ligne#protocol=}" ;; esac
    done
    [ "$proto" = "https" ] && [ "$hote" = "github.com" ] || exit 0
    j="${GH_TOKEN:-}"
    [ -n "$j" ] || j="$(jeton "$(github_ref)")" || exit 0
    [ -n "$j" ] || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$j" ;;
  *) exit 0 ;;
esac
