#!/usr/bin/env bash
# git-credential-secrets — assistant d'identifiants git pour https://github.com.
# Fournit le jeton GitHub de la personne connectée à az (kv://perso/github-pat),
# lu dans Key Vault à chaque demande : rien n'est écrit sur disque.
# Déclaré par lib-secrets.sh :  credential.https://github.com.helper = secrets
# En cas d'échec (pas de session az, pas de jeton), ne répond rien : git passe
# à l'assistant suivant (VS Code) ou demande un identifiant.
[ "${1:-}" = "get" ] || exit 0
hote=""; proto=""
while IFS= read -r ligne && [ -n "$ligne" ]; do
  case "$ligne" in host=*) hote="${ligne#host=}" ;; protocol=*) proto="${ligne#protocol=}" ;; esac
done
[ "$proto" = "https" ] && [ "$hote" = "github.com" ] || exit 0
jeton="${GH_TOKEN:-}"
if [ -z "$jeton" ]; then
  ici="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  jeton="$(secrets run -f "${SECRETS_GITHUB_REFS:-$ici/github.refs}" -- printenv GH_TOKEN 2>/dev/null)" || exit 0
fi
[ -n "$jeton" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$jeton"
