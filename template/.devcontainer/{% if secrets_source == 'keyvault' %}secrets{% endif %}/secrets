#!/usr/bin/env bash
# secrets — résout les références d'un fichier .env.refs avec l'identité az de la personne,
# en mémoire : aucune valeur n'est écrite sur disque ni affichée.
#
#   secrets run [-f FICHIER] -- COMMANDE...   lance COMMANDE avec les variables résolues
#   secrets check [-f FICHIER]                chaque référence se résout-elle ? (noms seulement)
#   secrets qui                               compte az et coffre perso utilisés
#   secrets set kv://<coffre|perso>/<secret>  dépose une valeur saisie au clavier (masquée) ou lue sur stdin
#   secrets mcp-headers 'Nom=modèle' ...      en-têtes JSON pour le headersHelper de .mcp.json
#
# Dans le fichier (défaut : ./.env.refs), une valeur est soit en clair, soit une référence :
#   kv://<coffre>/<secret>   secret Key Vault
#   kv://perso/<secret>      secret du coffre personnel de la personne connectée à az
#   gh://token               jeton de `gh auth token`
set -eo pipefail

TENANT="${SECRETS_TENANT:-53a0f5d2-129f-454e-9ed3-1f5fed0e66e5}"
PREFIXE_PERSO="${SECRETS_PREFIXE_PERSO:-kv-4it-dev-perso-}"
API_KV="7.4"
MOTIF_DANS_TEXTE='(kv://[A-Za-z0-9-]+/[A-Za-z0-9-]+|gh://token)'
MOTIF_REF="^${MOTIF_DANS_TEXTE}\$"

# Dossier réel du script, en suivant les liens symboliques (pas de readlink -f sur tous les macOS)
src="$0"
while [ -L "$src" ]; do
  cible="$(readlink "$src")"
  case "$cible" in /*) src="$cible" ;; *) src="$(dirname "$src")/$cible" ;; esac
done
ICI="$(cd "$(dirname "$src")" && pwd)"
PERSONNES="${SECRETS_PERSONNES:-$ICI/personnes.conf}"

die() { echo "secrets: $*" >&2; exit 2; }

usage() {
  sed -n '2,14p' "$src" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- identité --------------------------------------------------------------------------

jeton_kv=""
coffre_perso=""

compte_az() {
  az account show --query user.name -o tsv 2>/dev/null || die "pas de session az : lancer 'az login'"
}

# Renseigne $coffre_perso (variable globale : jamais appelé dans un sous-shell)
trouver_coffre_perso() {
  [ -n "$coffre_perso" ] && return 0
  if [ -n "${SECRETS_COFFRE_PERSO:-}" ]; then
    coffre_perso="$SECRETS_COFFRE_PERSO"
    return 0
  fi
  local upn alias
  upn="$(compte_az | tr '[:upper:]' '[:lower:]')"
  [ -f "$PERSONNES" ] || die "fichier des personnes introuvable : $PERSONNES"
  alias="$(awk -v u="$upn" '!/^[[:space:]]*#/ { for (i = 2; i <= NF; i++) if (tolower($i) == u) { print $1; exit } }' "$PERSONNES")"
  [ -n "$alias" ] || die "le compte $upn n'est pas dans $PERSONNES : pas de coffre perso"
  coffre_perso="$PREFIXE_PERSO$alias"
}

obtenir_jeton() {
  [ -n "$jeton_kv" ] && return 0
  jeton_kv="$(az account get-access-token --tenant "$TENANT" --resource https://vault.azure.net \
    --query accessToken -o tsv 2>/dev/null)" || die "pas de jeton Key Vault : lancer 'az login'"
}

# --- résolution ------------------------------------------------------------------------

valeur=""
erreur=""
cache_refs=()
cache_vals=()
n_cache=0

# lire_kv COFFRE SECRET → $valeur, ou code ≠ 0 et $erreur (jamais de valeur dans $erreur)
lire_kv() {
  local coffre="$1" nom="$2" rep code
  obtenir_jeton
  # Le jeton passe par stdin (-K -), jamais sur la ligne de commande (visible dans ps).
  rep="$(printf 'header = "Authorization: Bearer %s"\n' "$jeton_kv" |
    curl -sS -K - -w '\n%{http_code}' "https://$coffre.vault.azure.net/secrets/$nom?api-version=$API_KV" 2>/dev/null)" ||
    { erreur="injoignable"; return 1; }
  code="${rep##*$'\n'}"
  rep="${rep%$'\n'*}"
  if [ "$code" != "200" ]; then
    erreur="HTTP $code $(printf '%s' "$rep" | jq -r '.error.code // empty' 2>/dev/null)"
    return 1
  fi
  valeur="$(printf '%s' "$rep" | jq -r '.value')"
}

# resoudre REF → $valeur (une seule lecture par référence distincte)
resoudre() {
  local ref="$1" i r
  for ((i = 0; i < n_cache; i++)); do
    if [ "${cache_refs[$i]}" = "$ref" ]; then
      valeur="${cache_vals[$i]}"
      return 0
    fi
  done
  case "$ref" in
    gh://token)
      valeur="$(gh auth token 2>/dev/null)" || { erreur="'gh auth token' a échoué (gh auth login ?)"; return 1; } ;;
    kv://perso/*)
      trouver_coffre_perso
      lire_kv "$coffre_perso" "${ref#kv://perso/}" || return 1 ;;
    kv://*/*)
      r="${ref#kv://}"
      lire_kv "${r%%/*}" "${r#*/}" || return 1 ;;
    *)
      erreur="référence inconnue"; return 1 ;;
  esac
  cache_refs[n_cache]="$ref"
  cache_vals[n_cache]="$valeur"
  n_cache=$((n_cache + 1))
}

# --- lecture du fichier ----------------------------------------------------------------

noms=()
vals=()
n_vars=0

charger() {
  local f="$1" ligne nom val
  [ -f "$f" ] || die "fichier introuvable : $f"
  while IFS= read -r ligne || [ -n "$ligne" ]; do
    ligne="${ligne#"${ligne%%[![:space:]]*}"}"
    case "$ligne" in '' | '#'*) continue ;; esac
    ligne="${ligne#export }"
    case "$ligne" in *=*) ;; *) continue ;; esac
    nom="${ligne%%=*}"
    nom="${nom%"${nom##*[![:space:]]}"}"
    val="${ligne#*=}"
    val="${val#"${val%%[![:space:]]*}"}"
    [[ $nom =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "nom de variable invalide dans $f : $nom"
    if [ ${#val} -ge 2 ] && { [[ $val == \"*\" ]] || [[ $val == \'*\' ]]; }; then
      val="${val:1:${#val}-2}"
    else
      val="${val%%[[:space:]]#*}"
      val="${val%"${val##*[![:space:]]}"}"
    fi
    noms[n_vars]="$nom"
    vals[n_vars]="$val"
    n_vars=$((n_vars + 1))
  done <"$f"
}

est_ref() { [[ $1 =~ $MOTIF_REF ]]; }

# --- commandes -------------------------------------------------------------------------

cmd_run() {
  [ $# -gt 0 ] || die "rien à lancer : secrets run -- COMMANDE..."
  charger "$fichier"
  local i
  for ((i = 0; i < n_vars; i++)); do
    if est_ref "${vals[$i]}"; then
      resoudre "${vals[$i]}" || die "${noms[$i]} (${vals[$i]}) : $erreur — commande non lancée"
      export "${noms[$i]}=$valeur"
    else
      export "${noms[$i]}=${vals[$i]}"
    fi
  done
  unset jeton_kv valeur cache_vals vals
  exec "$@"
}

cmd_check() {
  charger "$fichier"
  local i ok=0 ko=0 clair=0
  for ((i = 0; i < n_vars; i++)); do
    if est_ref "${vals[$i]}"; then
      if resoudre "${vals[$i]}"; then
        ok=$((ok + 1))
        printf '  ok     %-40s %s\n' "${noms[$i]}" "${vals[$i]}"
      else
        ko=$((ko + 1))
        printf '  ÉCHEC  %-40s %s : %s\n' "${noms[$i]}" "${vals[$i]}" "$erreur"
      fi
    else
      clair=$((clair + 1))
    fi
  done
  echo "$fichier : $ok référence(s) résolue(s), $ko échec(s), $clair valeur(s) en clair"
  [ "$ko" -eq 0 ]
}

cmd_qui() {
  echo "compte az     : $(compte_az)"
  echo "tenant        : $TENANT"
  trouver_coffre_perso
  echo "coffre perso  : $coffre_perso"
}

cmd_set() {
  local ref="${1:-}" coffre nom v corps rep code
  [[ $ref =~ ^kv://[A-Za-z0-9-]+/[A-Za-z0-9-]+$ ]] || die "usage : secrets set kv://<coffre|perso>/<secret>"
  coffre="${ref#kv://}"
  nom="${coffre#*/}"
  coffre="${coffre%%/*}"
  if [ "$coffre" = "perso" ]; then
    trouver_coffre_perso
    coffre="$coffre_perso"
  fi
  if [ -t 0 ]; then
    printf 'Valeur de %s/%s (non affichée) : ' "$coffre" "$nom" >&2
    IFS= read -rs v
    echo >&2
  else
    v="$(cat)"
  fi
  [ -n "$v" ] || die "valeur vide : rien déposé"
  obtenir_jeton
  corps="$(V="$v" jq -cn '{value: env.V}')"
  unset v
  # jeton par stdin (-K -), corps par un tube anonyme : ni disque ni ligne de commande
  rep="$(printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$jeton_kv" |
    curl -sS -K - -X PUT --data-binary @<(printf '%s' "$corps") -w '\n%{http_code}' \
      "https://$coffre.vault.azure.net/secrets/$nom?api-version=$API_KV" 2>/dev/null)" || die "injoignable"
  unset corps
  code="${rep##*$'\n'}"
  [ "$code" = "200" ] || die "dépôt refusé : HTTP $code $(printf '%s' "${rep%$'\n'*}" | jq -r '.error.code // empty' 2>/dev/null)"
  echo "déposé : $coffre/$nom"
}

# Chaque argument 'Nom=modèle' devient un en-tête ; le modèle peut contenir des références,
# ex. 'Authorization=Bearer kv://kv-4it-dev-partage/sap-adt-mcp-token'.
cmd_mcp_headers() {
  [ $# -gt 0 ] || die "usage : secrets mcp-headers 'Nom=modèle' ..."
  local json='{}' arg nom modele sortie ref
  for arg in "$@"; do
    nom="${arg%%=*}"
    modele="${arg#*=}"
    sortie=""
    while [[ $modele =~ $MOTIF_DANS_TEXTE ]]; do
      ref="${BASH_REMATCH[1]}"
      sortie+="${modele%%"$ref"*}"
      resoudre "$ref" || die "en-tête $nom ($ref) : $erreur"
      sortie+="$valeur"
      modele="${modele#*"$ref"}"
    done
    sortie+="$modele"
    # valeur passée par l'environnement de jq, pas par ses arguments
    json="$(printf '%s' "$json" | N="$nom" V="$sortie" jq -c '. + {(env.N): env.V}')"
  done
  printf '%s\n' "$json"
}

# --- aiguillage ------------------------------------------------------------------------

commande="${1:-}"
[ -n "$commande" ] || usage 1
shift
fichier="${SECRETS_FICHIER:-.env.refs}"
if [ "${1:-}" = "-f" ]; then
  [ -n "${2:-}" ] || die "-f attend un fichier"
  fichier="$2"
  shift 2
fi

case "$commande" in
  run)
    [ "${1:-}" = "--" ] && shift
    cmd_run "$@" ;;
  check) cmd_check ;;
  qui) cmd_qui ;;
  set) cmd_set "$@" ;;
  mcp-headers) cmd_mcp_headers "$@" ;;
  -h | --help | help) usage 0 ;;
  *) die "commande inconnue : $commande (run, check, qui, set, mcp-headers)" ;;
esac
