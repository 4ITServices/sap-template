# =============================================================================
# dbt workspace manifest — read by .devcontainer/lib-dbt.sh (lifecycle hooks,
# dbt-run.sh, dbt-doctor.sh){% if project_type == 'dbt-fleet' %}. The data products themselves are declared
# in .devcontainer/products.conf.{% endif %}
#
# This file is PROJECT-OWNED after the first render (copier _skip_if_exists):
# edit it freely, `copier update` will never overwrite it.
# Shell syntax: KEY="value", no space around '='. Apply a change: just setup
# =============================================================================
{% if project_type == 'dbt-fleet' %}
# --- Fleet: several data products, one per line of products.conf -----------
DBT_FLEET=1
# At each start, fetch where every product's branches live and fast-forward
# the clean worktrees (dirty, ahead or diverged ones are reported, never
# touched). 0 = only `just sync` does it.
DBT_SYNC_ON_START=1
# `just product-new <name> …` creates the product's own repository as
# <github_org>/<DBT_PRODUCT_REPO_PREFIX><name>
DBT_PRODUCT_REPO_PREFIX=""
{%- else %}
# --- Upstream: the dbt repository being taken over (read-only) ---------------
DBT_UPSTREAM_URL="{{ upstream_repo_url }}"
DBT_UPSTREAM_BRANCH="{{ upstream_branch }}"
# Folder that holds dbt_project.yml inside that repository ('.' = its root,
# empty = auto-detect, possible when it has a single dbt_project.yml)
DBT_PROJECT_SUBDIR="{{ dbt_project_subdir }}"
{%- endif %}
# 1 = no push by git to the upstream host{% if project_type == 'dbt-fleet' %}s{% endif %} (global pushInsteadOf, remote
# pushurl, the ssh push guard git-ssh-garde.sh as core.sshCommand, no https: a
# dead proxy, no credentials). Not ssh outside git with the same key: only a
# read-only access on the server covers that. Set to 0 only for the day a branch
# must be delivered upstream, then put it back.
DBT_UPSTREAM_PUSH_LOCK=1
# 1 = fetch https://<upstream host>/… over SSH: private dbt packages hosted
# next to the project are usually declared over HTTPS, which only CI can auth
DBT_UPSTREAM_HTTPS_TO_SSH=1

# --- Engines -----------------------------------------------------------------
{%- if project_type == 'dbt-fleet' %}
# v1 = dbt Core 1.x in the /opt/dbt-v1 venv, ONE version for every product
# (dbt Power User has one interpreter per window). A product that pins
# another version runs on this one; `just doctor` lists the bumps to commit.
DBT_V1_PINS="{{ fleet_v1_pins }}"
{%- else %}
# v1 = dbt Core 1.x in the /opt/dbt-v1 venv, at the versions the project pins:
# pyproject.toml, else requirements.txt, next to dbt_project.yml. Point at
# another file (path relative to v1/), or give pins for a project that ships
# none (e.g. "dbt-core~=1.10.0 dbt-bigquery~=1.10.0"). DBT_V1_PINS, when set,
# wins over both (pip requirement strings).
DBT_V1_PINS=""
DBT_V1_REQUIREMENTS=""
DBT_V1_FALLBACK_REQUIREMENTS=""
{%- endif %}
DBT_V1_PYTHON="{{ python_version }}"
# v2 = dbt v2 at ~/.local/bin/dbt, installed once per container build:
# latest | stable | canary | an exact version (2.0.6). Never upgraded on a
# restart — use `dbtf system update` or the dbt extension's prompt.
DBT_V2_VERSION="latest"

# --- BigQuery sandbox: the only place dbt may write --------------------------
# Seeds profiles/profiles.yml (once) and arms the write guard of dbt-run.sh:
# a run/build/seed/snapshot goes through only if every selected node resolves
# to DBT_BQ_PROJECT — and to a dataset starting with DBT_BQ_DATASET_PREFIX,
# when one is set. Empty project = no profile generated, every write refused.
DBT_BQ_PROJECT="{{ bq_sandbox_project }}"
DBT_BQ_DATASET="{{ bq_sandbox_dataset }}"
DBT_BQ_DATASET_PREFIX="{{ bq_dataset_prefix }}"
DBT_BQ_LOCATION="{{ bq_location }}"
DBT_TARGET_NAME="{{ dbt_target_name }}"
{%- if project_type == 'dbt-fleet' %}

# --- v4: a refactoring generation on dbt v2, per product (opt-in) ----------
# Products that also follow v4/<product>/ (branch <product>/v4, opened where
# their branches live from the published v2 — only tracked here). Products
# born here (no upstream, v4 only) are declared in .devcontainer/referents.conf
# (just referent-add). The v2 and the v4 of a product share package names:
# v4/ and global-v4/ write under their own prefix, <DBT_BQ_DATASET_PREFIX>_<x>
# (profiles/v4.env is generated from profiles/dbt.env with it); the guard
# requires it there and refuses it everywhere else. Empty = no v4 space.
# A FLUX — a working copy where v4 work runs in parallel with this one — is
# declared OUTSIDE this file: .devcontainer/flux.conf, one line
# DBT_V4_FLUX=<A999> (a capital letter, three digits), ignored by git. Its v4/
# and global-v4/ then write under <DBT_BQ_DATASET_PREFIX_V4>_<A999> only
# (profiles/v4-<A999>.env), its v1/v2/global build nothing and run no hook
# (whatever the settings below approve: they are this copy's), and this copy
# never writes there. DBT_V4_FLUX=H is the HARMONIZED line: a long-lived copy
# whose v4 is this copy's (the ISO line, outputs equal to production) plus one
# convergence per deviation, under <DBT_BQ_DATASET_PREFIX_V4>_H — where this
# copy never writes. A flux is separated in BigQuery only, not in git: its
# worktrees follow the same branches as this copy's. Never set DBT_V4_FLUX
# here: every dbt command would be refused.
# The MAIN working copy is NAMED, by its real path in the container (e.g.
# "/workspaces/<folder>"): the one copy whose v4 writes the main v4 space and
# that writes the container's state (engines, ~/.bashrc, global git settings).
# As soon as a v4 is declared, a copy that is neither the main one nor a flux
# (a clone, a flux whose flux.conf was erased) runs no v4 command, its
# v1/v2/global build nothing — and empty here, no copy is the main one: the
# main copy itself then builds nothing. A flux reads the main copy's dbt.conf:
# same sandbox, prefixes and engine pins, and guard settings at least as strict
# (DBT_SANDBOX_NEVER_BUILD, DBT_HOOKS_COMPILE_OK, DBT_HOOKS_REVIEWED,
# DBT_HOOKS_REVIEWED_V2, DBT_ALLOW_RUN_OPERATION) — looser refuses every command.
DBT_V4_MAIN_WS=""
DBT_V4_PRODUCTS=""
DBT_BQ_DATASET_PREFIX_V4=""
{%- endif %}

# --- Write guard opt-outs (leave at 0 until reviewed) ------------------------
# run-operation executes arbitrary macros: refused unless 1
DBT_ALLOW_RUN_OPERATION=0
# pre/post-hooks and on-run-* run SQL outside any materialization, possibly
# against a source — the project's own, and those of its installed packages
# (elementary, for one, writes its monitoring tables from on-run-end). When
# there are some, every command that executes them is refused until a human
# has read them and set this to 1: run, build, seed, snapshot, test, source
# freshness — and under dbt v2 also compile and show. `just doctor` lists them.
DBT_HOOKS_REVIEWED=0
# Narrower: names whose hooks a human has read and found harmless on dbt v2
# compile/show — the only two commands this opens (run, build, test… stay
# refused). Fleet: product names, `global` for global/; single project:
# `project`. elementary's hooks also need ELEMENTARY=0 (its uploads off).
DBT_HOOKS_COMPILE_OK=""
{%- if project_type == 'dbt-fleet' %}
# The v4 space has no approved-hooks list, and names of its own in the list
# above: `global-v4`, `v4/<product>` (a product name never opens its v4). Listed,
# `global-v4` holds only while the proof of its hooks named here holds: ONE
# verdict line, exactly
#   VERDICT HOOKS GLOBAL-V4 : PREUVE OK ; TÉMOINS OK ; sceau <20 hex>
# whose seal the guard recomputes at every compile/show (lib-dbt.sh,
# dbt_hooks_v4_seal: what decides which hooks run there, and what they do).
# Written by the fleet's own proof tool; a path inside the workspace. Empty:
# global-v4 stays refused. A `v4/<product>` has no seal: listed, refused.
# A flux reads its own proof: this path with -<FLUX> before the extension
# (HOOKS_V4.md -> HOOKS_V4-H.md), its verdict line naming it
# (VERDICT HOOKS GLOBAL-V4 FLUX <FLUX> : …).
DBT_HOOKS_V4_PROOF=""
{%- endif %}
# Nodes never built in the sandbox, whatever the selection (space-separated,
# <package>.<node> as dbt names them; in a fleet, as in global/): the guard
# refuses a write that selects one. For tables whose production protects the
# rows (a row access policy for a production group): a sandbox copy would
# expose those rows or, with the policy, hide them from you.
DBT_SANDBOX_NEVER_BUILD=""
# Scoped to the v2 worktree(s) and global/ — v1 keeps the origin's hooks. 1 = every
# command may run hooks there, but only the approved ones: .devcontainer/hooks.approved,
# written by `just hooks-approve` from a compiled manifest (each hook's text + where
# every source() it names resolves). A new or edited hook, or one whose source now
# resolves elsewhere, is refused until approved again.
DBT_HOOKS_REVIEWED_V2=0
