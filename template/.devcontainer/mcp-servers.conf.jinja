# =============================================================================
# MCP servers managed by the devcontainer lifecycle (.devcontainer/lib-mcp.sh)
#
# One server per line:  NAME  REPO  [REF]  [PORT]
#   NAME — install directory under /opt/<NAME>
#   REPO — git clone URL (private repos need GITHUB_PERSONAL_ACCESS_TOKEN
#          in .env; a plain container restart retries a failed install)
#   REF  — optional tag/branch pin ('-' = track the default branch)
#   PORT — optional local streamable-http port; post-start waits for it
#          and prints the server log tail if nothing answers
#
# This file is PROJECT-OWNED after the first render (copier _skip_if_exists):
# edit it freely, `copier update` will never overwrite it.
# To opt out of template-managed servers, comment out every line — but KEEP
# the file: if it is deleted, the next `copier update` re-seeds the default.
# =============================================================================
{%- if project_type != "base" %}
sap-adt-mcp https://github.com/4ITServices/sap-adt-mcp.git - 8000
{%- else %}
# No MCP server seeded for project_type=base. Add your own, one per line, e.g.:
# my-mcp https://github.com/org/my-mcp.git - 8000
{%- endif %}
