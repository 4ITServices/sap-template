{
  "name": "{{ project_name }}-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:{{ python_version }}",

  // Stop the container when the VS Code window/project is CLOSED, so containers
  // don't pile up and exhaust the Docker VM's RAM. Unstopped containers from
  // closed projects accumulate until the kernel OOM-killer fires and takes down
  // the active window's extension host (symptom: "command not found" loops).
  // While the project stays OPEN the container — and the detached tmux session
  // below — still survives window reloads, reconnects and host sleep; only a
  // real close/quit stops it. For a deliberately always-on service, run it as a
  // plain `docker run` daemon rather than flipping this back to "none".
  "shutdownAction": "stopContainer",
  // tini as PID 1: reap zombie/orphan processes from agentic background tasks
  // and avoid the process-group signal cascade that can crash Claude (exit 137).
  "init": true,

  "mounts": [
{%- if claude_profile %}
    // Claude profile "{{ claude_profile }}": ~/.claude is the HOST dir
    // ~/.claude-profiles/{{ claude_profile }}, not the host-wide ~/.claude shared
    // by every container. Its login (.credentials.json), chat history, memory
    // and backups/ belong to this profile and persist host-side across rebuilds
    // (even without cache). Repos answering the same profile share its account.
    "source=${localEnv:HOME}/.claude-profiles/{{ claude_profile }},target=/home/vscode/.claude,type=bind",
{%- else %}
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
{%- endif %}
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"{% if project_type == "dbt-project" %},
    // gcloud credentials live on the HOST: one `gcloud auth login` +
    // `gcloud auth application-default login` (the ADC that dbt's
    // `method: oauth` reads) survives every rebuild and is shared by all the
    // containers mounting it. No service-account key ever enters the image.
    "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind"{% endif %}
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}{% if enable_iac %},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers-extra/features/opentofu:1": {}{% endif %}{% if project_type == "dbt-project" %},
    // gcloud + bq, installed from Google's apt repo by a LOCAL feature: the
    // public ghcr.io/dhoeric one is abandoned and breaks on current Debian
    // (it relies on the removed `apt-key`).
    "./features/google-cloud-cli": {}{% endif %}
  },
{%- if claude_profile %}

  // Host-side, before the container is created: the profile dir must exist,
  // since a missing bind source aborts `docker run --mount` (no auto-create).
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude-profiles/{{ claude_profile }}\"{% if project_type == "dbt-project" %} \"${localEnv:HOME}/.config/gcloud\"{% endif %}",
{%- else %}

  "initializeCommand": "mkdir -p ${HOME}/.claude{% if project_type == "dbt-project" %} ${HOME}/.config/gcloud{% endif %}",
{%- endif %}

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "humao.rest-client",
{%- if project_type == "dbt-project" %}
        // No redhat.vscode-yaml here: dbt Labs recommends disabling it next to
        // the dbt extension (it flags valid dbt YAML keys as errors).
        // The official extension drives dbt v2; dbt Power User drives dbt Core
        // 1.x and is scoped to v1/ (dbt.allowListFolders, .vscode/settings.json).
        "dbtLabsInc.dbt",
        "innoverio.vscode-dbt-power-user",
{%- else %}
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-azureresourcegroups",
{%- endif %}
        "bierner.markdown-mermaid"{% if enable_iac %},
        "ms-azuretools.vscode-bicep"{% endif %}
      ],
      "settings": {
        // Run the integrated terminal inside a persistent tmux session so a
        // long Claude Code run survives window reload, full VS Code restart,
        // SSH drop and host sleep. Each tab gets its own session
        // (`claude-<pid>`) so several Claude Code instances run in parallel;
        // on revival each reopened tab reattaches a detached one. List/reattach
        // from any shell: `tmux ls` then `tmux attach -t <name>`.
        "terminal.integrated.defaultProfile.linux": "tmux",
        "terminal.integrated.profiles.linux": {
          "tmux": {
            "path": "bash",
            "args": ["${workspaceFolder}/.devcontainer/tmux-session.sh"],
            "icon": "terminal-tmux"
          },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        },
        // Tasks/debuggers use a plain shell, never tmux.
        "terminal.integrated.automationProfile.linux": { "path": "bash" },
        // Survive window reloads by reconnecting to the live process.
        "terminal.integrated.enablePersistentSessions": true,
        // Never let an extension's env contribution auto-relaunch (= kill) a
        // terminal that is about to host, or is hosting, a Claude session.
        "terminal.integrated.environmentChangesRelaunch": false,
        "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
        // Keep far more transcript in the buffer / restored after a reload.
        "terminal.integrated.scrollback": 20000,
        "terminal.integrated.persistentSessionScrollback": 1000,
        // Silence the Python extension's env-collection churn (venv activation
        // + .env injection) — the main trigger of the relaunch prompt. The
        // project reads .env at runtime via pydantic-settings, not the shell.
        "python.terminal.activateEnvironment": false,
{%- if project_type == "dbt-project" %}
        // dbt Power User = the legacy engine only. It runs dbt Core 1.x through
        // the /opt/dbt-v1 interpreter (its Python bridge) and gets the project
        // env vars from profiles/dbt.env — the Python extension's envFile is
        // the last layer applied to its dbt processes. The official extension
        // finds dbt v2 at its default path ~/.local/bin/dbt: leave dbt.dbtPath
        // unset so it can keep that binary in step with the extension.
        "python.envFile": "${workspaceFolder}/profiles/dbt.env",
        "python.defaultInterpreterPath": "/opt/dbt-v1/bin/python",
        "dbt.dbtIntegration": "core",
        "dbt.dbtPythonPathOverride": "/opt/dbt-v1/bin/python",
        "dbt.installDepsOnProjectInitialization": false
{%- else %}
        "python.envFile": ""
{%- endif %}
      }
    }
  },

  "onCreateCommand": {
    "git-config": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global user.email '{{ author_email }}' && git config --global user.name '{{ author_name }}'",
    "claude-dirs": "mkdir -p /home/vscode/.claude/tmp /home/vscode/.claude/logs /tmp/claude-code"
  },

  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-create.sh",

  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-start.sh",

  "remoteUser": "vscode",
  "userEnvProbe": "loginShell",

  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:HOME}/.claude/bin:${containerEnv:PATH}",
    "TMPDIR": "/tmp/claude-code"
  },

  "containerEnv": {
    "HOME": "/home/vscode",
    "HISTFILE": "${containerWorkspaceFolder}/.bash_history"{% if project_type == "dbt-project" %},
    // Profile hub lock: every process of the container (terminals, both dbt
    // extensions, hooks, `docker exec`) resolves dbt profiles from the
    // workspace hub, never from the profiles.yml shipped inside v1/ or v2/
    // (those point at the real projects). dbt's lookup order is
    // --profiles-dir > this variable > cwd > ~/.dbt, so a profile missing
    // from the hub is an error, not a fallback.
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/profiles",
    "DBT_SEND_ANONYMOUS_USAGE_STATS": "false"{% endif %}
  }
}
