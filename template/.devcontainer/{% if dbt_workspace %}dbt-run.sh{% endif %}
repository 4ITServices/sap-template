#!/bin/bash
# =============================================================================
# dbt-run.sh — the guarded way to run dbt in this workspace (TEMPLATE-OWNED)
# Updated by `copier update` — do not edit in projects.
#
# Single product (dbt-project):
#   dbt-run.sh v1 <dbt args…>            dbt Core 1.x on v1/      (just v1 …)
#   dbt-run.sh v2 <dbt args…>            dbt v2 on v2/            (just v2 …)
# Fleet of products (dbt-fleet):
#   dbt-run.sh v1 <product> <dbt args…>  dbt Core 1.x on v1/<product>/
#   dbt-run.sh v2 <product> <dbt args…>  dbt v2 on v2/<product>/
#   dbt-run.sh global <dbt args…>        dbt v2 on global/ (the products' v2
#                                        as local packages)
#   dbt-run.sh products                  the products and their state
#   dbt-run.sh sync [<product>]          fetch where the products' branches
#                                        live, fast-forward the clean worktrees
#   dbt-run.sh product-add <name> <url> [branch] [subdir] [global] [home]
#                                        declare a product whose repository
#                                        exists (home = its own repo, or '-')
#   dbt-run.sh lock [<product>]          write .devcontainer/products.lock: the
#                                        exact commit of every v1/v2 (pushed ones only)
#   dbt-run.sh lock-status               where each worktree stands against the lock
#   dbt-run.sh lock-checkout [<product>] put the worktrees at the locked commits
#   dbt-run.sh lock-release [<product>]  back on their branches
#   dbt-run.sh product-new <name> <url> [branch] [subdir] [global]
#                                        create the product's own repository
#                                        (dbt-project), fill it from upstream,
#                                        then declare it here
# Both:
#   dbt-run.sh auto <dbt args…>          engine (and product) from the current
#                                        directory — what the `dbt` function calls
#   dbt-run.sh destinations [<product>|global]
#                                        where each engine would write each
#                                        node, and where v1 and v2 disagree
#   dbt-run.sh upstream-pull [<product>] fetch upstream, refresh its mirror on
#                                        origin (never merges)
#
# Every process of the container already gets the profile hub
# (DBT_PROFILES_DIR). On top of it, this wrapper:
#   - imposes the hub: --profiles-dir is refused
#   - loads profiles/dbt.env (+ profiles/env/<product>.env in a fleet), the
#     env vars the projects' Jinja needs
#   - refuses run-operation (arbitrary macros) unless DBT_ALLOW_RUN_OPERATION=1
#   - lets a write (run/build/seed/snapshot/clone/retry) through only with an
#     explicit selection whose every node resolves into the sandbox: project
#     DBT_BQ_PROJECT, dataset starting with DBT_BQ_DATASET_PREFIX — and, in
#     global/, whose relations no other node of the project writes too
#   - refuses every command that would execute hooks — the project's own or
#     those of its installed packages — until DBT_HOOKS_REVIEWED=1. Which
#     commands run hooks depends on the engine: see dbt_hook_commands in
#     lib-dbt.sh (dbt v2 runs them on compile and show too)
# The raw engines (`dbt1`, `dbtf`) and the editor extensions' buttons bypass
# these guards — they only get the hub.
# =============================================================================
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WS="$(dirname "$HERE")"
# shellcheck disable=SC1091
source "$HERE/lib-dbt.sh"
dbt_load_conf "$WS"

die()    { echo "⛔ $*" >&2; exit 1; }
refuse() { echo "⛔ $1" >&2; shift; for L in "$@"; do echo "   $L" >&2; done; exit 1; }

MODE="${1:-}"
[ $# -gt 0 ] && shift

# select_product NAME — fleet only: NAME must be declared in products.conf
select_product() {
  local N="${1:-}" LIST
  LIST="$(dbt_products | paste -sd' ' -)"
  [ -n "$N" ] || die "which product? ${LIST:-none declared} — e.g. just ${MODE:-v1} <product> parse"
  dbt_use_product "$N" && return 0
  # a dbt command where the product belongs: the product was forgotten
  case " parse compile run build test ls list seed snapshot deps show docs debug clean source freshness retry clone run-operation " in
    *" $N "*) die "which product? ${LIST:-none declared} — e.g. just ${MODE:-v1} <product> $N" ;;
  esac
  die "unknown product '$N' — declared in .devcontainer/products.conf: ${LIST:-none}"
}

# -----------------------------------------------------------------------------
# upstream-pull
# -----------------------------------------------------------------------------
upstream_pull_one() {
  local BR="$P_BRANCH" OLD NEW V B
  git -C "$WS" remote get-url "$P_REMOTE" >/dev/null 2>&1 || die "no '$P_REMOTE' remote — run: just setup"
  OLD="$(git -C "$WS" rev-parse -q --verify "refs/remotes/$P_REMOTE/$BR" 2>/dev/null || true)"
  echo "→ ${P_TAG}git fetch $P_REMOTE (read-only)"
  git -C "$WS" fetch --no-tags "$P_REMOTE" || die "fetch failed (VPN? SSH key? pinned host key?)"
  NEW="$(git -C "$WS" rev-parse -q --verify "refs/remotes/$P_REMOTE/$BR")" || die "$P_REMOTE has no branch '$BR'"
  if [ "$OLD" = "$NEW" ]; then
    echo "  $P_REMOTE/$BR unchanged (${NEW:0:9})"
  else
    echo "  $P_REMOTE/$BR: ${OLD:+${OLD:0:9} → }${NEW:0:9}"
    git -C "$WS" --no-pager log --oneline -n 20 "${OLD:+$OLD..}$NEW"
  fi
  echo "→ mirror on $P_HOME: $P_MIRROR"
  _dbt_git_home -C "$WS" push "$P_HOME" "refs/remotes/$P_REMOTE/$BR:refs/heads/$P_MIRROR" \
    || echo "  WARNING: mirror not pushed ($P_HOME unreachable, or upstream history was rewritten)" >&2
  for V in $DBT_WORKTREES; do
    B="$(_dbt_br "$V")"
    git -C "$WS" show-ref --verify --quiet "refs/heads/$B" || continue
    echo "  $B: $(git -C "$WS" rev-list --count "$B..$P_REMOTE/$BR") commit(s) behind $P_REMOTE/$BR, $(git -C "$WS" rev-list --count "$P_REMOTE/$BR..$B") ahead"
  done
  echo "Nothing was merged. To take the changes: cd ${P_SHOW1%/} && git merge $P_REMOTE/$BR, then cd into ${P_SHOW2%/} && git merge $P_B1"
}

upstream_pull() {
  local N
  load_token   # the mirror is pushed where the product's branches live
  if dbt_is_fleet && [ -z "${1:-}" ]; then
    for N in $(dbt_products); do dbt_use_product "$N" && ( upstream_pull_one ); done
  else
    dbt_is_fleet && select_product "$1"
    upstream_pull_one
  fi
}

# -----------------------------------------------------------------------------
# destinations
# -----------------------------------------------------------------------------
destinations_one() {
  local TMP V RC=0
  TMP="$(mktemp -d)"
  export_env
  for V in $DBT_WORKTREES; do
    if dbt_destinations "$V" > "$TMP/$V.tsv" && [ -s "$TMP/$V.tsv" ]; then
      echo "== ${P_TAG}$V: $(wc -l < "$TMP/$V.tsv") node(s) =="
      cut -f2,3 "$TMP/$V.tsv" | sort | uniq -c | sort -rn | sed 's/^/  /'
    else
      echo "== ${P_TAG}$V: no destination — \`$(dbt_just_cmd "$V") parse\` must pass first =="
      : > "$TMP/$V.tsv"
      RC=1
    fi
  done
  python3 - "$TMP/v1.tsv" "$TMP/v2.tsv" "$P_TAG" "${DBT_BQ_DATASET_PREFIX:-}" "${DATASET_PREFIX:-}" <<'PY'
import sys
# The sandbox prefix is how a branch reaches the sandbox, not a move: v1,
# faithful to upstream, may not read DATASET_PREFIX while v2 does.
pfxs = sorted({x.rstrip("_").upper() for x in sys.argv[4:6] if x.rstrip("_")}, key=len, reverse=True)
def norm(schema):
    for x in pfxs:
        if schema.upper().startswith(x + "_"):
            return schema[len(x) + 1:]
    return schema
def load(path):
    out = {}
    for line in open(path):
        p = line.rstrip("\n").split("\t")
        if len(p) >= 4:
            out[(p[0], p[3])] = (p[1], p[2])
    return out
a, b = load(sys.argv[1]), load(sys.argv[2])
if not a or not b:
    sys.exit(0)
moved = sorted(k for k in a.keys() & b.keys() if (a[k][0], norm(a[k][1])) != (b[k][0], norm(b[k][1])))
only1, only2 = sorted(a.keys() - b.keys()), sorted(b.keys() - a.keys())
note = f" (sandbox prefix {'/'.join(x + '_' for x in pfxs)} ignored)" if pfxs else ""
print(f"== {sys.argv[3]}v1 vs v2: {len(moved)} node(s) written elsewhere{note}, {len(only1)} only in v1, {len(only2)} only in v2 ==")
for k in moved:
    print(f"  {k[0]} {k[1]}: {'.'.join(a[k])}  ->  {'.'.join(b[k])}")
for k in only1:
    print(f"  only in v1: {k[0]} {k[1]}")
for k in only2:
    print(f"  only in v2: {k[0]} {k[1]}")
PY
  rm -rf "$TMP"
  return $RC
}

destinations_global() {
  local TMP RC=0
  TMP="$(mktemp)"
  export_env
  if dbt_destinations global > "$TMP" && [ -s "$TMP" ]; then
    echo "== global: $(wc -l < "$TMP") node(s) =="
    awk -F'\t' '{split($4, a, "."); print a[1] "\t" $2 "." $3}' "$TMP" | sort | uniq -c | sort -rn | head -n 40 | sed 's/^/  /'
    python3 - "$TMP" <<'PY'
import sys, collections
rel = collections.defaultdict(list)
for line in open(sys.argv[1]):
    p = line.rstrip("\n").split("\t")
    if len(p) >= 5:
        rel[(p[1], p[2].upper(), p[4].upper())].append(p[3])
dups = {k: v for k, v in rel.items() if len(v) > 1}
print(f"== global: {len(dups)} relation(s) written by several nodes ==")
for k, v in sorted(dups.items()):
    print(f"  {'.'.join(k)} <- {', '.join(sorted(v))}")
PY
  else
    echo "== global: no destination — \`just global parse\` must pass first =="
    RC=1
  fi
  rm -f "$TMP"
  return $RC
}

destinations() {
  local N RC=0
  if [ "${1:-}" = "global" ]; then destinations_global; return $?; fi
  if dbt_is_fleet && [ -z "${1:-}" ]; then
    for N in $(dbt_products); do dbt_use_product "$N" && { destinations_one || RC=1; }; done
    return $RC
  fi
  dbt_is_fleet && select_product "$1"
  destinations_one
}

# -----------------------------------------------------------------------------
# products (fleet)
# -----------------------------------------------------------------------------
products() {
  local N V P B S
  dbt_is_fleet || die "single-product workspace: no products.conf"
  printf '%-18s %-6s %-10s %-34s %s\n' "PRODUCT" "GLOBAL" "UPSTREAM" "WORKTREES" "BRANCHES LIVE IN"
  for N in $(dbt_products); do
    dbt_use_product "$N" || continue
    S=""
    for V in $DBT_WORKTREES; do
      P="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"
      if _dbt_is_worktree "$P"; then S="$S $V=$(git -C "$P" rev-parse --short HEAD 2>/dev/null)"; else S="$S $V=missing"; fi
    done
    printf '%-18s %-6s %-10s %-34s %s\n' "$N" "$( [ "$P_GLOBAL" = 1 ] && echo yes || echo no)" "$P_BRANCH" "${S# }" "${P_HOME_URL:-this repository (origin)}"
  done
}

# The workspace token, for the product repositories, when the shell has none
# (a hook got it from .env; a terminal may not have sourced it)
load_token() { _dbt_load_token; }

sync_products() {
  local N V MOVED=0 ST
  dbt_is_fleet || { dbt_use_product ""; dbt_sync; return; }
  load_token
  if [ -n "${1:-}" ]; then select_product "$1"; dbt_sync; return; fi
  for N in $(dbt_products); do dbt_use_product "$N" && dbt_sync; done
  [ -f "$DBT_LOCK_FILE" ] || return 0
  for N in $(dbt_products); do
    dbt_use_product "$N" || continue
    for V in $DBT_WORKTREES; do
      read -r ST _ <<< "$(dbt_lock_status "$V")"
      [ "$ST" = same ] || MOVED=$((MOVED + 1))
    done
  done
  if [ "$MOVED" = 0 ]; then echo "lock: every worktree is at its locked commit"
  else echo "lock: $MOVED worktree(s) away from products.lock — just lock-status"; fi
}

# -----------------------------------------------------------------------------
# The fleet lock (.devcontainer/products.lock)
# -----------------------------------------------------------------------------

# lock [PRODUCT] — record the current commit of each v1/v2. Only commits that
# are PUSHED where the product's branches live: a lock that names a commit
# nobody else can fetch would replay nothing. Uncommitted changes are not
# part of a commit, hence of the lock: they are reported.
lock_write() {
  local ONLY="${1:-}" N V W B U C BAD="" WARN="" TMP OLD NEWL OLDC CHANGES=""
  dbt_is_fleet || die "single-product workspace: nothing to lock"
  [ -z "$ONLY" ] || select_product "$ONLY"
  load_token
  TMP="$(mktemp)"
  {
    echo "# products.lock — the exact commit of every product's v1 and v2 (just lock)."
    echo "# Commit it with the change of global/ it goes with: \`git log -p\` on this file"
    echo "# then tells which product versions each state of global/ was validated with."
    echo "# Generated — edit with \`just lock\`, not by hand. Replay: just lock-checkout"
    echo "# PRODUCT        VERSION  COMMIT                                    SOURCE"
  } > "$TMP"
  for N in $(dbt_products); do
    dbt_use_product "$N" || continue
    if [ -n "$ONLY" ] && [ "$N" != "$ONLY" ]; then
      for V in $DBT_WORKTREES; do grep -E "^$N +$V " "$DBT_LOCK_FILE" 2>/dev/null >> "$TMP"; done
      continue
    fi
    _dbt_fetch_home >/dev/null 2>&1 || true
    for V in $DBT_WORKTREES; do
      W="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"; U="$P_HOME/$(_dbt_hbr "$V")"
      if ! _dbt_is_worktree "$W"; then BAD="$BAD"$'\n'"   $N $V: no worktree (just setup)"; continue; fi
      C="$(git -C "$W" rev-parse HEAD)"
      [ "$(git -C "$W" rev-parse --abbrev-ref HEAD)" = "$B" ] \
        || BAD="$BAD"$'\n'"   $N $V: $(_dbt_show "$V") is not on $B (a replayed lock? just lock-release)"
      if ! git -C "$DBT_WS" show-ref --verify --quiet "refs/remotes/$U" || ! git -C "$DBT_WS" merge-base --is-ancestor "$C" "$U" 2>/dev/null; then
        BAD="$BAD"$'\n'"   $N $V: ${C:0:9} is not pushed to $U — git -C $(_dbt_show "$V") push"
      fi
      [ -z "$(git -C "$W" status --porcelain --untracked-files=no 2>/dev/null)" ] \
        || WARN="$WARN"$'\n'"   $N $V: uncommitted changes in $(_dbt_show "$V") — not part of the lock"
      printf '%-14s %-8s %s  %s\n' "$N" "$V" "$C" "${P_HOME_URL:-origin}#$(_dbt_hbr "$V")" >> "$TMP"
      OLDC="$(_dbt_lock_get "$N" "$V")"
      if [ "$OLDC" != "$C" ]; then
        if [ -n "$OLDC" ] && git -C "$DBT_WS" cat-file -e "$OLDC^{commit}" 2>/dev/null; then
          CHANGES="$CHANGES"$'\n'"   $N $V: ${OLDC:0:9} → ${C:0:9} ($(git -C "$DBT_WS" rev-list --count "$OLDC..$C" 2>/dev/null) commit(s))"
        else
          CHANGES="$CHANGES"$'\n'"   $N $V: ${OLDC:+${OLDC:0:9} → }${C:0:9}"
        fi
      fi
    done
  done
  if [ -n "$BAD" ]; then
    rm -f "$TMP"
    echo "⛔ products.lock NOT written:$BAD" >&2
    exit 1
  fi
  [ -z "$WARN" ] || printf '⚠ not part of the lock:%s\n' "$WARN"
  if [ -z "$CHANGES" ] && [ -f "$DBT_LOCK_FILE" ]; then
    rm -f "$TMP"; echo "products.lock already up to date"; return 0
  fi
  cat "$TMP" > "$DBT_LOCK_FILE"; rm -f "$TMP"
  echo "products.lock written:$CHANGES"
  echo "Commit it with the global/ change it goes with: git add .devcontainer/products.lock"
}

lock_status() {
  local N V
  dbt_is_fleet || die "single-product workspace: no lock"
  [ -f "$DBT_LOCK_FILE" ] || { echo "no .devcontainer/products.lock yet — just lock"; return 0; }
  for N in $(dbt_products); do
    dbt_use_product "$N" || continue
    for V in $DBT_WORKTREES; do printf '  %-24s %s\n' "$(_dbt_show "$V")" "$(dbt_lock_describe "$V")"; done
  done
}

# lock-checkout [PRODUCT] — replay the locked state: each worktree detached
# at its locked commit. Refused on a worktree with uncommitted changes.
lock_checkout() {
  local ONLY="${1:-}" N V W L DONE=0
  dbt_is_fleet || die "single-product workspace: no lock"
  [ -f "$DBT_LOCK_FILE" ] || die "no .devcontainer/products.lock — nothing to replay"
  [ -z "$ONLY" ] || select_product "$ONLY"
  load_token
  for N in $(dbt_products); do
    [ -z "$ONLY" ] || [ "$N" = "$ONLY" ] || continue
    dbt_use_product "$N" || continue
    for V in $DBT_WORKTREES; do
      W="$(_dbt_wt "$V")"; L="$(_dbt_lock_get "$N" "$V")"
      [ -n "$L" ] && _dbt_is_worktree "$W" || continue
      [ -z "$(git -C "$W" status --porcelain --untracked-files=no 2>/dev/null)" ] \
        || die "$(_dbt_show "$V") has uncommitted changes — commit or stash them first"
      git -C "$DBT_WS" cat-file -e "$L^{commit}" 2>/dev/null || _dbt_fetch_home >/dev/null 2>&1 || true
      git -C "$W" checkout --quiet --detach "$L" || die "cannot check out ${L:0:9} in $(_dbt_show "$V")"
      echo "  $(_dbt_show "$V") at the locked ${L:0:9} (detached)"; DONE=$((DONE + 1))
    done
  done
  echo "$DONE worktree(s) replayed. Back on the branches: just lock-release"
}

lock_release() {
  local ONLY="${1:-}" N V W B
  dbt_is_fleet || die "single-product workspace: no lock"
  [ -z "$ONLY" ] || select_product "$ONLY"
  for N in $(dbt_products); do
    [ -z "$ONLY" ] || [ "$N" = "$ONLY" ] || continue
    dbt_use_product "$N" || continue
    for V in $DBT_WORKTREES; do
      W="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"
      _dbt_is_worktree "$W" || continue
      [ "$(git -C "$W" rev-parse --abbrev-ref HEAD)" = "$B" ] && continue
      git -C "$W" checkout --quiet "$B" && echo "  $(_dbt_show "$V") back on $B" \
        || echo "  WARNING: cannot go back to $B in $(_dbt_show "$V") (uncommitted changes?)"
    done
  done
}

# product_add NAME URL [BRANCH] [SUBDIR] [GLOBAL] [HOME] — declare, then
# build its worktrees. HOME = the product's own repository (where its v1/v2
# live), '-' = this repository. Never pushes: publishing is the user's call.
product_add() {
  local N="${1:-}" URL="${2:-}" BR="${3:-}" SUB="${4:-}" GL="${5:-}" HOMEU="${6:-}"
  dbt_is_fleet || die "single-product workspace: no products.conf"
  [ -n "$N" ] && [ -n "$URL" ] || die "usage: just product-add <name> <git-url> [branch] [subdir] [global: yes|no]"
  printf '%s' "$N" | grep -Eq "$DBT_PRODUCT_RE" || die "invalid product name '$N': lowercase, digits and '-' (41 characters max)"
  if dbt_use_product "$N"; then die "product '$N' is already declared in .devcontainer/products.conf"; fi
  case "$URL" in ssh://*|https://*|*@*:*|file://*|/*) ;; *) die "'$URL' is not a git URL (git@host:group/repo.git, ssh://…, https://… or a local path)" ;; esac
  case "${GL:-no}" in yes|no) ;; *) die "GLOBAL must be yes or no (got '$GL')" ;; esac
  case "${HOMEU:--}" in -|ssh://*|https://*|*@*:*|file://*|/*) ;; *) die "HOME must be a git URL or '-' (got '$HOMEU')" ;; esac
  load_token
  # keep the file line-terminated before appending
  [ -s "$DBT_PRODUCTS_CONF" ] && [ -n "$(tail -c1 "$DBT_PRODUCTS_CONF")" ] && echo >> "$DBT_PRODUCTS_CONF"
  printf '%-14s %s  %s  %s  %s  %s\n' "$N" "$URL" "${BR:-main}" "${SUB:--}" "${GL:-no}" "${HOMEU:--}" >> "$DBT_PRODUCTS_CONF"
  echo "→ $N declared in .devcontainer/products.conf"
  bash -c 'source "$1/.devcontainer/lib-dbt.sh" && dbt_process "$1" create' _ "$WS"
  dbt_load_conf "$WS"
  dbt_use_product "$N" || die "$N is not readable back from products.conf"
  echo
  echo "Next: commit .devcontainer/products.conf (and upstream_known_hosts if a new host was pinned)."
  if [ "$P_HOME" = "origin" ]; then
    echo "Then publish the branches — nothing is pushed for you:"
    echo "  just upstream-pull $N && git -C ${P_SHOW1%/} push -u origin $P_B1 && git -C ${P_SHOW2%/} push -u origin $P_B2"
  fi
}

# product_new NAME URL [BRANCH] [SUBDIR] [GLOBAL] — the coordinator model in
# one command: create the product's own repository from the template
# (project_type dbt-project, the coordinator's sandbox answers), fill it from
# upstream (main = tooling, upstream-<br> = mirror, v1 = v2 = the upstream
# branch), push it — PRIVATE, checked before any push — then declare it here.
product_new() {
  local N="${1:-}" URL="${2:-}" BR="${3:-main}" SUB="${4:--}" GL="${5:-no}"
  local A ORG SRC REF REPO HOMEU TMP R PROF
  dbt_is_fleet || die "single-product workspace: no products.conf"
  [ -n "$N" ] && [ -n "$URL" ] || die "usage: just product-new <name> <git-url> [branch] [subdir] [global: yes|no]"
  printf '%s' "$N" | grep -Eq "$DBT_PRODUCT_RE" || die "invalid product name '$N': lowercase, digits and '-' (41 characters max)"
  if dbt_use_product "$N"; then die "product '$N' is already declared in .devcontainer/products.conf"; fi
  case "$GL" in yes|no) ;; *) die "GLOBAL must be yes or no (got '$GL')" ;; esac
  command -v gh >/dev/null 2>&1 || die "gh (GitHub CLI) not found"
  command -v copier >/dev/null 2>&1 || die "copier not found"
  load_token
  export GH_TOKEN="${GH_TOKEN:-${GITHUB_PERSONAL_ACCESS_TOKEN:-}}"
  [ -n "$GH_TOKEN" ] || die "no GitHub token: set GITHUB_PERSONAL_ACCESS_TOKEN in .env"
  A="$WS/.copier-answers.yml"
  ORG="$(sed -nE 's/.*github_org: ([^,}]+).*/\1/p' "$A" | head -1 | tr -d "' ")"
  SRC="$(sed -nE 's/.*_src_path: ([^,}]+).*/\1/p' "$A" | head -1 | tr -d "' ")"
  REF="$(sed -nE 's/.*_commit: ([^,}]+).*/\1/p' "$A" | head -1 | tr -d "' ")"
  [ -n "$ORG" ] && [ -n "$SRC" ] || die "cannot read github_org / _src_path from .copier-answers.yml"
  REPO="${DBT_PRODUCT_REPO_PREFIX:-}$N"
  HOMEU="https://github.com/$ORG/$REPO.git"
  if gh repo view "$ORG/$REPO" >/dev/null 2>&1; then
    die "$ORG/$REPO already exists — declare it instead: just product-add $N $URL $BR $SUB $GL $HOMEU"
  fi
  TMP="$(mktemp -d)"
  R="$TMP/$REPO"
  # shellcheck disable=SC2329
  ans() { sed -nE "s/.*[{ ]$1: ([^,}]+).*/\1/p" "$A" | head -1 | sed -E "s/^'(.*)'$/\1/"; }
  echo "→ rendering $REPO (dbt-project, template ${REF:-latest})"
  copier copy ${REF:+--vcs-ref "$REF"} --defaults --quiet \
    --data "project_name=$REPO" \
    --data "project_description=Reprise dbt de $N : dbt Core 1.x et migration dbt v2 (coordonné par $(basename "$WS"))" \
    --data project_type=dbt-project \
    --data "upstream_repo_url=$URL" --data "upstream_branch=$BR" --data "dbt_project_subdir=$( [ "$SUB" = "-" ] && echo "" || echo "$SUB")" \
    --data "bq_sandbox_project=${DBT_BQ_PROJECT:-}" --data "bq_sandbox_dataset=${DBT_BQ_DATASET:-}" \
    --data "bq_dataset_prefix=${DBT_BQ_DATASET_PREFIX:-}" --data "bq_location=${DBT_BQ_LOCATION:-EU}" \
    --data "dbt_target_name=${DBT_TARGET_NAME:-dev}" \
    --data "author_name=$(ans author_name)" --data "author_email=$(ans author_email)" \
    --data "github_org=$ORG" --data "claude_profile=$(ans claude_profile)" \
    --data "fleet_coordinator=$(git -C "$WS" remote get-url origin 2>/dev/null | sed -E 's#^https://[^@]*@#https://#; s#^git@([^:]+):#https://\1/#; s#^(https://.*)\.git$#\1#')" \
    "$SRC" "$R" >/dev/null 2>"$TMP/copier.log" || { tail -n 5 "$TMP/copier.log" >&2; rm -rf "$TMP"; die "copier failed"; }
  # same host keys and the same fleet-wide env as the coordinator
  [ -f "$WS/.devcontainer/upstream_known_hosts" ] && cp "$WS/.devcontainer/upstream_known_hosts" "$R/.devcontainer/"
  cp "$WS/profiles/dbt.env" "$R/profiles/dbt.env"
  git -C "$R" init -q -b main
  git -C "$R" remote add upstream "$URL"
  git -C "$R" config remote.upstream.pushurl DISABLED
  git -C "$R" config remote.upstream.tagOpt --no-tags
  echo "→ fetching $URL ($BR)"
  GIT_TERMINAL_PROMPT=0 timeout 300 git -C "$R" fetch --quiet --no-tags upstream "$BR" \
    || { rm -rf "$TMP"; die "cannot fetch $URL ($BR): VPN? SSH key? pinned host key?"; }
  git -C "$R" update-ref "refs/remotes/upstream/$BR" FETCH_HEAD
  # the product repository's own hub, seeded like its first start would
  PROF="$(git -C "$R" show "upstream/$BR:$( [ "$SUB" = "-" ] || [ "$SUB" = "." ] && echo "" || echo "$SUB/")dbt_project.yml" 2>/dev/null \
    | sed -nE "s/^profile:[[:space:]]*['\"]?([^'\"#[:space:]]+).*/\1/p" | head -1)"
  if [ -n "$PROF" ] && [ -n "${DBT_BQ_PROJECT:-}" ] && [ -n "${DBT_BQ_DATASET:-}" ]; then
    { _dbt_hub_header; _dbt_hub_profile "$PROF"; } > "$R/profiles/profiles.yml"
  fi
  git -C "$R" add -A
  git -C "$R" -c user.name="$(ans author_name)" -c user.email="$(ans author_email)" commit -q \
    -m "chore: scaffold from sap-template (dbt-project, ${REF:-latest}), created by $(basename "$WS")"
  git -C "$R" branch -q --no-track v1 "upstream/$BR"
  git -C "$R" branch -q --no-track v2 v1
  echo "→ creating $ORG/$REPO (private)"
  gh repo create "$ORG/$REPO" --private --description "Reprise dbt de $N : dbt Core 1.x et migration dbt v2" >/dev/null \
    || { rm -rf "$TMP"; die "gh repo create $ORG/$REPO failed"; }
  [ "$(gh repo view "$ORG/$REPO" --json visibility --jq .visibility 2>/dev/null)" = "PRIVATE" ] \
    || { rm -rf "$TMP"; die "$ORG/$REPO is not PRIVATE — nothing was pushed; fix its visibility first"; }
  git -C "$R" remote add origin "$HOMEU"
  _dbt_git_home -C "$R" push --quiet origin main "refs/remotes/upstream/$BR:refs/heads/upstream-$BR" v1 v2 \
    || { rm -rf "$TMP"; die "push to $ORG/$REPO failed — the repository exists, empty or partial: check it"; }
  rm -rf "$TMP"
  echo "→ $ORG/$REPO: main, upstream-$BR, v1, v2 published"
  product_add "$N" "$URL" "$BR" "$SUB" "$GL" "$HOMEU"
}

# -----------------------------------------------------------------------------
# Running dbt
# -----------------------------------------------------------------------------

# The hub is imposed and the env files are loaded (fleet-wide, then the
# product's own); nothing in them can move the lock.
export_env() {
  local F
  for F in "$WS/profiles/dbt.env" "${P_ENV:-}"; do
    [ -n "$F" ] && [ -f "$F" ] || continue
    set -a
    # shellcheck disable=SC1090
    . "$F"
    set +a
  done
  export DBT_PROFILES_DIR="$WS/profiles"
  export DBT_SEND_ANONYMOUS_USAGE_STATS="${DBT_SEND_ANONYMOUS_USAGE_STATS:-false}"
}

run_dbt() {
  local V="$1" PROJ ENGINE A CMD_WRITE="" CMD_RUNOP="" CMD_HOOKS="" SELECTED="" COLLECT=0 OUT BAD HOOKS ALL DUPS JCMD
  local -a SEL=()
  shift
  JCMD="$(dbt_just_cmd "$V")"
  PROJ="$(dbt_project_dir "$V")" || die "no dbt project in $(_dbt_show "$V") (worktree missing, or set the dbt folder in $( dbt_is_fleet && echo products.conf || echo 'DBT_PROJECT_SUBDIR, dbt.conf')) — run: just setup"
  ENGINE="$(dbt_engine "$V")"
  [ -x "$ENGINE" ] || die "engine $V not installed ($ENGINE) — run: just setup"

  for A in "$@"; do
    case "$A" in
      --profiles-dir|--profiles-dir=*)
        refuse "--profiles-dir is not allowed: the profile hub is imposed." \
               "Edit profiles/profiles.yml instead." ;;
      run|build|seed|snapshot|clone|retry) CMD_WRITE="$A" ;;
      run-operation) CMD_RUNOP=1 ;;
    esac
    # any word naming a hook-running command arms the hook check: a model that
    # happens to be called `test` costs a refusal, never a missed hook
    case " $(dbt_hook_commands "$V") " in *" $A "*) [ -n "$CMD_HOOKS" ] || CMD_HOOKS="$A" ;; esac
    # the arguments that decide WHICH nodes run and WHERE they resolve
    case "$A" in
      -s|--select|-m|--models|--model|--selector) SELECTED=1; SEL+=("$A"); COLLECT=1 ;;
      --select=*|--models=*|--model=*|--selector=*) SELECTED=1; SEL+=("$A"); COLLECT=0 ;;
      --exclude|--vars|--target|-t|--state|--indirect-selection) SEL+=("$A"); COLLECT=1 ;;
      --exclude=*|--vars=*|--target=*|--state=*|--indirect-selection=*) SEL+=("$A"); COLLECT=0 ;;
      -*) COLLECT=0 ;;
      *) [ "$COLLECT" = 1 ] && SEL+=("$A") ;;
    esac
  done

  export_env

  if [ -n "$CMD_RUNOP" ] && [ "${DBT_ALLOW_RUN_OPERATION:-0}" != "1" ]; then
    refuse "run-operation is refused: it executes arbitrary macros, outside every guard." \
           "Read the macro first; to allow it, set DBT_ALLOW_RUN_OPERATION=1 in .devcontainer/dbt.conf."
  fi

  if [ -n "$CMD_HOOKS$CMD_WRITE" ] && [ "${DBT_HOOKS_REVIEWED:-0}" != "1" ]; then
    if dbt_packages_unchecked "$PROJ"; then
      refuse "\`dbt ${CMD_HOOKS:-$CMD_WRITE}\` can run hooks, and this project's packages are not installed:" \
             "their hooks cannot be checked. Install them first (no hook runs): $JCMD deps"
    fi
    HOOKS="$(dbt_hook_sources "$PROJ")"
    if [ -n "$HOOKS" ]; then
      {
        echo "⛔ \`dbt ${CMD_HOOKS:-$CMD_WRITE}\` would run hooks nobody has reviewed yet. They run SQL outside"
        echo "   any materialization, which the sandbox check cannot see. Declared in (under ${PROJ#"$WS"/}/):"
        printf '%s\n' "$HOOKS" | head -n 12 | sed 's/^/     /'
        [ "$(printf '%s\n' "$HOOKS" | wc -l)" -gt 12 ] && echo "     … ($(printf '%s\n' "$HOOKS" | wc -l) files)"
        [ "$V" != v1 ] && echo "   (dbt v2 runs on-run-start hooks on compile and show too.)"
        echo "   Read them, then set DBT_HOOKS_REVIEWED=1 in .devcontainer/dbt.conf."
      } >&2
      exit 1
    fi
  fi

  if [ -n "$CMD_WRITE" ]; then
    [ -f "$WS/profiles/profiles.yml" ] \
      || refuse "no profile hub (profiles/profiles.yml): dbt has nowhere safe to write." \
                "Fill DBT_BQ_PROJECT / DBT_BQ_DATASET in .devcontainer/dbt.conf, then: just setup"
    [ -n "${DBT_BQ_PROJECT:-}" ] \
      || refuse "DBT_BQ_PROJECT is empty in .devcontainer/dbt.conf: no sandbox declared, writes are refused."
    [ "$CMD_WRITE" != "retry" ] \
      || refuse "retry replays a previous selection that cannot be checked here." \
                "Run the command again with an explicit --select."
    [ -n "$SELECTED" ] \
      || refuse "\`dbt $CMD_WRITE\` without a selection: never a whole project by accident." \
                "Add --select <models>."
    echo "[dbt:${P_NAME:+$P_NAME:}$V] checking where the selection would write…" >&2
    OUT="$(dbt_destinations "$V" ${SEL[@]+"${SEL[@]}"})" \
      || refuse "cannot resolve the selection (dbt ls failed): a write whose destination is unknown is refused." \
                "See it fail with: $JCMD ls ${SEL[*]:-}"
    BAD="$(printf '%s\n' "$OUT" | awk -F'\t' -v p="$DBT_BQ_PROJECT" -v x="${DBT_BQ_DATASET_PREFIX:-}" \
      'NF>=4 && ($2!=p || (x!="" && index($3,x)!=1)) {print "   " $1 " " $4 " -> " $2 "." $3}')"
    if [ -n "$BAD" ]; then
      echo "⛔ \`dbt $CMD_WRITE\` refused: $(printf '%s\n' "$BAD" | wc -l) selected node(s) would be written outside the sandbox" >&2
      echo "   (allowed: project $DBT_BQ_PROJECT${DBT_BQ_DATASET_PREFIX:+, dataset starting with $DBT_BQ_DATASET_PREFIX}):" >&2
      printf '%s\n' "$BAD" | head -n 15 >&2
      [ "$(printf '%s\n' "$BAD" | wc -l)" -gt 15 ] && echo "   … (full list: just destinations${P_NAME:+ $P_NAME})" >&2
      exit 1
    fi
    if [ "$V" = "global" ]; then
      # several products in one project: two nodes writing the same table
      # would overwrite each other in the sandbox
      ALL="$(dbt_destinations global)" \
        || refuse "cannot list every node of global/ (dbt ls failed): collisions cannot be ruled out."
      DUPS="$(python3 - <(printf '%s\n' "$ALL") <(printf '%s\n' "$OUT") <<'PY'
import sys, collections
rel = collections.defaultdict(set)
for line in open(sys.argv[1]):
    p = line.rstrip("\n").split("\t")
    if len(p) >= 5:
        rel[(p[1], p[2].upper(), p[4].upper())].add(p[3])
for line in open(sys.argv[2]):
    p = line.rstrip("\n").split("\t")
    if len(p) >= 5:
        k = (p[1], p[2].upper(), p[4].upper())
        if len(rel[k]) > 1:
            print(f"   {'.'.join(k)} <- {', '.join(sorted(rel[k]))}")
PY
)"
      [ -z "$DUPS" ] || { echo "⛔ \`dbt $CMD_WRITE\` refused: these relations are written by several nodes of global/:" >&2; printf '%s\n' "$DUPS" | sort -u | head -n 15 >&2; exit 1; }
    fi
    echo "[dbt:${P_NAME:+$P_NAME:}$V] $(printf '%s\n' "$OUT" | grep -c .) node(s), all inside the sandbox" >&2
  fi

  # Run from the project directory, unless the caller already stands in it
  # (the `dbt` function: paths given on the command line stay relative).
  case "$PWD/" in
    "$PROJ/"*) ;;
    *) cd "$PROJ" || die "cannot enter $PROJ" ;;
  esac
  exec "$ENGINE" "$@"
}

# auto — the engine (and the product) from the current directory
run_auto() {
  local REL N
  case "$PWD/" in
    "$WS/global/"*)
      dbt_is_fleet && { run_dbt global "$@"; return; } ;;
    "$WS/v1/"*|"$WS/v2/"*)
      REL="${PWD#"$WS"/}"
      if dbt_is_fleet; then
        N="$(printf '%s' "$REL" | cut -d/ -f2)"
        if [ -n "$N" ] && dbt_use_product "$N"; then run_dbt "${REL%%/*}" "$@"; return; fi
      else
        run_dbt "${REL%%/*}" "$@"; return
      fi ;;
  esac
  # outside every project there is nothing to guard: plain dbt v2
  # (`dbt --version`, `dbt system update`, `dbt login`…)
  ENGINE="$(dbt_engine v2)"
  [ -x "$ENGINE" ] || die "dbt v2 not installed ($ENGINE) — run: just setup"
  exec "$ENGINE" "$@"
}

case "$MODE" in
  v1|v2)
    if dbt_is_fleet; then select_product "${1:-}"; shift; fi
    run_dbt "$MODE" "$@" ;;
  global)
    dbt_is_fleet || die "no global/ project in a single-product workspace"
    run_dbt global "$@" ;;
  auto)
    run_auto "$@" ;;
  destinations)
    destinations "${1:-}" ;;
  upstream-pull)
    upstream_pull "${1:-}" ;;
  products)
    products ;;
  product-add)
    product_add "$@" ;;
  product-new)
    product_new "$@" ;;
  sync)
    sync_products "${1:-}" ;;
  lock)
    lock_write "${1:-}" ;;
  lock-status)
    lock_status ;;
  lock-checkout)
    lock_checkout "${1:-}" ;;
  lock-release)
    lock_release "${1:-}" ;;
  *)
    if dbt_is_fleet; then
      echo "usage: dbt-run.sh v1|v2 <product> <dbt args…> | global <dbt args…> | auto <dbt args…> | destinations [<product>|global] | upstream-pull [<product>] | products | sync [<product>] | lock [<product>] | lock-status | lock-checkout [<product>] | lock-release [<product>] | product-add <name> <url> [branch] [subdir] [global] [home] | product-new <name> <url> [branch] [subdir] [global]" >&2
    else
      echo "usage: dbt-run.sh v1|v2|auto <dbt args…> | destinations | upstream-pull" >&2
    fi
    exit 2 ;;
esac
