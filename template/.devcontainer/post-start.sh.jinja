#!/bin/bash
# =============================================================================
# Post-start script — runs on every container start (postStartCommand)
# =============================================================================

# postStartCommand is launched via `docker exec -u vscode ...` and the base
# devcontainer image does not declare ENV HOME, so $HOME is often empty here.
# An empty $HOME silently expands `$HOME/.local/bin` to `/.local/bin` and
# breaks every PATH lookup downstream (uv, cargo, claude). Resolve from
# /etc/passwd before anything else uses $HOME.
HOME="${HOME:-$(getent passwd "$(whoami)" | cut -d: -f6)}"
export HOME

WORKSPACE_DIR="${containerWorkspaceFolder:-$(pwd)}"
BASHRC="$HOME/.bashrc"

# postStartCommand inherits a minimal system PATH and does not source ~/.bashrc,
# so user-installed CLIs (uv, cargo, claude) are invisible here and to any
# subprocess we launch (notably post-start-project.sh and the MCP servers it
# spawns). Re-export the same PATH that post-create.sh sets up.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.claude/bin:$PATH"
{%- if secrets_source == 'keyvault' %}

# umask : sous OrbStack, tout processus lancé par `docker exec` (serveur VS Code,
# ses terminaux, claude, ce script) a l'umask 0000 — le PID 1 du container a
# 0022 — et crée ses fichiers en 0666/0777. 022 ici et dans les terminaux.
umask 022

# Journal : aussi dans ~/.local/state/devcontainer/post-start.log (le précédent
# en .1), relisible depuis un terminal ou Claude Code — la sortie « Dev
# Containers » de VS Code ne l'est pas. Aucune valeur secrète : rien ici n'en
# affiche (noms, références et longueurs seulement).
POST_START_LOG="$HOME/.local/state/devcontainer/post-start.log"
mkdir -p "$(dirname "$POST_START_LOG")"
[ -f "$POST_START_LOG" ] && mv -f "$POST_START_LOG" "$POST_START_LOG.1"
( umask 077; : >"$POST_START_LOG" )
exec > >(tee -a "$POST_START_LOG") 2>&1
echo "post-start $(date -Is)"

# --relance-mcp (ou SECRETS_RELANCE_MCP=1) : arrête les serveurs MCP qui
# répondent déjà, pour les relancer avec les valeurs du moment (secret changé
# dans le coffre). Un .env.refs modifié depuis le dernier passage suffit.
SECRETS_RELANCE_MCP="${SECRETS_RELANCE_MCP:-0}"
[ "${1:-}" = "--relance-mcp" ] && SECRETS_RELANCE_MCP=1
{%- endif %}

echo "============================================"
echo "  Post-start checks..."
echo "============================================"

mkdir -p /tmp/claude-code

# --- Claude alias ---
echo "[1/4] Claude alias..."
if ! grep -q "alias claude=" "$BASHRC" 2>/dev/null; then
  echo 'alias claude="claude --dangerously-skip-permissions"' >> "$BASHRC"
  echo "  alias added"
else
  echo "  already set"
fi

# --- Sécurisation des fichiers sensibles ---
echo "[2/4] Securing sensitive files..."
{%- if secrets_source == 'keyvault' %}
# .env.ecc et tout .env restant ou mis de côté (.env, .env.bak…) : 600.
# .env.refs et les modèles *.example ne contiennent aucune valeur secrète.
for f in "$WORKSPACE_DIR"/.env "$WORKSPACE_DIR"/.env.*; do
  [ -f "$f" ] || continue
  case "${f##*/}" in .env.refs | *.example) continue ;; esac
  chmod 600 "$f" && echo "  ${f##*/}"
done
chmod 600 "$WORKSPACE_DIR/.mcp.json" 2>/dev/null && echo "  .mcp.json" || true
{%- else %}
chmod 600 "$WORKSPACE_DIR/.env"      2>/dev/null && echo "  .env" || true
chmod 600 "$WORKSPACE_DIR/.env.ecc"  2>/dev/null && echo "  .env.ecc" || true
chmod 600 "$WORKSPACE_DIR/.mcp.json" 2>/dev/null && echo "  .mcp.json" || true
{%- endif %}
{% if secrets_source == 'keyvault' %}
# --- Secrets : .env.refs résolu depuis Key Vault, en mémoire ---
# Le .env n'est plus lu (un .env restant est ignoré, jamais supprimé). Les
# variables chargées ici passent aux serveurs MCP et à post-start-project.sh
# (NetBird…), qui en héritent sans relire de fichier.
echo "[3/4] Secrets (Key Vault)..."
source "$WORKSPACE_DIR/.devcontainer/lib-secrets.sh"
secrets_install "$WORKSPACE_DIR"
SECRETS_OK=0
secrets_load_env "$WORKSPACE_DIR/.env.refs" && SECRETS_OK=1
{%- else %}
# --- Chargement du .env ---
echo "[3/4] Loading .env..."
if [ -f "$WORKSPACE_DIR/.env" ]; then
  set -a; source "$WORKSPACE_DIR/.env"; set +a
  echo "  .env loaded"
else
  echo "  .env not found — copy from .env.example if needed"
fi
{%- endif %}

# =============================================================================
# MCP servers (template-managed — lib-mcp.sh + mcp-servers.conf)
# Self-healing: a failed post-create install (e.g. missing
# GITHUB_PERSONAL_ACCESS_TOKEN at first build) is repaired here on a plain
# container restart — no rebuild needed.
# =============================================================================
echo ""
echo "[4/4] MCP servers (mcp-servers.conf)..."
source "$WORKSPACE_DIR/.devcontainer/lib-mcp.sh"
{%- if secrets_source == 'keyvault' %}
secrets_override_mcp_link_env
if [ "$SECRETS_OK" = 1 ]; then
  secrets_mcp_relance "$WORKSPACE_DIR/.devcontainer/mcp-servers.conf" "$WORKSPACE_DIR/.env.refs" "$SECRETS_RELANCE_MCP"
  mcp_process_manifest "$WORKSPACE_DIR/.devcontainer/mcp-servers.conf" start
else
  echo "[mcp] skipped: .env.refs not resolved (see [3/4]) — az login, then"
  echo "      bash .devcontainer/post-start.sh   (or restart the container)"
fi
{%- else %}
mcp_process_manifest "$WORKSPACE_DIR/.devcontainer/mcp-servers.conf" start
{%- endif %}

# Optional second sap-adt-mcp instance targeting SAP ECC EHP8 on port 8001.
# Runtime-gated, not Jinja-gated: starts only when both .env.ecc and the ECC
# launcher exist, so ECC can be flipped on/off without re-running copier.
SAP_ADT_ECC_LAUNCHER="/opt/sap-adt-mcp/scripts/mcp-server-ecc.sh"
if [ -f "/opt/sap-adt-mcp/.env.ecc" ] && [ -x "$SAP_ADT_ECC_LAUNCHER" ]; then
{%- if secrets_source == 'keyvault' %}
  # sans les variables S/4HANA de .env.refs : elles l'emporteraient sur .env.ecc
  secrets_sans_refs "$WORKSPACE_DIR/.env.refs" "$SAP_ADT_ECC_LAUNCHER" start
{%- else %}
  "$SAP_ADT_ECC_LAUNCHER" start
{%- endif %}
  mcp_wait_port "sap-adt-ecc" 8001 "/opt/sap-adt-mcp/logs/server-ecc.log"
fi
{%- if dbt_workspace %}

# =============================================================================
# dbt workspace (template-managed — lib-dbt.sh + dbt.conf)
# Self-healing: both engines, ~/.gitconfig (pinned host key, push lock) and
# ~/.bashrc live in the container filesystem and are put back here; a
# worktree that could not be created at build time (upstream unreachable) is
# retried. Nothing is fetched nor upgraded once everything is in place.
# =============================================================================
echo ""
source "$WORKSPACE_DIR/.devcontainer/lib-dbt.sh"
dbt_process "$WORKSPACE_DIR" start
{%- endif %}

# =============================================================================
# Project-specific checks (not managed by template — safe from copier update)
# =============================================================================
PROJECT_POST_START="$WORKSPACE_DIR/.devcontainer/post-start-project.sh"
if [ -f "$PROJECT_POST_START" ]; then
  echo ""
  echo "--- Project-specific post-start ---"
  warn_legacy_mcp_hooks "$PROJECT_POST_START"
  bash "$PROJECT_POST_START" "$WORKSPACE_DIR"
  # pre-v0.8.15 hooks bake the PAT into the origins — scrub it back out
  mcp_scrub_origins "$WORKSPACE_DIR/.devcontainer/mcp-servers.conf"
else
  echo "  (no post-start-project.sh — see post-start-project.example.sh)"
fi

echo ""
echo "============================================"
echo "  Post-start complete!"
echo "============================================"
