#!/bin/bash
# =============================================================================
# lib-secrets.sh — secrets lus dans Azure Key Vault (TEMPLATE-OWNED)
# Mis à jour par `copier update` — ne pas modifier dans les projets.
# Rendu seulement avec secrets_source=keyvault.
#
# Le .env en clair est remplacé par .env.refs (versionné, sans aucune valeur
# secrète) que le lanceur .devcontainer/secrets/secrets résout avec l'identité
# `az login` de la personne, EN MÉMOIRE : rien n'est écrit sur disque, aucune
# valeur ne passe sur une ligne de commande.
#
# Sourcé par :
#   - post-create.sh / post-start.sh : secrets_install, secrets_load_env,
#     secrets_override_mcp_link_env ;
#   - ~/.bashrc (bloc posé par secrets_install) : umask 022, fonctions de
#     terminal `profil` et `claude`. `gh` est l'enveloppe ~/.local/bin/gh
#     (secrets/gh), valable aussi hors terminal interactif.
#
# Contraintes : survivre à `set -eu`, ne jamais faire échouer le cycle de vie
# du container (les fonctions rendent 0 sauf secrets_load_env, qui dit si les
# variables sont chargées), ne jamais afficher une valeur.
# =============================================================================

[ -n "${_LIB_SECRETS_LOADED:-}" ] && return 0
_LIB_SECRETS_LOADED=1

_SECRETS_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_DIR="$_SECRETS_LIB_DIR/secrets"
# Sessions az, une par profil, dans un volume Docker (survit au rebuild).
# Le profil par défaut sert au cycle de vie du container (post-start : serveurs
# MCP, NetBird…) ; `profil <alias>` en choisit un autre dans un terminal.
SECRETS_PROFILS_DIR="${SECRETS_PROFILS_DIR:-$HOME/.azure-profils}"
SECRETS_TENANT="${SECRETS_TENANT:-53a0f5d2-129f-454e-9ed3-1f5fed0e66e5}"

_secrets_login_hint() {
  echo "        az login --use-device-code --tenant $SECRETS_TENANT"
}

# --- cycle de vie --------------------------------------------------------------

# secrets_install WORKSPACE — lanceur et assistant git dans ~/.local/bin,
# volume des sessions az à nous, assistant d'identifiants github.com,
# fonctions de terminal dans ~/.bashrc. Idempotent (post-create ET post-start).
secrets_install() {
  local ws="${1:-${WORKSPACE_DIR:-}}" bashrc="$HOME/.bashrc"
  echo "[secrets] lanceur Key Vault..."
  if [ ! -f "$SECRETS_DIR/secrets" ]; then
    echo "  ERREUR : $SECRETS_DIR/secrets absent — relancer copier update"
    return 0
  fi
  # Copier rend les fichiers avec l'umask du container (0000 : 0666/0777) :
  # lanceur et bibliothèque exécutés depuis ~/.local/bin et ~/.bashrc ne
  # doivent être modifiables que par nous.
  chmod go-w "$_SECRETS_LIB_DIR/lib-secrets.sh" "$SECRETS_DIR" "$SECRETS_DIR"/* 2>/dev/null || true
  chmod +x "$SECRETS_DIR/secrets" "$SECRETS_DIR/git-credential-secrets" "$SECRETS_DIR/gh" 2>/dev/null || true
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SECRETS_DIR/secrets" "$HOME/.local/bin/secrets"
  ln -sfn "$SECRETS_DIR/git-credential-secrets" "$HOME/.local/bin/git-credential-secrets"
  # gh hors terminal interactif (Claude Code, scripts, MCP) : la fonction `gh`
  # de ~/.bashrc n'y existe pas ; l'enveloppe lui passe le jeton du projet.
  [ -f "$SECRETS_DIR/gh" ] && ln -sfn "$SECRETS_DIR/gh" "$HOME/.local/bin/gh"
  echo "  secrets → $(sed -n 's/^commit=//p' "$SECRETS_DIR/SOURCE" 2>/dev/null | cut -c1-12)"

  # Un volume Docker neuf appartient à root
  if [ -d "$SECRETS_PROFILS_DIR" ] && [ ! -w "$SECRETS_PROFILS_DIR" ]; then
    sudo -n chown "$(id -u):$(id -g)" "$SECRETS_PROFILS_DIR" 2>/dev/null || true
  fi
  mkdir -p "${AZURE_CONFIG_DIR:-$SECRETS_PROFILS_DIR/defaut}" 2>/dev/null || true
  # sessions az : à nous seuls, quel que soit l'umask du container
  chmod 700 "$SECRETS_PROFILS_DIR" "$SECRETS_PROFILS_DIR"/* 2>/dev/null || true

  # github.com en https : notre assistant passe en premier ("" vide la liste
  # des assistants lus avant lui ; celui de VS Code, s'il est écrit plus loin
  # dans ~/.gitconfig, reste un repli). Les remotes ssh ne sont pas concernés.
  git config --global --unset-all credential.https://github.com.helper 2>/dev/null || true
  git config --global --add credential.https://github.com.helper ""
  git config --global --add credential.https://github.com.helper secrets
  [ -n "$ws" ] && export SECRETS_WORKSPACE="$ws"
  echo "  git https://github.com, gh → $("$SECRETS_DIR/git-credential-secrets" ref "$ws")"

  # Terminal (umask 022, profil, claude) : bloc remplacé à chaque passage
  if [ -n "$ws" ] && touch "$bashrc"; then
    sed -i '/^# >>> secrets (sap-template) >>>$/,/^# <<< secrets (sap-template) <<<$/d' "$bashrc"
    cat >>"$bashrc" <<EOF
# >>> secrets (sap-template) >>>
umask 022  # docker exec d'OrbStack : 0000 (fichiers en 0666/0777)
export SECRETS_WORKSPACE="$ws"
[ -f "\$SECRETS_WORKSPACE/.devcontainer/lib-secrets.sh" ] && source "\$SECRETS_WORKSPACE/.devcontainer/lib-secrets.sh"
# <<< secrets (sap-template) <<<
EOF
    echo "  ~/.bashrc : umask 022, profil, claude"
  fi
  return 0
}

# secrets_load_env FICHIER — exporte dans le shell COURANT les variables de
# FICHIER (.env.refs) résolues par le lanceur. Les valeurs passent par un tube
# (env -0), jamais par le disque ni la ligne de commande. Rend 1 si rien n'est
# chargé (pas de session az, référence introuvable…) : l'appelant saute alors
# ce qui en dépend.
secrets_load_env() {
  local refs="${1:-}" noms rapport kv n=0 nom
  echo "[secrets] .env.refs → Key Vault..."
  if [ ! -f "$refs" ]; then
    echo "  $refs absent — rien à charger"
    return 1
  fi
  if ! command -v az >/dev/null 2>&1; then
    echo "  az absent — rebuild nécessaire (feature azure-cli)"
    return 1
  fi
  if ! az account show >/dev/null 2>&1; then
    echo "  pas de session az (profil par défaut). Dans un terminal :"
    _secrets_login_hint
    echo "        puis relancer : bash .devcontainer/post-start.sh   (ou redémarrer le container)"
    return 1
  fi
  # `secrets check` n'affiche que des noms et des références
  if ! rapport="$(secrets check -f "$refs" 2>&1)"; then
    echo "  références non résolues — rien n'est chargé :"
    printf '%s\n' "$rapport" | grep -v '^  ok ' | sed 's/^/  /'
    return 1
  fi
  noms=" $(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' "$refs" | tr '\n' ' ') "
  while IFS= read -r -d '' kv; do
    nom="${kv%%=*}"
    case "$noms" in *" $nom "*) export "$kv"; n=$((n + 1)) ;; esac
  done < <(secrets run -f "$refs" -- env -0)
  echo "  $n variable(s) chargée(s) en mémoire ($(secrets qui 2>/dev/null | sed -n 's/^compte az *: //p'))"
  if [ -f "$(dirname "$refs")/.env" ]; then
    echo "  NOTE : un .env est encore présent : ignoré par les scripts du container,"
    echo "         jamais supprimé d'office. Le retirer quand .env.refs couvre tout."
  fi
  [ "$n" -gt 0 ]
}

# secrets_override_mcp_link_env — à appeler APRÈS `source lib-mcp.sh` : les
# serveurs MCP héritent des variables chargées (pydantic-settings lit
# l'environnement avant tout fichier) ; on ne lie plus le .env du projet dans
# /opt/<serveur>, et on retire le lien laissé par une version antérieure.
# .env.ecc (seconde instance ECC) reste lié tel quel.
secrets_override_mcp_link_env() {
  mcp_link_env() {
    local NAME="${1:-}" DEST="${MCP_OPT_DIR:-/opt}/${1:-}"
    [ -n "$NAME" ] && [ -d "$DEST" ] || return 0
    if [ -L "$DEST/.env" ]; then
      rm -f "$DEST/.env" && echo "  $NAME : ancien lien .env retiré (variables lues depuis Key Vault)"
    fi
    [ -f "${WORKSPACE_DIR:-}/.env.ecc" ] && ln -sf "$WORKSPACE_DIR/.env.ecc" "$DEST/.env.ecc"
    return 0
  }
}

# secrets_mcp_relance MANIFESTE REFS [FORCE] — à appeler APRÈS `source
# lib-mcp.sh`, avant le démarrage. Un serveur MCP qui répond déjà est gardé par
# post-start, avec les variables reçues à SON lancement. On l'arrête donc (puis
# post-start le relance avec celles du moment) :
#   - quand REFS (.env.refs) a changé depuis le dernier post-start ;
#   - quand FORCE=1 (post-start.sh --relance-mcp) : valeur changée dans le coffre.
# Seule l'empreinte de .env.refs (des références, aucune valeur) est gardée.
secrets_mcp_relance() {
  local manifeste="${1:-}" refs="${2:-}" force="${3:-0}" ligne nom lanceur avant apres raison
  local etat="$HOME/.local/state/devcontainer/env-refs.sha256"
  [ -f "$manifeste" ] && [ -f "$refs" ] || return 0
  apres="$(sha256sum <"$refs" | cut -d' ' -f1)"
  avant="$(cat "$etat" 2>/dev/null || true)"
  mkdir -p "$(dirname "$etat")" && printf '%s\n' "$apres" >"$etat"
  if [ "$force" = 1 ]; then
    raison="--relance-mcp"
  elif [ -n "$avant" ] && [ "$avant" != "$apres" ]; then
    raison=".env.refs modifié"
  else
    return 0
  fi
  while IFS= read -r ligne || [ -n "$ligne" ]; do
    ligne="${ligne%%#*}"
    read -r nom _ <<<"$ligne"
    [ -n "${nom:-}" ] || continue
    lanceur="${MCP_OPT_DIR:-/opt}/$nom/scripts/mcp-server.sh"
    [ -x "$lanceur" ] || continue
    echo "[mcp] $nom : arrêt pour relance ($raison)"
    "$lanceur" stop >/dev/null 2>&1 || echo "  WARNING: $nom stop a échoué"
  done <"$manifeste"
  return 0
}

# secrets_sans_refs FICHIER COMMANDE... — lance COMMANDE sans les variables
# déclarées dans FICHIER (ex. l'instance ECC, qui lit les siennes dans .env.ecc
# et que les variables S/4HANA déjà chargées masqueraient).
secrets_sans_refs() {
  local refs="${1:-}" nom args=(); shift
  while IFS= read -r nom; do args+=(-u "$nom"); done < <(
    sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' "$refs" 2>/dev/null)
  env "${args[@]}" "$@"
}

# --- terminal ------------------------------------------------------------------
# `function nom {` et non `nom() {` : post-start.sh pose `alias claude=…` dans
# ~/.bashrc, et un alias serait développé dans `claude() {`.

# profil [ALIAS | -] — choisit la session az de CE terminal (et de ce qu'il
# lance : secrets, gh, git, claude). Sans argument : affiche le profil courant.
# « - » : revient au profil par défaut. ALIAS doit figurer dans personnes.conf.
function profil {
  local alias="${1:-}" conf="$SECRETS_DIR/personnes.conf" compte attendu
  case "$alias" in
    "")
      echo "profil        : ${SECRETS_PROFIL:-défaut} (AZURE_CONFIG_DIR=${AZURE_CONFIG_DIR:-~/.azure})"
      secrets qui 2>&1
      return 0 ;;
    -)
      unset SECRETS_PROFIL GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
      export AZURE_CONFIG_DIR="$SECRETS_PROFILS_DIR/defaut"
      echo "profil par défaut"
      return 0 ;;
  esac
  if ! awk -v a="$alias" '!/^[[:space:]]*#/ && $1 == a { t = 1 } END { exit !t }' "$conf" 2>/dev/null; then
    echo "profil : « $alias » n'est pas dans personnes.conf ($(awk '!/^[[:space:]]*#/ && NF { printf "%s ", $1 }' "$conf"))" >&2
    return 1
  fi
  export SECRETS_PROFIL="$alias" AZURE_CONFIG_DIR="$SECRETS_PROFILS_DIR/$alias"
  unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
  mkdir -p "$AZURE_CONFIG_DIR" && chmod 700 "$AZURE_CONFIG_DIR"
  if ! compte="$(az account show --query user.name -o tsv 2>/dev/null)"; then
    echo "profil $alias : pas encore de session az. Une fois :"
    _secrets_login_hint
    echo "        puis : profil $alias"
    return 0
  fi
  attendu="$(awk -v u="$(printf '%s' "$compte" | tr '[:upper:]' '[:lower:]')" \
    '!/^[[:space:]]*#/ { for (i = 2; i <= NF; i++) if (tolower($i) == u) { print $1; exit } }' "$conf")"
  if [ "$attendu" != "$alias" ]; then
    echo "profil $alias : ATTENTION, la session az est celle de $compte (${attendu:-hors personnes.conf})." >&2
    echo "        az logout, puis az login avec le bon compte." >&2
    return 1
  fi
  _secrets_git_identite
  echo "profil $alias : az $compte${GIT_AUTHOR_NAME:+, commits signés $GIT_AUTHOR_NAME <$GIT_AUTHOR_EMAIL>}"
}

# Auteur des commits du profil, d'après le compte GitHub de son jeton
# (gh api user : nom et adresse noreply). Mis en cache dans le dossier du profil.
_secrets_git_identite() {
  local cache="$AZURE_CONFIG_DIR/git-identite" ligne
  if [ ! -s "$cache" ]; then
    ligne="$(gh api user --jq '"\(.name // .login)\t\(.id)+\(.login)@users.noreply.github.com"' 2>/dev/null)" || return 0
    [ -n "$ligne" ] && printf '%s\n' "$ligne" >"$cache"
  fi
  IFS=$'\t' read -r GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL <"$cache" || return 0
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
}

# claude : lancé sous `secrets run`, il hérite des variables de .env.refs (et
# les serveurs MCP stdio qu'il démarre aussi). Si la résolution échoue, prévient
# et démarre quand même, sans ces variables.
function claude {
  local refs="${SECRETS_WORKSPACE:-$PWD}/.env.refs" bin
  bin="$(type -P claude)" || { echo "claude introuvable" >&2; return 127; }
  if [ -f "$refs" ] && secrets check -f "$refs" >/dev/null 2>&1; then
    secrets run -f "$refs" -- "$bin" "$@"
  else
    echo "secrets : .env.refs non résolu (secrets check) — Claude Code démarre SANS ces variables." >&2
    "$bin" "$@"
  fi
}
