#!/bin/bash
# =============================================================================
# dbt-run.sh — the guarded way to run dbt in this workspace (TEMPLATE-OWNED)
# Updated by `copier update` — do not edit in projects.
#
#   dbt-run.sh v1 <dbt args…>     dbt Core 1.x on v1/          (just v1 …)
#   dbt-run.sh v2 <dbt args…>     dbt v2 on v2/                (just v2 …)
#   dbt-run.sh auto <dbt args…>   engine from the current directory — what
#                                 the `dbt` shell function calls
#   dbt-run.sh destinations       where v1 and v2 would write each node, and
#                                 where they disagree          (just destinations)
#   dbt-run.sh upstream-pull      fetch upstream, refresh its mirror on origin
#                                                              (just upstream-pull)
#
# Every process of the container already gets the profile hub
# (DBT_PROFILES_DIR). On top of it, this wrapper:
#   - imposes the hub: --profiles-dir is refused
#   - loads profiles/dbt.env, the env vars the project's Jinja needs
#   - refuses run-operation (arbitrary macros) unless DBT_ALLOW_RUN_OPERATION=1
#   - lets a write (run/build/seed/snapshot/clone/retry) through only with an
#     explicit selection whose every node resolves into the sandbox: project
#     DBT_BQ_PROJECT, dataset starting with DBT_BQ_DATASET_PREFIX
#   - refuses writes on a project that has hooks until DBT_HOOKS_REVIEWED=1
# The raw engines (`dbt1`, `dbtf`) and the editor extensions' buttons bypass
# these guards — they only get the hub.
# =============================================================================
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WS="$(dirname "$HERE")"
# shellcheck disable=SC1091
source "$HERE/lib-dbt.sh"
dbt_load_conf "$WS"

die()    { echo "⛔ $*" >&2; exit 1; }
refuse() { echo "⛔ $1" >&2; shift; for L in "$@"; do echo "   $L" >&2; done; exit 1; }

MODE="${1:-}"
[ $# -gt 0 ] && shift

# -----------------------------------------------------------------------------
# upstream-pull
# -----------------------------------------------------------------------------
upstream_pull() {
  local BR="${DBT_UPSTREAM_BRANCH:-main}" OLD NEW V
  git -C "$WS" remote get-url upstream >/dev/null 2>&1 || die "no 'upstream' remote — run: just setup"
  OLD="$(git -C "$WS" rev-parse -q --verify "refs/remotes/upstream/$BR" 2>/dev/null || true)"
  echo "→ git fetch upstream (read-only)"
  git -C "$WS" fetch --no-tags upstream || die "fetch failed (VPN? SSH key? pinned host key?)"
  NEW="$(git -C "$WS" rev-parse -q --verify "refs/remotes/upstream/$BR")" || die "upstream has no branch '$BR'"
  if [ "$OLD" = "$NEW" ]; then
    echo "  upstream/$BR unchanged (${NEW:0:9})"
  else
    echo "  upstream/$BR: ${OLD:+${OLD:0:9} → }${NEW:0:9}"
    git -C "$WS" --no-pager log --oneline -n 20 "${OLD:+$OLD..}$NEW"
  fi
  echo "→ mirror on origin: upstream-$BR"
  git -C "$WS" push origin "refs/remotes/upstream/$BR:refs/heads/upstream-$BR" \
    || echo "  WARNING: mirror not pushed (origin unreachable, or upstream history was rewritten)" >&2
  for V in $DBT_WORKTREES; do
    git -C "$WS" show-ref --verify --quiet "refs/heads/$V" || continue
    echo "  $V: $(git -C "$WS" rev-list --count "$V..upstream/$BR") commit(s) behind upstream/$BR, $(git -C "$WS" rev-list --count "upstream/$BR..$V") ahead"
  done
  echo "Nothing was merged. To take the changes: cd v1 && git merge upstream/$BR, then cd ../v2 && git merge v1"
}

# -----------------------------------------------------------------------------
# destinations
# -----------------------------------------------------------------------------
destinations() {
  local TMP V RC=0
  TMP="$(mktemp -d)"
  export_env
  for V in $DBT_WORKTREES; do
    if dbt_destinations "$V" > "$TMP/$V.tsv" && [ -s "$TMP/$V.tsv" ]; then
      echo "== $V: $(wc -l < "$TMP/$V.tsv") node(s) =="
      cut -f2,3 "$TMP/$V.tsv" | sort | uniq -c | sort -rn | sed 's/^/  /'
    else
      echo "== $V: no destination — \`just $V parse\` must pass first =="
      : > "$TMP/$V.tsv"
      RC=1
    fi
  done
  python3 - "$TMP/v1.tsv" "$TMP/v2.tsv" <<'PY'
import sys
def load(path):
    out = {}
    for line in open(path):
        p = line.rstrip("\n").split("\t")
        if len(p) == 4:
            out[(p[0], p[3])] = (p[1], p[2])
    return out
a, b = load(sys.argv[1]), load(sys.argv[2])
if not a or not b:
    sys.exit(0)
moved = sorted(k for k in a.keys() & b.keys() if a[k] != b[k])
only1, only2 = sorted(a.keys() - b.keys()), sorted(b.keys() - a.keys())
print(f"== v1 vs v2: {len(moved)} node(s) written elsewhere, {len(only1)} only in v1, {len(only2)} only in v2 ==")
for k in moved:
    print(f"  {k[0]} {k[1]}: {'.'.join(a[k])}  ->  {'.'.join(b[k])}")
for k in only1:
    print(f"  only in v1: {k[0]} {k[1]}")
for k in only2:
    print(f"  only in v2: {k[0]} {k[1]}")
PY
  rm -rf "$TMP"
  return $RC
}

# -----------------------------------------------------------------------------
# Running dbt
# -----------------------------------------------------------------------------

# The hub is imposed and the project env file is loaded; nothing in that file
# can move the lock.
export_env() {
  if [ -f "$WS/profiles/dbt.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$WS/profiles/dbt.env"
    set +a
  fi
  export DBT_PROFILES_DIR="$WS/profiles"
  export DBT_SEND_ANONYMOUS_USAGE_STATS="${DBT_SEND_ANONYMOUS_USAGE_STATS:-false}"
}

has_hooks() {
  grep -rIlqiE --include='*.sql' --include='*.yml' --include='*.yaml' \
    --exclude-dir=dbt_packages --exclude-dir=dbt_modules --exclude-dir=target \
    --exclude-dir=logs --exclude-dir=.venv \
    '(pre|post)[-_]hook|on-run-(start|end)' "$1" 2>/dev/null
}

run_dbt() {
  local V="$1" PROJ ENGINE A CMD_WRITE="" CMD_RUNOP="" SELECTED="" COLLECT=0 OUT BAD
  local -a SEL=()
  shift
  PROJ="$(dbt_project_dir "$V")" || die "no dbt project in $V/ (worktree missing, or set DBT_PROJECT_SUBDIR in dbt.conf) — run: just setup"
  ENGINE="$(dbt_engine "$V")"
  [ -x "$ENGINE" ] || die "engine $V not installed ($ENGINE) — run: just setup"

  for A in "$@"; do
    case "$A" in
      --profiles-dir|--profiles-dir=*)
        refuse "--profiles-dir is not allowed: the profile hub is imposed." \
               "Edit profiles/profiles.yml instead." ;;
      run|build|seed|snapshot|clone|retry) CMD_WRITE="$A" ;;
      run-operation) CMD_RUNOP=1 ;;
    esac
    # the arguments that decide WHICH nodes run and WHERE they resolve
    case "$A" in
      -s|--select|-m|--models|--model|--selector) SELECTED=1; SEL+=("$A"); COLLECT=1 ;;
      --select=*|--models=*|--model=*|--selector=*) SELECTED=1; SEL+=("$A"); COLLECT=0 ;;
      --exclude|--vars|--target|-t|--state|--indirect-selection) SEL+=("$A"); COLLECT=1 ;;
      --exclude=*|--vars=*|--target=*|--state=*|--indirect-selection=*) SEL+=("$A"); COLLECT=0 ;;
      -*) COLLECT=0 ;;
      *) [ "$COLLECT" = 1 ] && SEL+=("$A") ;;
    esac
  done

  export_env

  if [ -n "$CMD_RUNOP" ] && [ "${DBT_ALLOW_RUN_OPERATION:-0}" != "1" ]; then
    refuse "run-operation is refused: it executes arbitrary macros, outside every guard." \
           "Read the macro first; to allow it, set DBT_ALLOW_RUN_OPERATION=1 in .devcontainer/dbt.conf."
  fi

  if [ -n "$CMD_WRITE" ]; then
    [ -f "$WS/profiles/profiles.yml" ] \
      || refuse "no profile hub (profiles/profiles.yml): dbt has nowhere safe to write." \
                "Fill DBT_BQ_PROJECT / DBT_BQ_DATASET in .devcontainer/dbt.conf, then: just setup"
    [ -n "${DBT_BQ_PROJECT:-}" ] \
      || refuse "DBT_BQ_PROJECT is empty in .devcontainer/dbt.conf: no sandbox declared, writes are refused."
    [ "$CMD_WRITE" != "retry" ] \
      || refuse "retry replays a previous selection that cannot be checked here." \
                "Run the command again with an explicit --select."
    [ -n "$SELECTED" ] \
      || refuse "\`dbt $CMD_WRITE\` without a selection: never a whole project by accident." \
                "Add --select <models>."
    if has_hooks "$PROJ" && [ "${DBT_HOOKS_REVIEWED:-0}" != "1" ]; then
      refuse "this project has hooks (pre/post-hook, on-run-*): they run SQL outside any" \
             "materialization, possibly against a source — the sandbox check cannot see them." \
             "Read them, then set DBT_HOOKS_REVIEWED=1 in .devcontainer/dbt.conf."
    fi
    echo "[dbt:$V] checking where the selection would write…" >&2
    OUT="$(dbt_destinations "$V" ${SEL[@]+"${SEL[@]}"})" \
      || refuse "cannot resolve the selection (dbt ls failed): a write whose destination is unknown is refused." \
                "See it fail with: just $V ls ${SEL[*]:-}"
    BAD="$(printf '%s\n' "$OUT" | awk -F'\t' -v p="$DBT_BQ_PROJECT" -v x="${DBT_BQ_DATASET_PREFIX:-}" \
      'NF==4 && ($2!=p || (x!="" && index($3,x)!=1)) {print "   " $1 " " $4 " -> " $2 "." $3}')"
    if [ -n "$BAD" ]; then
      echo "⛔ \`dbt $CMD_WRITE\` refused: $(printf '%s\n' "$BAD" | wc -l) selected node(s) would be written outside the sandbox" >&2
      echo "   (allowed: project $DBT_BQ_PROJECT${DBT_BQ_DATASET_PREFIX:+, dataset starting with $DBT_BQ_DATASET_PREFIX}):" >&2
      printf '%s\n' "$BAD" | head -n 15 >&2
      [ "$(printf '%s\n' "$BAD" | wc -l)" -gt 15 ] && echo "   … (full list: just destinations)" >&2
      exit 1
    fi
    echo "[dbt:$V] $(printf '%s\n' "$OUT" | grep -c .) node(s), all inside the sandbox" >&2
  fi

  # Run from the project directory, unless the caller already stands in it
  # (the `dbt` function: paths given on the command line stay relative).
  case "$PWD/" in
    "$PROJ/"*) ;;
    *) cd "$PROJ" || die "cannot enter $PROJ" ;;
  esac
  exec "$ENGINE" "$@"
}

case "$MODE" in
  v1|v2)
    run_dbt "$MODE" "$@" ;;
  auto)
    case "$PWD/" in
      "$WS/v1/"*) run_dbt v1 "$@" ;;
      "$WS/v2/"*) run_dbt v2 "$@" ;;
      *)
        # outside both worktrees there is no project to guard: plain dbt v2
        # (`dbt --version`, `dbt system update`, `dbt login`…)
        ENGINE="$(dbt_engine v2)"
        [ -x "$ENGINE" ] || die "dbt v2 not installed ($ENGINE) — run: just setup"
        exec "$ENGINE" "$@" ;;
    esac ;;
  destinations)
    destinations ;;
  upstream-pull)
    upstream_pull ;;
  *)
    echo "usage: dbt-run.sh v1|v2|auto <dbt args…> | destinations | upstream-pull" >&2
    exit 2 ;;
esac
