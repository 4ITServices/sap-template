#!/bin/bash
# =============================================================================
# lib-dbt.sh — dbt dual-engine workspace lifecycle (TEMPLATE-OWNED)
# Updated by `copier update` — do not edit in projects.
#
# Sourced by post-create.sh, post-start.sh, dbt-run.sh and dbt-doctor.sh, and
# driven by the project-owned manifest .devcontainer/dbt.conf — plus, for a
# fleet of data products (DBT_FLEET=1), .devcontainer/products.conf.
#
# Two layouts, one engine:
#   single product (dbt-project)        fleet (dbt-fleet)
#     v1/            branch v1            v1/<product>/   branch <product>/v1
#     v2/            branch v2            v2/<product>/   branch <product>/v2
#     remote upstream                     remote up-<product>
#     mirror on origin: upstream-<br>     global/  a dbt v2 project that pulls
#                                                  the v2 of the products in
#                                                  as local packages
#
# Where a fleet product's branches LIVE (column HOME of products.conf):
#   - its own repository (a dbt-project repo, the coordinator model): remote
#     home-<product>; the worktrees track its v1/v2, `git push` goes there,
#     the mirror is its upstream-<br>; this repository only holds main
#   - or this repository (HOME '-'): <product>/v1, <product>/v2 and the
#     mirror <product>/upstream on origin
# Every per-product function works on the CURRENT product, chosen with
# dbt_use_product (no argument in single mode).
#
# A third generation, v4 (dbt v2 again: a refactoring branch on top of v2),
# is opt-in per product and never part of DBT_WORKTREES (fleet only):
#   - a product listed in DBT_V4_PRODUCTS (dbt.conf) also gets v4/<product>/,
#     branch <product>/v4 — opened where its branches live, from the published
#     v2, and only ever TRACKED here (never created from v1 or upstream);
#   - a REFERENT, a product born here (.devcontainer/referents.conf: no
#     upstream, no remote up-<name>, no mirror, no v1/v2), has v4/<name>/ only.
# v4/ and the assembly project global-v4/ write under their own dataset
# prefix, DBT_BQ_DATASET_PREFIX_V4 (profiles/v4.env, generated from dbt.env):
# the v2 and the v4 of a product carry the same package names, so under one
# prefix they would write the same tables. dbt_versions tells which worktrees
# the current product follows.
# A FLUX is a working copy of the fleet where v4 work runs in parallel with the
# main copy (one redescente, one simulation…): declared by an untracked,
# git-ignored .devcontainer/flux.conf — one line DBT_V4_FLUX=<A999>, a capital
# letter and three digits, or DBT_V4_FLUX=H, the HARMONIZED line (a v4 where
# every deviation is brought back to one standard, beside the main copy's ISO
# line) —, never by dbt.conf nor by an exported variable. Its
# v4/ and global-v4/ write under <DBT_BQ_DATASET_PREFIX_V4>_<FLUX> (= or _*),
# profiles/v4-<FLUX>.env, and nowhere else: not the main v4 space, not another
# flux, not the v1/v2/global spaces (no build, no hook there). The harmonized
# line is apart in git too: its v4 worktrees follow branches of their own,
# <product>/v4-h (v4-h where the product's branches live), opened THERE from the
# published v4 — a v4 copy on any other branch is refused —, no push of it
# reaches v1, v2 nor v4 (a pre-push hook, git-push-garde-h.sh), its lock is
# .devcontainer/products-h.lock, and clone, --state, --defer and --manage-state
# are refused there (they would bring another space's relations or state in).
# The MAIN copy is named, never guessed: DBT_V4_MAIN_WS (dbt.conf) is its real path, and it is never a
# flux. In a fleet with a v4, a copy that is neither the main one nor a flux (a
# clone, a flux whose flux.conf was erased by `git clean -X`) has no v4 space
# and builds nothing — `just setup` does not make it the main copy. Only the
# main copy writes the container's state (~/.bashrc, the global git settings
# that name a path, the engines). The main copy never writes a flux's space.
#
# What `dbt_process <workspace> create|start` guarantees:
#   - every UPSTREAM repository (the dbt projects taken over) is readable and
#     receives no push by git: pinned host keys, HTTPS->SSH rewrite for their
#     private dbt packages, push lock (global pushInsteadOf + remote pushurl
#     + the ssh push guard git-ssh-garde.sh, copied out of the worktree, as
#     core.sshCommand + no https for an upstream host read over ssh: a dead
#     proxy, no credentials). Not covered: ssh outside git with the same key,
#     a deliberate override of git's configuration — only a read-only access
#     on the server covers those (see git-ssh-garde.sh)
#   - the v1 and v2 git worktrees of each product (branches of THIS repository)
#   - two engines side by side: dbt Core 1.x in the /opt/dbt-v1 venv (`dbt1`)
#     — built from the project's own pins, or from DBT_V1_PINS, the version a
#     whole fleet shares — and dbt v2 at ~/.local/bin/dbt (`dbtf`), where the
#     official dbt extension expects it
#   - a fail-closed profile hub: <workspace>/profiles is the only place dbt
#     reads profiles from (DBT_PROFILES_DIR)
#
# Design constraints (same as lib-mcp.sh):
#   - functions must survive `set -eu` callers: every env read is guarded
#     with ${VAR:-} and every best-effort command has an explicit fallback
#   - never abort the container lifecycle: lifecycle helpers always return 0
#   - self-healing: whatever lives in the container filesystem (venv, v2
#     binary, ~/.gitconfig, ~/.bashrc) is restored on a plain restart
#   - never push, never delete user files: a directory that is in the way is
#     reported, not removed
# =============================================================================

# Include guard (tolerates double-sourcing)
[ -n "${_LIB_DBT_LOADED:-}" ] && return 0
_LIB_DBT_LOADED=1
LIB_DBT_VERSION=3

# Install locations — overridable for tests
DBT_V1_VENV="${DBT_V1_VENV:-/opt/dbt-v1}"
DBT_BIN_DIR="${DBT_BIN_DIR:-${HOME:-/home/vscode}/.local/bin}"
DBT_V2_INSTALLER_URL="${DBT_V2_INSTALLER_URL:-https://public.cdn.getdbt.com/fs/install/install.sh}"
DBT_LOG="${DBT_LOG:-/tmp/dbt-workspace.log}"

# The two engine generations: v1 = dbt Core 1.x, v2 = dbt v2. Never add v4
# here: every product would get one (v4 is per product — dbt_versions)
DBT_WORKTREES="v1 v2"

# A product name becomes a directory and a git ref component
DBT_PRODUCT_RE='^[a-z0-9][a-z0-9-]{0,40}$'

# dbt_load_conf [WORKSPACE] — defaults, then the project manifest
dbt_load_conf() {
  DBT_WS="${1:-${WORKSPACE_DIR:-$(pwd)}}"
  DBT_CONF="$DBT_WS/.devcontainer/dbt.conf"
  DBT_PRODUCTS_CONF="$DBT_WS/.devcontainer/products.conf"
  DBT_LOCK_FILE="$DBT_WS/.devcontainer/products.lock"
  DBT_REFERENTS_CONF="$DBT_WS/.devcontainer/referents.conf"
  DBT_FLEET=0
  DBT_UPSTREAM_URL=""
  DBT_UPSTREAM_BRANCH="main"
  DBT_PROJECT_SUBDIR=""
  DBT_UPSTREAM_PUSH_LOCK=1
  DBT_UPSTREAM_HTTPS_TO_SSH=1
  DBT_V1_PINS=""
  DBT_V1_REQUIREMENTS=""
  DBT_V1_FALLBACK_REQUIREMENTS=""
  DBT_V1_PYTHON="3.12"
  DBT_V2_VERSION="latest"
  DBT_BQ_PROJECT=""
  DBT_BQ_DATASET=""
  DBT_BQ_DATASET_PREFIX=""
  DBT_BQ_LOCATION="EU"
  DBT_TARGET_NAME="dev"
  DBT_ALLOW_RUN_OPERATION=0
  DBT_HOOKS_REVIEWED=0
  DBT_HOOKS_COMPILE_OK=""
  DBT_SANDBOX_NEVER_BUILD=""
  DBT_HOOKS_REVIEWED_V2=0
  # fleet: the proof of global-v4's hooks (DBT_HOOKS_COMPILE_OK may name global-v4 only while it holds) — empty: none
  DBT_HOOKS_V4_PROOF=""
  # v4 (fleet): the products that have one, and the dataset prefix of v4/ and global-v4/ — empty: none, refused
  DBT_V4_PRODUCTS=""
  DBT_BQ_DATASET_PREFIX_V4=""
  # fleet with a v4: the real path of its MAIN working copy (dbt_v4_role) — empty: no copy is the main one
  DBT_V4_MAIN_WS=""
  # fleet: the flux of this working copy — read from .devcontainer/flux.conf only (_dbt_flux_read): whatever the
  # environment exported. dbt.conf sets nothing of the flux: a DBT_V4_FLUX* or _DBT_FLUX* variable it sets, adds,
  # changes or unsets — the file's path, the syntax — is an error (_DBT_CONF_FLUX_SET: every dbt command refused), and
  # the file is read at its fixed path. (dbt.conf is sourced: it could redefine any function — these checks catch an
  # accident, not malice.)
  DBT_V4_FLUX=""
  unset DBT_V4_FLUX_FILE DBT_V4_FLUX_ERR
  _dbt_flux_consts
  _DBT_CONF_FLUXSNAP="$(_dbt_flux_vars)"
  # shellcheck disable=SC1090
  [ -f "$DBT_CONF" ] && . "$DBT_CONF"
  _DBT_CONF_FLUX_SET="$(_dbt_flux_changed "$_DBT_CONF_FLUXSNAP")"
  DBT_V4_FLUX_FILE="$DBT_WS/.devcontainer/flux.conf"
  _dbt_flux_read
  # the harmonized line locks its own state (products-h.lock: its v4 lines are v4-h commits), never the ISO line's —
  # set after dbt.conf, which cannot move it back
  if _dbt_is_line_h; then DBT_LOCK_FILE="$DBT_WS/.devcontainer/products-h.lock"; fi
  dbt_use_product "" >/dev/null 2>&1 || true
  return 0
}

dbt_is_fleet() { [ "${DBT_FLEET:-0}" = "1" ]; }

# The v4 space: the v4 worktrees and the v4 assembly (own dataset prefix, own env file profiles/v4.env)
dbt_is_v4() { case "${1:-}" in v4|global-v4) return 0 ;; esac; return 1; }
# The fleet's assembly projects, products as local packages: node names are <package>.<node> there. Every check
# that depends on "several packages" asks this, never `= global` (DBT_SANDBOX_NEVER_BUILD names, collisions).
dbt_is_assembly() { case "${1:-}" in global|global-v4) return 0 ;; esac; return 1; }

# -----------------------------------------------------------------------------
# Products
# -----------------------------------------------------------------------------

# products.conf, one product per line:
#   NAME  URL  [BRANCH]  [SUBDIR]  [GLOBAL]  [HOME]
# ('-' = default, '#' starts a comment). Printed without comments/blank lines.
_dbt_products_lines() {
  [ -f "${DBT_PRODUCTS_CONF:-}" ] || return 0
  sed -e 's/#.*//' -e 's/\r$//' "$DBT_PRODUCTS_CONF" | awk 'NF>=2'
}

# dbt_products — the product names (fleet), or "-" (the single product)
dbt_products() {
  if dbt_is_fleet; then _dbt_products_lines | awk '{print $1}'; else echo "-"; fi
}

# referents.conf (fleet), one referent per line:   NAME  SUBDIR  HOME
# A product BORN HERE: no upstream (no remote up-<name>, no mirror, no v1/v2,
# no global/), a v4 worktree only, whose branch v4 lives in its own repository
# HOME ('-' SUBDIR = auto-detect). Printed without comments/blank lines.
_dbt_referents_lines() {
  dbt_is_fleet && [ -f "${DBT_REFERENTS_CONF:-}" ] || return 0
  sed -e 's/#.*//' -e 's/\r$//' "$DBT_REFERENTS_CONF" | awk 'NF>=3'
}
dbt_referents() { _dbt_referents_lines | awk '{print $1}'; }
# dbt_members — every product, then every referent (once): what the lifecycle loops on
dbt_members() { { dbt_products; dbt_referents; } | awk '!seen[$0]++'; }

# dbt_use_product [NAME] — make NAME the current product. Sets:
#   P_NAME P_URL P_BRANCH P_SUBDIR P_GLOBAL P_REMOTE (upstream remote)
#   P_HOME P_HOME_URL (remote where the branches live) P_HB1 P_HB2 P_HB4 P_MIRROR
#   (branch names THERE)  P_B1 P_B2 P_B4 (local branches)  P_WT1 P_WT2 P_WT4 (worktrees)
#   P_SHOW1 P_SHOW2 P_SHOW4 (display)  P_ENV (env file)  P_TAG (log prefix)
#   P_REFERENT (1 = born here, from referents.conf: no upstream, v4 only)
# Whether the product follows v4: dbt_v4_enabled; the worktrees it follows: dbt_versions.
# In the harmonized line (flux H: _dbt_is_line_h) the v4 branches are the line's own: P_HB4 v4-h (<product>/v4-h on
# origin), P_B4 <product>/v4-h — never the ISO line's v4, which that copy neither follows nor pushes.
dbt_use_product() {
  local N="${1:-}" L URL BR SUB GL HOMEU REST H4=""
  _dbt_is_line_h && H4="-h"
  if ! dbt_is_fleet; then
    P_NAME=""; P_URL="${DBT_UPSTREAM_URL:-}"; P_BRANCH="${DBT_UPSTREAM_BRANCH:-main}"
    P_SUBDIR="${DBT_PROJECT_SUBDIR:-}"; P_GLOBAL=0; P_REFERENT=0
    P_HOME="origin"; P_HOME_URL=""; P_HB1="v1"; P_HB2="v2"; P_HB4="v4"
    P_REMOTE="upstream"; P_MIRROR="upstream-$P_BRANCH"; P_B1="v1"; P_B2="v2"; P_B4="v4"
    P_WT1="$DBT_WS/v1"; P_WT2="$DBT_WS/v2"; P_WT4="$DBT_WS/v4"; P_SHOW1="v1/"; P_SHOW2="v2/"; P_SHOW4="v4/"
    P_ENV="$DBT_WS/profiles/dbt.env"; P_TAG=""
    return 0
  fi
  # no product selected yet: every P_* is defined (callers run under set -u)
  P_NAME=""; P_URL=""; P_BRANCH="main"; P_SUBDIR=""; P_GLOBAL=0; P_REMOTE=""; P_MIRROR=""; P_REFERENT=0
  P_HOME="origin"; P_HOME_URL=""; P_HB1=""; P_HB2=""; P_HB4=""
  P_B1=""; P_B2=""; P_B4=""; P_WT1=""; P_WT2=""; P_WT4=""; P_SHOW1=""; P_SHOW2=""; P_SHOW4=""
  P_ENV="$DBT_WS/profiles/dbt.env"; P_TAG=""
  [ -n "$N" ] && [ "$N" != "-" ] || return 1
  L="$(_dbt_products_lines | awk -v n="$N" '$1==n' | head -1)"
  if [ -z "$L" ]; then
    # a referent, born here: its repository only, and v4 only
    L="$(_dbt_referents_lines | awk -v n="$N" '$1==n' | head -1)"
    [ -n "$L" ] || return 1
    read -r _ SUB HOMEU REST <<< "$L"
    [ "${SUB:-}" = "-" ] && SUB=""
    case "${HOMEU:-}" in ""|-) return 1 ;; esac
    P_NAME="$N"; P_REFERENT=1; P_SUBDIR="${SUB:-}"
    P_HOME="home-$N"; P_HOME_URL="$HOMEU"; P_HB4="v4$H4"; P_B4="$N/v4$H4"; P_WT4="$DBT_WS/v4/$N"; P_SHOW4="v4/$N/"
    if [ -f "$DBT_WS/profiles/env/$N.env" ]; then P_ENV="$DBT_WS/profiles/env/$N.env"; fi
    P_TAG="[$N] "
    return 0
  fi
  read -r _ URL BR SUB GL HOMEU REST <<< "$L"
  [ "${BR:-}" = "-" ] && BR=""
  [ "${SUB:-}" = "-" ] && SUB=""
  [ "${HOMEU:-}" = "-" ] && HOMEU=""
  P_NAME="$N"; P_URL="$URL"; P_BRANCH="${BR:-main}"; P_SUBDIR="${SUB:-}"
  case "${GL:-}" in yes|true|1|global) P_GLOBAL=1 ;; *) P_GLOBAL=0 ;; esac
  P_REMOTE="up-$N"; P_B1="$N/v1"; P_B2="$N/v2"; P_B4="$N/v4$H4"
  if [ -n "${HOMEU:-}" ]; then
    # its own repository (a dbt-project repo): same branch names as there
    P_HOME="home-$N"; P_HOME_URL="$HOMEU"; P_HB1="v1"; P_HB2="v2"; P_HB4="v4$H4"; P_MIRROR="upstream-$P_BRANCH"
  else
    P_HOME="origin"; P_HOME_URL=""; P_HB1="$N/v1"; P_HB2="$N/v2"; P_HB4="$N/v4$H4"; P_MIRROR="$N/upstream"
  fi
  P_WT1="$DBT_WS/v1/$N"; P_WT2="$DBT_WS/v2/$N"; P_SHOW1="v1/$N/"; P_SHOW2="v2/$N/"
  P_WT4="$DBT_WS/v4/$N"; P_SHOW4="v4/$N/"
  if [ -f "$DBT_WS/profiles/env/$N.env" ]; then P_ENV="$DBT_WS/profiles/env/$N.env"; else P_ENV="$DBT_WS/profiles/dbt.env"; fi
  P_TAG="[$N] "
  return 0
}

_dbt_wt()   { case "$1" in v1) printf '%s' "$P_WT1" ;; v2) printf '%s' "$P_WT2" ;; v4) printf '%s' "${P_WT4:-}" ;; esac; }
_dbt_hbr()  { case "$1" in v1) printf '%s' "$P_HB1" ;; v2) printf '%s' "$P_HB2" ;; v4) printf '%s' "${P_HB4:-}" ;; esac; }
_dbt_br()   { case "$1" in v1) printf '%s' "$P_B1" ;; v2) printf '%s' "$P_B2" ;; v4) printf '%s' "${P_B4:-}" ;; esac; }
_dbt_show() { case "$1" in v1) printf '%s' "$P_SHOW1" ;; v2) printf '%s' "$P_SHOW2" ;; v4) printf '%s' "${P_SHOW4:-}" ;; global|global-v4) printf '%s/' "$1" ;; esac; }

# dbt_v4_enabled — the current product follows a v4: a referent, or a product of DBT_V4_PRODUCTS (fleet only)
dbt_v4_enabled() {
  dbt_is_fleet && [ -n "${P_NAME:-}" ] || return 1
  [ "${P_REFERENT:-0}" = 1 ] && return 0
  case " ${DBT_V4_PRODUCTS:-} " in *" $P_NAME "*) return 0 ;; esac
  return 1
}

# dbt_versions — the worktrees the current product follows: v1 v2, plus v4 when enabled; a referent: v4 only.
# Every per-worktree loop walks this list, never "v1 v2 v4" for all: the other products get no v4.
dbt_versions() {
  local VS="$DBT_WORKTREES"
  [ "${P_REFERENT:-0}" = 1 ] && VS=""
  dbt_v4_enabled && VS="${VS:+$VS }v4"
  printf '%s' "$VS"
}

# dbt_just_cmd V — how the user calls the guarded wrapper for V
dbt_just_cmd() {
  if dbt_is_assembly "${1:-}"; then printf 'just %s' "$1"
  elif dbt_is_fleet; then printf 'just %s %s' "$1" "$P_NAME"
  else printf 'just %s' "$1"; fi
}

# -----------------------------------------------------------------------------
# Upstream access
# -----------------------------------------------------------------------------

# git@HOST:path | ssh://[user@]HOST[:port]/path | https://HOST/path -> HOST
_dbt_url_host() {
  local U="${1:-}"
  case "$U" in
    ssh://*|https://*|http://*)
      U="${U#*://}"; U="${U%%/*}"; U="${U##*@}"; U="${U%%:*}" ;;
    *@*:*)
      U="${U#*@}"; U="${U%%:*}" ;;
    *) U="" ;;
  esac
  printf '%s' "$U"
}

_dbt_url_is_ssh() {
  case "${1:-}" in
    ssh://*) return 0 ;;
    http://*|https://*) return 1 ;;
    *@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

_dbt_known_hosts() { printf '%s' "$DBT_WS/.devcontainer/upstream_known_hosts"; }

# The upstream URLs (one per product), then their distinct hosts
_dbt_upstream_urls() {
  if dbt_is_fleet; then _dbt_products_lines | awk '{print $2}'; else printf '%s\n' "${DBT_UPSTREAM_URL:-}"; fi
}

# dbt_git_setup — ~/.gitconfig lives in the container filesystem, so this is
# replayed on every start. One pass per distinct upstream host. ~/.gitconfig is
# the container's, shared by every working copy: a copy that does not own the
# container (_dbt_owns_container: a flux, an orphan) only ADDS the push locks it
# needs, the three layers of verrou 4 included — it never rewrites the HTTPS->SSH
# rewrite nor the rest of core.sshCommand (the main copy's pinned keys), never
# replaces the installed ssh guard, and never lifts a lock: its layer (b) goes by
# the container's state (_dbt_container_https_over_ssh), its layer (a) adds the
# hosts the guard lacks (_dbt_push_lock_ssh_guest).
dbt_git_setup() {
  local KH CUR P U HOST SSH_HOSTS="" ALL_HOSTS="" OWN=1
  _dbt_owns_container || OWN=0
  KH="$(_dbt_known_hosts)"
  while IFS= read -r U; do
    HOST="$(_dbt_url_host "$U")"
    [ -n "$HOST" ] || continue
    case " $ALL_HOSTS " in *" $HOST "*) continue ;; esac
    ALL_HOSTS="$ALL_HOSTS $HOST"
    _dbt_url_is_ssh "$U" && SSH_HOSTS="$SSH_HOSTS $HOST"
  done < <(_dbt_upstream_urls)
  if [ -z "$ALL_HOSTS" ]; then
    if dbt_is_fleet; then echo "  no product in .devcontainer/products.conf — git setup skipped"
    else echo "  no upstream host (DBT_UPSTREAM_URL in dbt.conf) — git setup skipped"; fi
    return 0
  fi

  for HOST in $SSH_HOSTS; do
    # ~/.ssh is mounted read-only: ssh cannot record a host key it has never
    # seen, so upstream keys are pinned in the repository. A missing pin is
    # scanned once (trust on first use) and must then be reviewed + committed.
    if ! ssh-keygen -F "$HOST" -f "$KH" >/dev/null 2>&1 && command -v ssh-keyscan >/dev/null 2>&1; then
      if ssh-keyscan -T 8 -t ed25519,rsa,ecdsa "$HOST" > "$KH.tmp" 2>/dev/null && [ -s "$KH.tmp" ]; then
        cat "$KH.tmp" >> "$KH"; rm -f "$KH.tmp"
        echo "  host keys of $HOST scanned into .devcontainer/upstream_known_hosts (trust on first use):"
        ssh-keygen -lf "$KH" 2>/dev/null | grep -F "$HOST" | sed 's/^/    /'
        echo "  -> CHECK these fingerprints against the server, then commit the file."
      else
        rm -f "$KH.tmp"
        echo "  WARNING: cannot scan the host keys of $HOST (offline? VPN?) — SSH to it will be refused"
      fi
    fi
    # Private dbt packages hosted next to the projects are usually declared
    # over HTTPS (CI authenticates with a job token); locally only the SSH key
    # can read them.
    if [ "$OWN" = 0 ]; then
      :
    elif [ "${DBT_UPSTREAM_HTTPS_TO_SSH:-1}" != "0" ]; then
      git config --global "url.git@$HOST:.insteadOf" "https://$HOST/"
    else
      git config --global --unset-all "url.git@$HOST:.insteadOf" 2>/dev/null || true
    fi
  done
  if [ "$OWN" = 0 ]; then
    echo "  the container's git settings (HTTPS->SSH, the pinned keys of core.sshCommand) are the main copy's (${DBT_V4_MAIN_WS:-?}): left as they are — the push locks are added below, never lifted"
  elif [ -n "$SSH_HOSTS" ] && [ -s "$KH" ]; then
    CUR="$(git config --global --get core.sshCommand 2>/dev/null || true)"
    case "$CUR" in
      *git-ssh-garde.sh*)
        # the ssh push guard (below) carries the pinned file itself, and puts it back alone when unlocked
        echo "  $(echo $SSH_HOSTS) host key pinned (.devcontainer/upstream_known_hosts)" ;;
      ""|*upstream_known_hosts*)
        # pinned file first, ~/.ssh/known_hosts second (GitHub & co keep working)
        git config --global core.sshCommand "ssh -o \"UserKnownHostsFile=$KH $HOME/.ssh/known_hosts\""
        echo "  $(echo $SSH_HOSTS) host key pinned (.devcontainer/upstream_known_hosts)" ;;
      *)
        echo "  NOTE: core.sshCommand is already customised — left as is; add yourself:"
        echo "        -o \"UserKnownHostsFile=$KH $HOME/.ssh/known_hosts\"" ;;
    esac
  fi

  # Push lock (verrou 4), in three layers — pushInsteadOf alone is textual: git+ssh://, ssh://…:22/, no
  # user, another user, upper case, a trailing dot, https://…:443/, http://, any remote with an explicit
  # pushurl (pushInsteadOf ignores it; the https -> ssh rewrite turns it into git@<host>:) and
  # `git send-pack` (it never reads pushInsteadOf) reached the upstream with the user's key.
  #   pushInsteadOf rewrites the push URL of ANY destination on an upstream host to a protocol that
  #     does not exist — `git push <explicit url>` and submodules too, which a remote's pushurl alone
  #     does not see; (c) more prefixes than the three historic ones, kept for `git push` when
  #     GIT_SSH_COMMAND replaces the guard;
  #   (b) no https/http for an upstream host read over ssh: http.<url>.proxy = a dead proxy
  #     (127.0.0.1:9 — urlmatch: any case, :443, any user, a trailing dot; the most specific key wins
  #     whatever the order, so a general http.proxy, a reset of the helpers, a password in the URL or
  #     an http.extraHeader do not get round it), then a credential quitter as a second line — git
  #     stops, no other helper, no prompt;
  #   (a) core.sshCommand = the ssh push guard, copied to ~/.local/libexec/git-ssh-garde.sh (a
  #     checkout of an older commit cannot take it away): no git-receive-pack to an upstream host,
  #     named or reached by address — reads (git-upload-pack) and every other host go through unchanged.
  # Idempotent, replayed on every start. Nothing the user wrote is taken out: a helper or a proxy of their
  # own for an upstream host stays written (inert behind ours), a customised core.sshCommand stays as is.
  for HOST in $ALL_HOSTS; do
    if [ "${DBT_UPSTREAM_PUSH_LOCK:-1}" != "0" ] || [ "$OWN" = 0 ]; then
      while IFS= read -r P; do
        git config --global --get-all url.DISABLED://.pushInsteadOf 2>/dev/null | grep -qxF -- "$P" \
          || git config --global --add url.DISABLED://.pushInsteadOf "$P"
      done < <(_dbt_push_prefixes "$HOST")
      if { [ "$OWN" = 1 ] && _dbt_https_read_over_ssh "$HOST" "$SSH_HOSTS"; } \
         || { [ "$OWN" = 0 ] && _dbt_container_https_over_ssh "$HOST"; }; then
        _dbt_push_lock_proxy 1 "$HOST"; _dbt_push_lock_https 1 "$HOST"
        echo "  push to $HOST LOCKED (pushInsteadOf; https: dead proxy, no credentials)"
      elif [ "$OWN" = 0 ]; then
        # the container reads https://$HOST/ over https (the main copy's choice): its https layer is left as it is —
        # a copy that does not own the container never lifts a lock
        echo "  push to $HOST LOCKED (pushInsteadOf; the container reads it over https: its https layer is the main copy's, left as it is)"
      else
        _dbt_push_lock_proxy 0 "$HOST"; _dbt_push_lock_https 0 "$HOST"
        echo "  push to $HOST LOCKED (pushInsteadOf; read over https: no dead proxy, no https quitter)"
      fi
      [ "${DBT_UPSTREAM_PUSH_LOCK:-1}" != "0" ] \
        || echo "  WARNING: DBT_UPSTREAM_PUSH_LOCK=0 in this copy's dbt.conf — ignored: a copy that does not own the container never lifts a lock"
    else
      # only this host's entries: a lock set by hand for another host stays
      while IFS= read -r P; do
        git config --global --fixed-value --unset-all url.DISABLED://.pushInsteadOf "$P" 2>/dev/null || true
      done < <(_dbt_push_prefixes "$HOST")
      _dbt_push_lock_proxy 0 "$HOST"; _dbt_push_lock_https 0 "$HOST"
      echo "  WARNING: push to $HOST is UNLOCKED (DBT_UPSTREAM_PUSH_LOCK=0 in dbt.conf)"
    fi
  done
  # shellcheck disable=SC2086
  if [ "$OWN" = 0 ]; then _dbt_push_lock_ssh_guest $ALL_HOSTS
  elif [ "${DBT_UPSTREAM_PUSH_LOCK:-1}" != "0" ]; then _dbt_push_lock_ssh 1 $ALL_HOSTS; else _dbt_push_lock_ssh 0 $ALL_HOSTS; fi
  return 0
}

# The push prefixes of an upstream host (url.DISABLED://.pushInsteadOf): the three historic ones, then
# layer (c). Textual, case-sensitive: what they miss, the ssh guard and the https quitter catch.
_dbt_push_prefixes() {
  printf '%s\n' "git@$1:" "ssh://git@$1/" "https://$1/"
  _dbt_push_prefixes_more "$1"
}
_dbt_push_prefixes_more() {
  printf '%s\n' "git+ssh://git@$1/" "ssh+git://git@$1/" "git+ssh://$1/" "ssh+git://$1/" "ssh://git@$1:22/" \
    "ssh://$1/" "ssh://$1:22/" "$1:" "http://$1/" "https://$1:443/"
}

# Is https://HOST/ read over ssh here (the https -> ssh rewrite)? Only then can https carry no credential
# for it: an upstream read over https needs them.
_dbt_https_read_over_ssh() {   # <host> <ssh hosts>
  [ "${DBT_UPSTREAM_HTTPS_TO_SSH:-1}" != "0" ] || return 1
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

# The quitter of an upstream host: answers `get` with quit=1 — git stops there, asks no other helper and
# opens no prompt (no window « Git: https://… »). `store` and `erase` are ignored.
_dbt_https_quitter() {
  printf '%s' '!f() { cat >/dev/null; [ "$1" = get ] || exit 0; echo "verrou 4: no https credentials for '"$1"' here (read over ssh, never pushed to)" >&2; echo quit=1; }; f'
}
_DBT_QUITTER_MARK='verrou 4: no https credentials for '

# Layer (b), first line: http.https://HOST.proxy and http.http://HOST.proxy = a dead proxy — nothing listens
# on 127.0.0.1:9, git fails at once (« Failed to connect to 127.0.0.1 port 9 »), no request leaves, no
# helper is asked. Added last (a value of the user's own stays, inert: the last one of a key wins). An
# exported NO_PROXY / no_proxy covering the host goes round it (`just doctor` says so): the quitter holds.
# Lock 0 removes ours only.
_DBT_DEAD_PROXY="http://127.0.0.1:9"
_dbt_push_lock_proxy() {   # <lock 1|0> <host>
  local LOCK="$1" H="$2" U
  local -a V
  for U in "https://$H" "http://$H"; do
    mapfile -t V < <(git config --global --get-all "http.$U.proxy" 2>/dev/null)
    if [ "$LOCK" = 1 ] && [ "${#V[@]}" -ge 1 ] && [ "${V[${#V[@]}-1]}" = "$_DBT_DEAD_PROXY" ]; then continue; fi
    git config --global --fixed-value --unset-all "http.$U.proxy" "$_DBT_DEAD_PROXY" 2>/dev/null || true
    [ "$LOCK" = 1 ] && git config --global --add "http.$U.proxy" "$_DBT_DEAD_PROXY"
  done
  return 0
}

# Layer (b), second line: credential.https://HOST.helper and credential.http://HOST.helper = "" (forget the
# helpers configured before), then the quitter. Lock 0 removes them (ours only: the quitters, the empty resets).
_dbt_push_lock_https() {   # <lock 1|0> <host>
  local LOCK="$1" H="$2" U Q
  local -a V
  Q="$(_dbt_https_quitter "$H")"
  for U in "https://$H" "http://$H"; do
    mapfile -t V < <(git config --global --get-all "credential.$U.helper" 2>/dev/null)
    if [ "$LOCK" = 1 ] && [ "${#V[@]}" -ge 2 ] && [ -z "${V[${#V[@]}-2]}" ] && [ "${V[${#V[@]}-1]}" = "$Q" ]; then
      continue
    fi
    if [ "$LOCK" = 1 ] || printf '%s\n' "${V[@]}" | grep -qF -- "$_DBT_QUITTER_MARK"; then
      git config --global --unset-all "credential.$U.helper" "$_DBT_QUITTER_MARK" 2>/dev/null || true
      git config --global --unset-all "credential.$U.helper" '^$' 2>/dev/null || true
    fi
    if [ "$LOCK" = 1 ]; then
      git config --global --add "credential.$U.helper" ""
      git config --global --add "credential.$U.helper" "$Q"
    fi
  done
  return 0
}

# The ssh push guard: template-owned in the worktree (.devcontainer/git-ssh-garde.sh), run from its copy
# in the container's home — a `git checkout` of an older commit (just lock-checkout) cannot take it away.
_dbt_ssh_guard_src() { printf '%s' "$DBT_WS/.devcontainer/git-ssh-garde.sh"; }
_dbt_ssh_guard() { printf '%s' "$HOME/.local/libexec/git-ssh-garde.sh"; }
# Put the copy back (only when it differs; atomically: a git running meanwhile sees the old or the new one)
_dbt_ssh_guard_install() {
  local S D
  S="$(_dbt_ssh_guard_src)"; D="$(_dbt_ssh_guard)"
  [ -f "$S" ] || { [ -f "$D" ]; return; }
  cmp -s "$S" "$D" && return 0
  mkdir -p "${D%/*}" && cp "$S" "$D.tmp.$$" && chmod 0755 "$D.tmp.$$" && mv -f "$D.tmp.$$" "$D"
}

# Layer (a): core.sshCommand = bash ~/.local/libexec/git-ssh-garde.sh --hosts=<h1,h2> [-o "UserKnownHostsFile=…"].
# One command for every upstream host: the hosts it already guards stay (like the pushInsteadOf of a
# host no longer declared); lock 0 takes these hosts out, and with none left the pinned keys come back
# alone. A core.sshCommand customised by hand is never overwritten: said, the other layers still hold.
_dbt_push_lock_ssh() {   # <lock 1|0> <host>…
  local LOCK="$1" KH G CUR HAVE="" WANT="" H CMD
  shift
  KH="$(_dbt_known_hosts)"; G="$(_dbt_ssh_guard)"
  if [ "$LOCK" = 1 ] && ! _dbt_ssh_guard_install; then
    echo "  WARNING: the ssh push guard cannot be installed (.devcontainer/git-ssh-garde.sh missing? copier update)"
    echo "           — pushInsteadOf, the dead proxy and the https quitter still hold"
    return 0
  fi
  CUR="$(git config --global --get core.sshCommand 2>/dev/null || true)"
  case "$CUR" in
    *git-ssh-garde.sh*) HAVE="$(printf '%s' "$CUR" | sed -n 's/.*--hosts=\([^ ]*\).*/\1/p' | tr ',' ' ')" ;;
    ""|*upstream_known_hosts*) ;;
    *)
      if [ "$LOCK" = 1 ]; then
        echo "  NOTE: core.sshCommand is customised — the ssh push guard is NOT installed (pushInsteadOf and the"
        echo "        https quitter still hold). To add it, put in front of your command's options:"
        echo "        bash $(printf '%q' "$G") --hosts=$(echo "${*,,}" | tr ' ' ',')"
      fi
      return 0 ;;
  esac
  for H in $HAVE; do
    [ "$LOCK" = 0 ] && case " ${*,,} " in *" $H "*) continue ;; esac
    case " $WANT " in *" $H "*) ;; *) WANT="$WANT $H" ;; esac
  done
  if [ "$LOCK" = 1 ]; then
    for H in "${@,,}"; do case " $WANT " in *" $H "*) ;; *) WANT="$WANT $H" ;; esac; done
  fi
  WANT="${WANT# }"
  if [ -n "$WANT" ]; then
    CMD="bash $(printf '%q' "$G") --hosts=${WANT// /,}"
    [ -s "$KH" ] && CMD="$CMD -o \"UserKnownHostsFile=$KH $HOME/.ssh/known_hosts\""
    [ "$CUR" = "$CMD" ] || git config --global core.sshCommand "$CMD"
    echo "  ssh push guard on $WANT (core.sshCommand = ~/.local/libexec/git-ssh-garde.sh: reads only)"
  elif [ -n "$HAVE" ]; then
    if [ -s "$KH" ]; then git config --global core.sshCommand "ssh -o \"UserKnownHostsFile=$KH $HOME/.ssh/known_hosts\""
    else git config --global --unset-all core.sshCommand 2>/dev/null || true; fi
    echo "  ssh push guard removed (no upstream host locked)"
  fi
  return 0
}

# _dbt_container_https_over_ssh HOST — the container reads https://HOST/ over ssh: its global git settings rewrite it
# (url.git@HOST:.insteadOf, the main copy's DBT_UPSTREAM_HTTPS_TO_SSH). What a copy that does not own the container
# goes by for layer (b): the container's state, never its own dbt.conf.
_dbt_container_https_over_ssh() {
  git config --global --get-all "url.git@$1:.insteadOf" 2>/dev/null | grep -qxF -- "https://$1/"
}

# _dbt_push_lock_ssh_guest HOST… — layer (a) from a copy that does not own the container (a flux, an orphan:
# _dbt_owns_container): ADDED, never lifted nor rewritten. The hosts the guard covers stay; a missing one is added to
# its --hosts=, the rest of the command — the main copy's pinned keys — kept byte for byte. No guard yet: set in front
# of the main copy's pinned keys, never this copy's (core.sshCommand would name a path of a guest). The installed guard
# (~/.local/libexec/git-ssh-garde.sh) is the main copy's: installed from here only when there is none, never replaced.
# DBT_UPSTREAM_PUSH_LOCK=0 in the guest's dbt.conf changes nothing (dbt_git_setup says so).
_dbt_push_lock_ssh_guest() {   # <host>…
  local G Q CUR HAVE="" MISS="" H CMD OLD
  G="$(_dbt_ssh_guard)"; Q="$(printf '%q' "$G")"
  CUR="$(git config --global --get core.sshCommand 2>/dev/null || true)"
  case "$CUR" in
    *git-ssh-garde.sh*) HAVE="$(printf '%s' "$CUR" | sed -n 's/.*--hosts=\([^ ]*\).*/\1/p' | tr ',' ' ')" ;;
    ""|"ssh "*upstream_known_hosts*) ;;
    *)
      echo "  NOTE: core.sshCommand is customised — left as it is (the main copy's: ${DBT_V4_MAIN_WS:-?}); the ssh push"
      echo "        guard is NOT there — pushInsteadOf and the https quitter still hold"
      return 0 ;;
  esac
  for H in "${@,,}"; do case " $HAVE $MISS " in *" $H "*) ;; *) MISS="$MISS $H" ;; esac; done
  MISS="${MISS# }"
  if [ -z "$MISS" ]; then
    echo "  ssh push guard on $(echo $HAVE) — the main copy's core.sshCommand (${DBT_V4_MAIN_WS:-?}), left as it is"
    return 0
  fi
  if [ -n "$HAVE" ]; then
    OLD="$(printf '%s' "$CUR" | sed -n 's/.*\(--hosts=[^ ]*\).*/\1/p')"
    H="$(echo $HAVE $MISS)"
    CMD="${CUR/"$OLD"/--hosts=${H// /,}}"
  else
    CMD="bash $Q --hosts=${MISS// /,}"
    case "$CUR" in "ssh "*) CMD="$CMD ${CUR#ssh }" ;; esac
  fi
  case "$CMD" in
    *"$Q"*)
      if [ ! -f "$G" ] && ! _dbt_ssh_guard_install; then
        echo "  WARNING: the ssh push guard cannot be installed (.devcontainer/git-ssh-garde.sh missing? copier update)"
        echo "           — pushInsteadOf, the dead proxy and the https quitter still hold"
        return 0
      fi ;;
  esac
  git config --global core.sshCommand "$CMD"
  echo "  ssh push guard on $MISS ADDED by this copy (the rest of core.sshCommand is the main copy's: ${DBT_V4_MAIN_WS:-?})"
  return 0
}

# Bounded fetch of the current product's upstream remote. In a hook (no
# terminal) ssh must never prompt nor hang; from a terminal a passphrase
# prompt is fine.
_dbt_fetch_upstream() {
  local KH SSH="ssh -o ConnectTimeout=10"
  KH="$(_dbt_known_hosts)"
  [ -t 0 ] || SSH="$SSH -o BatchMode=yes"
  [ -s "$KH" ] && SSH="$SSH -o \"UserKnownHostsFile=$KH $HOME/.ssh/known_hosts\""
  GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 GIT_SSH_COMMAND="$SSH" \
    timeout 300 git -C "$DBT_WS" fetch --quiet --no-tags "$P_REMOTE" >>"$DBT_LOG" 2>&1
}

# git against a product's own repository. A hook has no credential helper: an
# https://github.com URL gets the workspace token (GITHUB_PERSONAL_ACCESS_TOKEN,
# .env) for this invocation only — never written to .git/config. From a
# terminal, VS Code's credential helper does the same job.
# Bounded (5 min): a hook must never hang on the network.
_dbt_git_home() {
  if [ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
    GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 timeout 300 \
      git -c "url.https://x-access-token:${GITHUB_PERSONAL_ACCESS_TOKEN}@github.com/.insteadOf=https://github.com/" "$@"
  else
    GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 timeout 300 git "$@"
  fi
}

# The workspace token when the caller has none: a hook sourced .env, a
# terminal (`just setup`, `just sync`) may not have. Only that variable is read.
_dbt_load_token() {
  [ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ] && return 0
  [ -f "${DBT_WS:-}/.env" ] || return 0
  GITHUB_PERSONAL_ACCESS_TOKEN="$(sed -n 's/^GITHUB_PERSONAL_ACCESS_TOKEN=//p' "$DBT_WS/.env" | tail -1 | tr -d '"'"'"'')"
  export GITHUB_PERSONAL_ACCESS_TOKEN
}

# Fetch the current product's own repository (no-op for origin: it is the
# clone itself).
_dbt_fetch_home() {
  [ "$P_HOME" != "origin" ] || return 0
  _dbt_git_home -C "$DBT_WS" fetch --quiet --no-tags "$P_HOME" >>"$DBT_LOG" 2>&1
}

# -----------------------------------------------------------------------------
# Worktrees
# -----------------------------------------------------------------------------

# A directory is one of OUR worktrees iff it is the TOPLEVEL of a work tree
# (a plain directory inside the workspace answers with the workspace itself).
_dbt_is_worktree() {
  local P="${1:-}" TOP
  [ -e "$P/.git" ] || return 1
  TOP="$(git -C "$P" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ "$TOP" = "$(cd "$P" 2>/dev/null && pwd -P)" ]
}

_dbt_has_ref() { git -C "$DBT_WS" show-ref --verify --quiet "$1"; }

# Where the upstream branch can be read from, without the network if possible:
# the upstream remote, else its mirror where the product's branches live.
_dbt_upstream_base() {
  local BR="$P_BRANCH"
  if ! _dbt_has_ref "refs/remotes/$P_REMOTE/$BR" && ! _dbt_has_ref "refs/remotes/$P_HOME/$P_MIRROR"; then
    if git -C "$DBT_WS" remote get-url "$P_REMOTE" >/dev/null 2>&1; then
      echo "  ${P_TAG}fetching $P_REMOTE ($BR)..." >&2
      _dbt_fetch_upstream || echo "  ${P_TAG}WARNING: upstream fetch failed (details: $DBT_LOG)" >&2
    fi
  fi
  if _dbt_has_ref "refs/remotes/$P_REMOTE/$BR"; then
    printf '%s' "$P_REMOTE/$BR"
  elif _dbt_has_ref "refs/remotes/$P_HOME/$P_MIRROR"; then
    printf '%s' "$P_HOME/$P_MIRROR"
  else
    return 1
  fi
}

# _dbt_ensure_branch V — the local branch exists: from where the product's
# branches live when they were already published (origin, or the product's
# own repository), else v1 from the upstream branch and v2 from v1. A v4 is
# only ever TRACKED: it is opened there, from the published v2 (a referent's,
# when its repository is created), never created here.
_dbt_ensure_branch() {
  local V="$1" B HB BASE
  B="$(_dbt_br "$V")"; HB="$(_dbt_hbr "$V")"
  _dbt_has_ref "refs/heads/$B" && return 0
  if [ "$P_HOME" != "origin" ] && ! _dbt_has_ref "refs/remotes/$P_HOME/$HB"; then
    _dbt_fetch_home || echo "  ${P_TAG}WARNING: cannot fetch $P_HOME_URL (token? network?) — retried at the next start"
  fi
  if _dbt_has_ref "refs/remotes/$P_HOME/$HB"; then
    git -C "$DBT_WS" branch --quiet --track "$B" "$P_HOME/$HB" >>"$DBT_LOG" 2>&1 \
      && echo "  ${P_TAG}branch $B <- $P_HOME/$HB" && return 0
  fi
  if [ "$V" = "v4" ]; then
    if _dbt_is_line_h; then
      # the harmonized line's branch is opened where the product's branches live, from the published v4 (the ISO
      # line's) — never created here, from anything
      echo "  ${P_TAG}$(_dbt_show v4): the harmonized line's $HB is not opened yet in ${P_HOME_URL:-origin} — it starts from the published v4:"
      echo "           git push $P_HOME $P_HOME/${HB%-h}:refs/heads/$HB, then: just setup"
    elif [ "${P_REFERENT:-0}" = 1 ]; then
      echo "  ${P_TAG}WARNING: $P_HOME/$HB not found — a referent's v4 lives in $P_HOME_URL only (pushed? token? network?)"
    else
      echo "  ${P_TAG}$(_dbt_show v4): not opened yet — a v4 starts from the published v2:"
      echo "           git push $P_HOME $P_HOME/$P_HB2:refs/heads/$HB, then: just setup"
    fi
    return 1
  fi
  if [ "$V" != "v1" ] && _dbt_has_ref "refs/heads/$P_B1"; then
    BASE="$P_B1"
  else
    BASE="$(_dbt_upstream_base)" || {
      echo "  ${P_TAG}WARNING: no source for branch $B: neither $P_HOME/$HB nor the upstream branch is reachable."
      echo "           Check the VPN / SSH key, then run: just setup"
      return 1
    }
  fi
  git -C "$DBT_WS" branch --quiet --no-track "$B" "$BASE" >>"$DBT_LOG" 2>&1 \
    && echo "  ${P_TAG}branch $B created from $BASE" || return 1
}

# dbt_ensure_worktrees — the worktrees of the CURRENT product (dbt_versions)
dbt_ensure_worktrees() {
  local WS="$DBT_WS" V P B REC SHOW
  if ! git -C "$WS" rev-parse --git-dir >/dev/null 2>&1; then
    echo "  $WS is not a git repository — worktrees skipped"
    return 0
  fi

  # The upstream remote: fetch-only, no tags (they would land in this
  # repository's own tag namespace).
  if [ -n "${P_URL:-}" ]; then
    if git -C "$WS" remote get-url "$P_REMOTE" >/dev/null 2>&1; then
      git -C "$WS" remote set-url "$P_REMOTE" "$P_URL"
    else
      git -C "$WS" remote add "$P_REMOTE" "$P_URL"
    fi
    git -C "$WS" config "remote.$P_REMOTE.tagOpt" --no-tags
    # a copy that does not own the container (a flux, an orphan) never lifts a lock, not even its own remote's
    if [ "${DBT_UPSTREAM_PUSH_LOCK:-1}" != "0" ] || ! _dbt_owns_container; then
      git -C "$WS" config "remote.$P_REMOTE.pushurl" DISABLED
    else
      git -C "$WS" config --unset-all "remote.$P_REMOTE.pushurl" 2>/dev/null || true
    fi
  fi

  # The product's own repository: where its branches are fetched from and
  # pushed to (the coordinator model). Tags would mix several products.
  if [ "$P_HOME" != "origin" ] && [ -n "$P_HOME_URL" ]; then
    if git -C "$WS" remote get-url "$P_HOME" >/dev/null 2>&1; then
      git -C "$WS" remote set-url "$P_HOME" "$P_HOME_URL"
    else
      git -C "$WS" remote add "$P_HOME" "$P_HOME_URL"
    fi
    git -C "$WS" config "remote.$P_HOME.tagOpt" --no-tags
  fi

  for V in $(dbt_versions); do
    P="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"; SHOW="$(_dbt_show "$V")"
    # Same trust as the workspace folder (onCreateCommand registers only that
    # one): a bind mount owned by another uid would otherwise be refused.
    # Added, never removed: the one global git setting a copy that does not own
    # the container (a flux) writes too — it names its own worktrees only.
    git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$P" \
      || git config --global --add safe.directory "$P"
    # The links between a worktree and the repository are absolute paths:
    # they break when the workspace folder is renamed. repair rewrites both
    # directions and is a no-op when they are right.
    [ -e "$P/.git" ] && git -C "$WS" worktree repair "$P" >>"$DBT_LOG" 2>&1

    if _dbt_is_worktree "$P"; then
      echo "  ${SHOW} on branch $(git -C "$P" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      # the harmonized line: a v4 copy on any other branch than its own is refused (never switched for you)
      [ "$V" != v4 ] || dbt_v4_line_h_branch_problem | while IFS= read -r X; do
        echo "  WARNING: ${P_TAG}$X — its dbt commands are refused until then"; done
    else
      if [ -e "$P" ] && [ -n "$(ls -A "$P" 2>/dev/null)" ]; then
        echo "  WARNING: ${SHOW} exists but is not a worktree of this repository."
        echo "           Move it away (nothing is deleted for you), then run: just setup"
        continue
      fi
      _dbt_ensure_branch "$V" || continue
      # A record left by a worktree whose directory is gone (deleted by hand)
      # blocks the branch: locked records are not pruned, so release it first.
      REC="$(git -C "$WS" worktree list --porcelain 2>/dev/null \
        | awk -v b="refs/heads/$B" '$1=="worktree"{p=substr($0,10)} $1=="branch"&&$2==b{print p}')"
      if [ -n "$REC" ] && [ ! -d "$REC" ]; then
        git -C "$WS" worktree unlock "$REC" >>"$DBT_LOG" 2>&1 || true
        git -C "$WS" worktree prune >>"$DBT_LOG" 2>&1 || true
      fi
      mkdir -p "$(dirname "$P")"
      if git -C "$WS" worktree add "$P" "$B" >>"$DBT_LOG" 2>&1; then
        echo "  ${SHOW} created on branch $B"
      else
        echo "  ERROR: git worktree add ${SHOW} failed (details: $DBT_LOG)"
        continue
      fi
    fi
    # The container path of a worktree does not exist on the host: without a
    # lock, a `git worktree prune` (or an automatic gc) run on the host side
    # would drop its administrative files.
    git -C "$WS" worktree lock --reason "devcontainer path, not visible from the host: never prune" "$P" >/dev/null 2>&1 || true
  done
  return 0
}

# dbt_sync — bring the current product's worktrees up to date with where its
# branches live: fetch, then fast-forward each CLEAN worktree that is only
# behind. A dirty, ahead or diverged worktree is reported, never touched.
dbt_sync() {
  local V W B U AHEAD BEHIND OLD
  if [ "$P_HOME" != "origin" ]; then
    _dbt_fetch_home || { echo "  ${P_TAG}WARNING: cannot fetch $P_HOME ($P_HOME_URL) — not synced"; return 0; }
  else
    _dbt_git_home -C "$DBT_WS" fetch --quiet --no-tags origin >>"$DBT_LOG" 2>&1 \
      || { echo "  ${P_TAG}WARNING: cannot fetch origin — not synced"; return 0; }
  fi
  for V in $(dbt_versions); do
    W="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"; U="$P_HOME/$(_dbt_hbr "$V")"
    _dbt_is_worktree "$W" || continue
    # the harmonized line moves a worktree on its own branch only: fast-forwarded to $U, a copy on the ISO line's
    # branch (or detached, after lock-checkout) would carry the harmonized line's commits there
    if _dbt_is_line_h && [ "$(git -C "$W" symbolic-ref -q --short HEAD 2>/dev/null)" != "$B" ]; then
      echo "  ${P_TAG}$(_dbt_show "$V"): not on $B ($(git -C "$W" symbolic-ref -q --short HEAD 2>/dev/null || echo detached)) — NOT synced (the harmonized line moves its own branches only): git -C $(_dbt_show "$V") checkout $B, or just lock-release"
      continue
    fi
    if ! _dbt_has_ref "refs/remotes/$U"; then echo "  ${P_TAG}$B: not published yet ($U missing)"; continue; fi
    read -r AHEAD BEHIND <<< "$(git -C "$DBT_WS" rev-list --left-right --count "$B...$U" 2>/dev/null)"
    if [ "${AHEAD:-0}" = 0 ] && [ "${BEHIND:-0}" = 0 ]; then
      echo "  ${P_TAG}$B: up to date with $U"
    elif [ "${AHEAD:-0}" = 0 ]; then
      if [ -n "$(git -C "$W" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        echo "  ${P_TAG}$B: $BEHIND new commit(s) on $U, NOT applied: uncommitted changes in $(_dbt_show "$V")"
      elif OLD="$(git -C "$W" rev-parse --short HEAD)" \
           && git -C "$W" merge --ff-only --quiet "$U" >>"$DBT_LOG" 2>&1; then
        echo "  ${P_TAG}$B: fast-forwarded $BEHIND commit(s) from $U"
        # what came in: the product's history is how its own sessions speak
        git -C "$W" log --format='      %h %s' -n 8 "$OLD..HEAD" 2>/dev/null | cut -c1-120
        if [ "$BEHIND" -gt 8 ]; then echo "      … all $BEHIND: git -C $(_dbt_show "$V") log $OLD.."; fi
      else
        echo "  ${P_TAG}$B: fast-forward from $U failed (details: $DBT_LOG)"
      fi
    elif [ "${BEHIND:-0}" = 0 ]; then
      echo "  ${P_TAG}$B: $AHEAD local commit(s) not pushed — git -C $(_dbt_show "$V") push"
    else
      echo "  ${P_TAG}$B: DIVERGED from $U ($AHEAD local, $BEHIND there) — merge or rebase by hand"
    fi
  done
  # branches of the product's own repository that this workspace does not
  # follow (a v3 started there, for instance): say it, a structural change
  if [ "$P_HOME" != "origin" ]; then
    local OTHER EX="HEAD|main|master|upstream-.*" VV
    for VV in $(dbt_versions); do EX="$EX|$(_dbt_hbr "$VV")"; done
    # the harmonized line knows the ISO line's v4 (its v4-h starts there): not a structural change to report
    if _dbt_is_line_h && dbt_v4_enabled; then EX="$EX|${P_HB4%-h}"; fi
    OTHER="$(git -C "$DBT_WS" for-each-ref --format='%(refname:lstrip=3)' "refs/remotes/$P_HOME/" 2>/dev/null \
      | grep -v -x -E "$EX" | paste -sd' ' -)"
    [ -z "$OTHER" ] || echo "  ${P_TAG}NOTE: branches in $P_HOME not followed here: $OTHER"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Fleet lock — .devcontainer/products.lock
# -----------------------------------------------------------------------------
# The exact commit of every product's v1 and v2, as last locked (`just lock`).
# Committed with the change of global/ it goes with, it tells which product
# versions each state of global/ was validated with — the one thing submodules
# would record, without their bookkeeping. Lines: PRODUCT VERSION COMMIT SOURCE

# _dbt_lock_get PRODUCT VERSION — the locked commit, or nothing
_dbt_lock_get() {
  [ -f "${DBT_LOCK_FILE:-}" ] || return 0
  awk -v p="$1" -v v="$2" '$1==p && $2==v {print $3; exit}' "$DBT_LOCK_FILE"
}

# dbt_lock_status V — one word for the current product's worktree V against
# the lock, then the details:
#   nolock | unlocked | same | ahead N | behind N | diverged | unknown | missing
dbt_lock_status() {
  local V="$1" W B L C AH BE
  [ -f "${DBT_LOCK_FILE:-}" ] || { echo "nolock"; return 0; }
  W="$(_dbt_wt "$V")"; B="$(_dbt_br "$V")"
  _dbt_is_worktree "$W" || { echo "missing"; return 0; }
  L="$(_dbt_lock_get "$P_NAME" "$V")"
  [ -n "$L" ] || { echo "unlocked"; return 0; }
  git -C "$DBT_WS" cat-file -e "$L^{commit}" 2>/dev/null || { echo "unknown $L"; return 0; }
  C="$(git -C "$W" rev-parse HEAD 2>/dev/null)"
  [ "$C" = "$L" ] && { echo "same $L"; return 0; }
  read -r AH BE <<< "$(git -C "$DBT_WS" rev-list --left-right --count "$C...$L" 2>/dev/null)"
  if [ "${BE:-0}" = 0 ]; then echo "ahead ${AH:-?} $L"
  elif [ "${AH:-0}" = 0 ]; then echo "behind ${BE:-?} $L"
  else echo "diverged $L"; fi
}

# dbt_lock_describe V — the same, as a sentence
dbt_lock_describe() {
  local ST N L
  read -r ST N L <<< "$(dbt_lock_status "$1")"
  case "$ST" in
    nolock)   echo "no products.lock yet" ;;
    missing)  echo "no worktree" ;;
    unlocked) echo "not in products.lock — just lock" ;;
    unknown)  echo "locked at ${N:0:9}, a commit not fetched here — just sync" ;;
    same)     echo "= lock (${N:0:9})" ;;
    ahead)    echo "$N commit(s) since the lock (${L:0:9}) — just lock once global/ is validated" ;;
    behind)   echo "$N commit(s) BEHIND the lock (${L:0:9}) — just sync" ;;
    diverged) echo "DIVERGED from the lock (${N:0:9}) — the locked commit is not in this history" ;;
  esac
}

# dbt_project_dir V — the directory that holds dbt_project.yml: worktree V of
# the current product, or one of the fleet's assembly projects (V = global,
# global-v4)
dbt_project_dir() {
  local ROOT SUB="${P_SUBDIR:-}" FOUND
  if dbt_is_assembly "${1:-}"; then
    [ -f "$DBT_WS/$1/dbt_project.yml" ] && printf '%s' "$DBT_WS/$1" && return 0
    return 1
  fi
  ROOT="$(_dbt_wt "${1:-}")"
  [ -n "$ROOT" ] && [ -d "$ROOT" ] || return 1
  if [ -z "$SUB" ]; then
    # auto-detect: the single dbt_project.yml that is not an installed package
    FOUND="$(cd "$ROOT" && find . -name dbt_project.yml \
      -not -path '*/dbt_packages/*' -not -path '*/dbt_modules/*' \
      -not -path '*/target/*' -not -path '*/.venv/*' -not -path '*/node_modules/*' 2>/dev/null)"
    [ -n "$FOUND" ] && [ "$(printf '%s\n' "$FOUND" | wc -l)" -eq 1 ] || return 1
    SUB="$(dirname "${FOUND#./}")"
  fi
  if [ "$SUB" = "." ]; then printf '%s' "$ROOT"; else printf '%s' "$ROOT/$SUB"; fi
  [ -f "$ROOT/$SUB/dbt_project.yml" ]
}

# The `profile:` a project asks for (dbt_project.yml)
_dbt_profile_name() {
  sed -nE "s/^profile:[[:space:]]*['\"]?([^'\"#[:space:]]+).*/\1/p" "${1:-}/dbt_project.yml" 2>/dev/null | head -1
}

# The dbt-core version a project pins (pyproject.toml / requirements.txt)
_dbt_project_core_pin() {
  local F
  for F in "${1:-}/pyproject.toml" "${1:-}/requirements.txt"; do
    [ -f "$F" ] || continue
    sed -nE 's/.*dbt-core[[:space:]]*[=~]=[[:space:]]*([0-9][0-9.]*).*/\1/p' "$F" | head -1 && return 0
  done
}

# -----------------------------------------------------------------------------
# Engines
# -----------------------------------------------------------------------------

dbt_engine() {
  case "${1:-}" in
    v1) printf '%s' "$DBT_V1_VENV/bin/dbt" ;;
    v2|v4|global|global-v4) printf '%s' "$DBT_BIN_DIR/dbt" ;;
    *) return 1 ;;
  esac
}

# Create DIR owned by the current user, using sudo only when the parent is
# not writable (/opt is root-owned in the devcontainer; test dirs are not).
_dbt_provision_dir() {
  local DIR="$1"
  [ -d "$DIR" ] && [ -w "$DIR" ] && return 0
  if [ -w "$(dirname "$DIR")" ]; then
    install -d "$DIR"
  elif sudo -n true 2>/dev/null; then
    sudo install -d -o "$(id -un)" -g "$(id -gn)" "$DIR"
  else
    return 1
  fi
}

# Read from the package metadata: `dbt --version` of dbt Core takes seconds
# and calls PyPI.
_dbt_v1_version() {
  local META
  META="$(ls -d "$DBT_V1_VENV"/lib/python*/site-packages/dbt_core-*.dist-info 2>/dev/null | tail -1)"
  [ -n "$META" ] || return 1
  META="${META##*/dbt_core-}"
  printf '%s' "${META%.dist-info}"
}

# The file that pins the project's dbt version, relative to the v1 worktree
# (single product only: a fleet shares DBT_V1_PINS)
_dbt_v1_requirements() {
  local PROJ F
  dbt_is_fleet && return 0
  if [ -n "${DBT_V1_REQUIREMENTS:-}" ]; then
    [ -f "$P_WT1/$DBT_V1_REQUIREMENTS" ] && printf '%s' "$P_WT1/$DBT_V1_REQUIREMENTS"
    return 0
  fi
  PROJ="$(dbt_project_dir v1)" || return 0
  for F in "$PROJ/pyproject.toml" "$PROJ/requirements.txt" "$P_WT1/requirements.txt"; do
    if [ -f "$F" ] && grep -q "dbt" "$F"; then printf '%s' "$F"; return 0; fi
  done
  return 0
}

# dbt Core 1.x, isolated in its own venv — at DBT_V1_PINS when set (a fleet
# shares one version), else at the versions the project pins. The venv lives
# in the container filesystem (fast, and gone at each rebuild: rebuilt here);
# it is also rebuilt when the pins change.
dbt_ensure_v1_venv() {
  local REQ="" SUM STAMP="$DBT_V1_VENV/.dbt-pins" PY TRIED="" TMP OK=0 LOG="/tmp/dbt-v1-venv.log" FROM
  if [ -n "${DBT_V1_PINS:-}" ]; then
    SUM="pins:$DBT_V1_PINS"; FROM="DBT_V1_PINS"
  elif dbt_is_fleet; then
    echo "  WARNING: DBT_V1_PINS is empty in dbt.conf: a fleet shares ONE dbt Core version for"
    echo "           every v1, e.g. DBT_V1_PINS=\"dbt-core==1.11.11 dbt-bigquery==1.11.1\", then: just setup"
    return 0
  else
    if [ ! -d "$P_WT1" ]; then
      echo "  ${P_SHOW1%/}/ is not there yet — dbt Core venv skipped"
      return 0
    fi
    REQ="$(_dbt_v1_requirements)"
    if [ -n "$REQ" ]; then
      SUM="$(sha256sum "$REQ" 2>/dev/null | cut -d' ' -f1)"; FROM="${REQ#"$DBT_WS"/}"
    elif [ -n "${DBT_V1_FALLBACK_REQUIREMENTS:-}" ]; then
      SUM="fallback:$DBT_V1_FALLBACK_REQUIREMENTS"; FROM="DBT_V1_FALLBACK_REQUIREMENTS"
    else
      echo "  WARNING: no dbt version to install: the project pins none (no pyproject.toml /"
      echo "           requirements.txt mentioning dbt) and DBT_V1_PINS is empty. Set one in"
      echo "           dbt.conf, e.g. DBT_V1_PINS=\"dbt-core==1.11.11 dbt-bigquery==1.11.1\", then: just setup"
      return 0
    fi
  fi

  if [ -x "$DBT_V1_VENV/bin/python" ] && [ -x "$DBT_V1_VENV/bin/dbt" ] \
     && [ "$(cat "$STAMP" 2>/dev/null)" = "$SUM" ]; then
    echo "  dbt Core $(_dbt_v1_version || echo '?') ($DBT_V1_VENV)"
  else
    if ! command -v uv >/dev/null 2>&1; then
      echo "  WARNING: uv not found — cannot build the dbt Core venv"
      return 0
    fi
    if ! _dbt_provision_dir "$DBT_V1_VENV"; then
      echo "  ERROR: cannot create $DBT_V1_VENV (passwordless sudo unavailable?)"
      return 0
    fi
    # the rebuild below empties the directory: only ever a venv of ours
    if [ -n "$(ls -A "$DBT_V1_VENV" 2>/dev/null)" ] && [ ! -f "$DBT_V1_VENV/pyvenv.cfg" ]; then
      echo "  ERROR: $DBT_V1_VENV is not empty and is not a virtualenv — refusing to rebuild into it"
      return 0
    fi
    TMP="$(mktemp -d)"
    : > "$LOG"
    # Interpreter fallbacks, newest first: older dbt releases do not resolve
    # on a recent Python (1.8/1.9 on 3.12, pre-1.0 beyond 3.9).
    for PY in "${DBT_V1_PYTHON:-3.12}" 3.11 3.9; do
      case " $TRIED " in *" $PY "*) continue ;; esac
      TRIED="$TRIED $PY"
      find "$DBT_V1_VENV" -mindepth 1 -delete 2>/dev/null
      uv venv --quiet --python "$PY" "$DBT_V1_VENV" >>"$LOG" 2>&1 || continue
      if [ -n "${DBT_V1_PINS:-}" ]; then
        # shellcheck disable=SC2086
        uv pip install --quiet --python "$DBT_V1_VENV/bin/python" $DBT_V1_PINS >>"$LOG" 2>&1 || continue
      elif [ -n "$REQ" ]; then
        # Install from an isolated COPY: uv walks up from the file and parses
        # every parent pyproject.toml, so an unrelated broken one above the
        # project would fail an otherwise valid install.
        cp "$REQ" "$TMP/$(basename "$REQ")"
        uv pip install --quiet --python "$DBT_V1_VENV/bin/python" -r "$TMP/$(basename "$REQ")" >>"$LOG" 2>&1 || continue
      else
        # shellcheck disable=SC2086
        uv pip install --quiet --python "$DBT_V1_VENV/bin/python" $DBT_V1_FALLBACK_REQUIREMENTS >>"$LOG" 2>&1 || continue
      fi
      if [ -x "$DBT_V1_VENV/bin/dbt" ]; then OK=1; break; fi
    done
    rm -rf "$TMP"
    if [ "$OK" != 1 ]; then
      echo "  ERROR: dbt Core venv could not be built (details: $LOG)"
      tail -n 4 "$LOG" 2>/dev/null | sed 's/^/    | /'
      return 0
    fi
    # `uv venv` installs no setuptools, and dbt < 1.9 still imports
    # pkg_resources (dropped by setuptools >= 81) or distutils (gone in 3.12).
    if "$DBT_V1_VENV/bin/dbt" --version 2>&1 | grep -Eq "No module named '(pkg_resources|distutils)'"; then
      uv pip install --quiet --python "$DBT_V1_VENV/bin/python" "setuptools<80" >>"$LOG" 2>&1 \
        && echo "  setuptools<80 added (old dbt: pkg_resources/distutils)"
    fi
    printf '%s' "$SUM" > "$STAMP"
    echo "  dbt Core $(_dbt_v1_version || echo '?') installed in $DBT_V1_VENV (python $PY, pins: $FROM)"
  fi

  mkdir -p "$DBT_BIN_DIR"
  ln -sf "$DBT_V1_VENV/bin/dbt" "$DBT_BIN_DIR/dbt1"
  return 0
}

# dbt v2. It must sit at ~/.local/bin/dbt: that is where the official
# installer puts it and the only place the dbt VS Code extension looks
# without a dbt.dbtPath override. Installed once per container build, never
# upgraded behind the user's back.
dbt_ensure_v2() {
  local BIN="$DBT_BIN_DIR/dbt" VER LOG="/tmp/dbt-v2-install.log"
  if [ -x "$BIN" ]; then
    VER="$("$BIN" --version 2>/dev/null | head -1)"
    case "$VER" in
      "dbt 2."*|"dbt-fusion 2."*) echo "  $VER ($BIN)" ;;
      *)
        echo "  WARNING: $BIN is not dbt v2 ('${VER:-no answer}') — left untouched."
        echo "           dbt v2 must own this path; remove that binary, then run: just setup"
        return 0 ;;
    esac
  else
    command -v curl >/dev/null 2>&1 || { echo "  WARNING: curl not found — cannot install dbt v2"; return 0; }
    mkdir -p "$DBT_BIN_DIR"
    if curl -fsSL "$DBT_V2_INSTALLER_URL" 2>>"$LOG" \
         | sh -s -- --update --to "$DBT_BIN_DIR" ${DBT_V2_VERSION:+--version "$DBT_V2_VERSION"} >>"$LOG" 2>&1 \
       && [ -x "$BIN" ]; then
      echo "  $("$BIN" --version 2>/dev/null | head -1) installed ($BIN)"
    else
      echo "  ERROR: dbt v2 install failed (details: $LOG) — retried at the next start"
      tail -n 3 "$LOG" 2>/dev/null | sed 's/^/    | /'
      return 0
    fi
  fi
  # `dbtf` as a real command (the installer only adds a shell alias, which
  # scripts, just recipes and non-interactive shells do not see)
  ln -sf dbt "$DBT_BIN_DIR/dbtf"
  return 0
}

# -----------------------------------------------------------------------------
# Profile hub
# -----------------------------------------------------------------------------

_dbt_hub_header() {
  cat <<EOF
# =============================================================================
# dbt profile hub — the ONLY profiles dbt reads in this container.
# DBT_PROFILES_DIR points here for every process; the profiles.yml files
# shipped inside the worktrees (they target the real projects) are never used.
# A profile that is not declared here is an error, not a fallback.
#
# No secret in this file: \`method: oauth\` uses the gcloud ADC
# (\`just gcp-login\`). PROJECT-OWNED: seeded from .devcontainer/dbt.conf,
# then yours — edit it and commit it.
#
# The target NAME is what the projects' macros see (target.name); the
# project and dataset below are where dbt actually runs and writes.
# =============================================================================
EOF
}

_dbt_hub_profile() {
  cat <<EOF

$1:
  target: ${DBT_TARGET_NAME:-dev}
  outputs:
    ${DBT_TARGET_NAME:-dev}:
      type: bigquery
      method: oauth
      project: $DBT_BQ_PROJECT
      dataset: $DBT_BQ_DATASET
      location: ${DBT_BQ_LOCATION:-EU}
      threads: 4
      priority: interactive
      job_execution_timeout_seconds: 1800
      maximum_bytes_billed: 42949672960   # 40 GiB — does NOT cap DDL
EOF
}

_dbt_hub_has() { grep -Eq "^['\"]?$2['\"]?:" "$1" 2>/dev/null; }

# Single product: profiles/profiles.yml is seeded once, never rewritten.
# Fleet: every profile a product (or global/) asks for is APPENDED when
# missing — ingesting a product must not need a hand edit — and nothing that
# is already there is touched.
dbt_ensure_profiles() {
  local DIR="$DBT_WS/profiles" FILE="$DBT_WS/profiles/profiles.yml" PROJ NAME="" N V NAMES="" ADDED=""
  mkdir -p "$DIR"
  if ! dbt_is_fleet; then
    PROJ="$(dbt_project_dir v1)" && NAME="$(_dbt_profile_name "$PROJ")"
    if [ -f "$FILE" ]; then
      if [ -n "$NAME" ] && ! _dbt_hub_has "$FILE" "$NAME"; then
        echo "  WARNING: profile '$NAME' (asked by dbt_project.yml) is not in profiles/profiles.yml:"
        echo "           dbt will refuse to run until it is declared there (fail-closed)."
      else
        echo "  hub profiles/profiles.yml${NAME:+ (profile '$NAME')}"
      fi
      return 0
    fi
    if [ -z "$NAME" ]; then
      echo "  profile name unknown (no dbt_project.yml in v1/ yet) — hub not seeded"
      return 0
    fi
    NAMES="$NAME"
  else
    for N in $(dbt_members); do
      dbt_use_product "$N" || continue
      # the first worktree that holds a project: v1, else v2 — a referent's v4
      PROJ=""
      for V in $(dbt_versions); do PROJ="$(dbt_project_dir "$V")" && break; PROJ=""; done
      [ -n "$PROJ" ] || continue
      NAME="$(_dbt_profile_name "$PROJ")"
      [ -n "$NAME" ] && case " $NAMES " in *" $NAME "*) ;; *) NAMES="$NAMES $NAME" ;; esac
    done
    for V in global global-v4; do
      PROJ="$(dbt_project_dir "$V")" && NAME="$(_dbt_profile_name "$PROJ")" \
        && [ -n "$NAME" ] && case " $NAMES " in *" $NAME "*) ;; *) NAMES="$NAMES $NAME" ;; esac
    done
    NAMES="$(echo $NAMES)"
    if [ -z "$NAMES" ]; then
      echo "  no project yet — hub not seeded"
      return 0
    fi
    if [ -f "$FILE" ]; then
      NAME=""
      for N in $NAMES; do _dbt_hub_has "$FILE" "$N" || NAME="$NAME $N"; done
      if [ -z "$NAME" ]; then echo "  hub profiles/profiles.yml (profiles: $NAMES)"; return 0; fi
      NAMES="$(echo $NAME)"
    fi
  fi
  if [ -z "${DBT_BQ_PROJECT:-}" ] || [ -z "${DBT_BQ_DATASET:-}" ]; then
    echo "  DBT_BQ_PROJECT / DBT_BQ_DATASET are empty in dbt.conf: no profile generated."
    echo "  dbt stays LOCKED (fail-closed) until profiles/profiles.yml declares '$NAMES'."
    return 0
  fi
  if [ ! -f "$FILE" ]; then
    _dbt_hub_header > "$FILE"
    for N in $NAMES; do _dbt_hub_profile "$N" >> "$FILE"; done
    echo "  hub seeded: profiles/profiles.yml (profile$( [ "$(echo $NAMES | wc -w)" -gt 1 ] && echo s) '$(echo $NAMES | sed "s/ /', '/g")' -> $DBT_BQ_PROJECT.$DBT_BQ_DATASET) — review and commit it"
  else
    for N in $NAMES; do _dbt_hub_profile "$N" >> "$FILE"; ADDED="$ADDED $N"; done
    echo "  hub: profile(s)$ADDED appended to profiles/profiles.yml ($DBT_BQ_PROJECT.$DBT_BQ_DATASET) — review and commit it"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Fleet: the global project
# -----------------------------------------------------------------------------

DBT_GLOBAL_BEGIN="  # >>> products (managed by .devcontainer/lib-dbt.sh from products.conf — edit products.conf, not this block) >>>"
DBT_GLOBAL_END="  # <<< products <<<"

# dbt_ensure_global — rewrite the managed block of global/packages.yml: one
# `local:` package per product flagged GLOBAL in products.conf whose v2
# project exists. dbt v2 installs local packages as symlinks, so global/ sees
# every edit made in v2/<product>/ at once.
dbt_ensure_global() {
  # not LINES: bash rewrites $LINES with the terminal height on a window resize (SIGWINCH) — during post-start the
  # managed block became "21  # <<< products <<<"
  local F="$DBT_WS/global/packages.yml" N PROJ TMP BLOC="" COUNT=0
  dbt_is_fleet || return 0
  [ -f "$DBT_WS/global/dbt_project.yml" ] || { echo "  no global/ project — skipped"; return 0; }
  for N in $(dbt_products); do
    dbt_use_product "$N" || continue
    [ "$P_GLOBAL" = 1 ] || continue
    if PROJ="$(dbt_project_dir v2)"; then
      BLOC="$BLOC  - local: ../${PROJ#"$DBT_WS"/}"$'\n'; COUNT=$((COUNT + 1))
    else
      echo "  [$N] flagged global, but v2/$N/ has no dbt project yet — left out"
    fi
  done
  [ -f "$F" ] || printf 'packages:\n%s\n%s\n' "$DBT_GLOBAL_BEGIN" "$DBT_GLOBAL_END" > "$F"
  if ! grep -qxF "$DBT_GLOBAL_BEGIN" "$F" || ! grep -qxF "$DBT_GLOBAL_END" "$F"; then
    echo "  WARNING: global/packages.yml has no managed block (markers removed?) — products not synced"
  else
    TMP="$(mktemp)"
    awk -v b="$DBT_GLOBAL_BEGIN" -v e="$DBT_GLOBAL_END" -v lines="$BLOC" '
      $0==b {print; printf "%s", lines; skip=1; next}
      $0==e {skip=0}
      !skip {print}' "$F" > "$TMP" && cat "$TMP" > "$F"
    rm -f "$TMP"
    echo "  global/: $COUNT product(s) as local packages"
  fi
  [ -e "$DBT_WS/global/.env" ] || [ -L "$DBT_WS/global/.env" ] || ln -s ../profiles/dbt.env "$DBT_WS/global/.env" 2>/dev/null || true
  return 0
}

# -----------------------------------------------------------------------------
# Fleet: the v4 space — profiles/v4.env, the .env of v4/ and global-v4/
# -----------------------------------------------------------------------------
# The v2 and the v4 of a product carry the same package names: under one
# DATASET_PREFIX they would compute — and write — the same tables, and a proof
# would compare a table with itself. v4/ and global-v4/ run under
# DBT_BQ_DATASET_PREFIX_V4, a prefix strictly under DBT_BQ_DATASET_PREFIX:
# dbt-run.sh loads profiles/v4.env for them (chosen by the MODE, never by a
# variable a shell could have exported), and the .env that dbt v2 and its
# extension read in their projects points to it.

_DBT_PREFIX_LINE_RE='^[[:space:]]*(export[[:space:]]+)?DATASET_PREFIX[[:space:]]*='

# _dbt_v4_prefix_ok — DBT_BQ_DATASET_PREFIX_V4 is <DBT_BQ_DATASET_PREFIX>_<letters, digits, _>, and no `_`-separated
# segment of what follows <DBT_BQ_DATASET_PREFIX>_ has a flux's shape, <A999> or H (any case): JDOE_V4_D005 would be the
# space of flux D005 seen from the main copy, and a flux D006 under it would write JDOE_V4_D005_D006_…, inside D005's
_dbt_v4_prefix_ok() {
  local S X LC_ALL=C
  case "${DBT_BQ_DATASET_PREFIX_V4:-}" in ""|*[!A-Za-z0-9_]*) return 1 ;; esac
  [ -n "${DBT_BQ_DATASET_PREFIX:-}" ] || return 1
  case "$DBT_BQ_DATASET_PREFIX_V4" in "${DBT_BQ_DATASET_PREFIX}_"?*) ;; *) return 1 ;; esac
  S="${DBT_BQ_DATASET_PREFIX_V4#"${DBT_BQ_DATASET_PREFIX}_"}"
  for X in ${S//_/ }; do
    [[ "$(_dbt_upper "$X")" =~ $DBT_V4_FLUX_RE ]] && return 1
  done
  return 0
}

# _dbt_under_v4 DATASET — DATASET is in the v4 space: DBT_BQ_DATASET_PREFIX_V4 itself, or <it>_… (any case)
_dbt_under_v4() {
  local X D
  X="$(printf '%s' "${DBT_BQ_DATASET_PREFIX_V4:-}" | tr '[:lower:]' '[:upper:]')"
  [ -n "$X" ] || return 1
  D="$(printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]')"
  [ "$D" = "$X" ] && return 0
  case "$D" in "${X}_"*) return 0 ;; esac
  return 1
}

# -----------------------------------------------------------------------------
# Fleet: a flux — a working copy whose v4 writes under <DBT_BQ_DATASET_PREFIX_V4>_<FLUX>
# -----------------------------------------------------------------------------
# Several v4 works may run side by side (one redescente each, a simulation…), each in its own working copy of the
# fleet: under one prefix they would build — and prove against — the same tables. A copy declares its flux in
# .devcontainer/flux.conf, ONE line (blank lines and # comments aside)
#   DBT_V4_FLUX=<A999>        a capital letter and three digits (D005, S001) — never a package's name (DWH_…, DBT_…)
#   DBT_V4_FLUX=H             the HARMONIZED line: a long-lived copy whose v4 is the main copy's (the ISO line: every
#                             output equal to production) plus one convergence per deviation (outputs may deviate,
#                             one implementation per concept) — its own space, <DBT_BQ_DATASET_PREFIX_V4>_H, where the
#                             ISO line never writes, and the only one it writes
# The file belongs to the working copy: parsed, never sourced; ignored by git and untracked, or every dbt command is
# refused (dbt_v4_flux_problem). Then:
#   - v4/ and global-v4/ run on profiles/v4-<FLUX>.env (generated from profiles/dbt.env, DATASET_PREFIX =
#     <DBT_BQ_DATASET_PREFIX_V4>_<FLUX>, never committed either) and write under that prefix (= or _*) only;
#   - v1/, v2/ and global/ build nothing (their spaces belong to the main copy): only the commands of
#     DBT_FLUX_READ_CMDS run there — parse, ls, compile, show, deps (dbt_read_only_args, dbt-run.sh);
#   - its dbt.conf gives the main copy's sandbox, prefixes and engine pins (_DBT_FLUX_SHARED), and guard settings at
#     least as strict as the main copy's (_DBT_FLUX_STRICT: DBT_SANDBOX_NEVER_BUILD, the hook approvals,
#     DBT_ALLOW_RUN_OPERATION), read from the main copy's dbt.conf (DBT_V4_MAIN_WS), or every dbt command is refused
#     (_dbt_flux_main_problem);
#   - no hook runs in its v1/, v2/, global/ (dbt-run.sh, guest_hooks_guard): whatever dbt.conf approves there is the
#     main copy's;
#   - its `just setup` sets up this copy only: the container's state — engines, ~/.bashrc, the global git settings —
#     stays the main copy's (_dbt_owns_container);
#   - the seal of global-v4's hook proof covers profiles/v4-<FLUX>.env (its path, its prefix) instead of
#     profiles/v4.env, the verdict line names the flux, and the proof is a file of its own, DBT_HOOKS_V4_PROOF with
#     -<FLUX> before its extension: a proof holds for one flux only, and the main copy's stays where it is
#     (dbt_hooks_v4_seal, dbt_hooks_v4_verdict, dbt_hooks_v4_proof_path).
# What a flux <A999> does NOT separate: git. Its worktrees follow the same branches of the products as the main
# copy's (v4, v2): a commit pushed from it reaches the main copy at its next `just sync` — nothing is committed on v2
# from any flux (dbt v2 deps rewrites package-lock.yml there). The HARMONIZED line (flux H) is apart in git too, or its
# convergences would reach the ISO line:
#   - its v4 worktrees follow branches of their own (dbt_use_product): <product>/v4-h, tracking v4-h where the
#     product's branches live (<product>/v4-h on origin), opened THERE from the published v4 — never created here
#     (_dbt_ensure_branch); a v4 copy on any other branch (the ISO line's <product>/v4) or detached elsewhere than in
#     its own history is refused (dbt_v4_line_h_branch_problem: dbt-run.sh, line_h_guard), never moved by `just sync`;
#   - no push of it reaches a branch of the ISO line or of the shared generations — v1, v2, v4 —, a v4-h is created at
#     the published v4 only, never deleted nor rewritten: a pre-push hook (.devcontainer/git-push-garde-h.sh,
#     installed by dbt_ensure_push_guard_h; every dbt command refused while git would not run it:
#     _dbt_push_guard_h_problem);
#   - its lock is .devcontainer/products-h.lock (dbt_load_conf), never products.lock;
#   - clone, --state, --defer (--defer-state, --favor-state) and --manage-state are refused there, and their
#     environment variables (DBT_LINE_H_STATE_ARGS, DBT_LINE_H_STATE_ENV: dbt-run.sh) — they would bring another
#     space's relations or state into the line (`dbt clone --state <the ISO line's manifest>` would copy ISO tables
#     under <DBT_BQ_DATASET_PREFIX_V4>_H) — until a later change of this template opens them.
# Without flux.conf, in the MAIN copy — the one DBT_V4_MAIN_WS (dbt.conf) names by its real path — nothing changes,
# but one thing: its v4 never writes a dataset shaped like a flux's space, <DBT_BQ_DATASET_PREFIX_V4>_<A999> or
# <DBT_BQ_DATASET_PREFIX_V4>_H (= or _*): the main copy's v4 — the ISO line — never writes the harmonized line's.
# Spaces are disjoint: a flux name is followed by `_` or the end, and the main space is what no flux can name. Writes
# are accepted byte by byte (BigQuery dataset names are case-sensitive), refused in any case.
# The main copy is named, never inferred from a missing file (flux.conf is ignored by git: `git clean -X` erases it):
# a copy of a fleet with a v4 that is neither the main copy nor a flux — an ORPHAN (dbt_v4_role) — has no v4 space and
# builds nothing; `just setup` does not change that. Only the main copy writes the container's state
# (_dbt_owns_container): a flux's `just setup` sets up that copy, never ~/.bashrc, the global git settings or the
# engines every other copy uses.

# _dbt_flux_consts — the flux syntax, explicit classes ([A-Z] may match lowercase letters under some locales). Set when
# the lib is sourced, and by dbt_load_conf before dbt.conf: dbt.conf changing one is an error (_dbt_flux_changed).
_dbt_flux_consts() {
  # <A999> (a work run in parallel) or H (the harmonized line) — H alone: no other single letter is a flux
  DBT_V4_FLUX_RE='^([ABCDEFGHIJKLMNOPQRSTUVWXYZ][0123456789][0123456789][0123456789]|H)$'
  _DBT_FLUX_LINE_RE='^DBT_V4_FLUX=([ABCDEFGHIJKLMNOPQRSTUVWXYZ][0123456789][0123456789][0123456789]|H)$'
  # a blank or comment line: space, tab, CR, VT, FF — spelled out ([[:space:]] would follow the locale: U+2003 is a
  # space under C.UTF-8, not under C)
  _DBT_FLUX_BLANK_RE=$'^[ \t\r\v\f]*(#.*)?$'
}
_dbt_flux_consts

# _dbt_flux_vars — every DBT_V4_FLUX* / _DBT_FLUX* variable of this shell, as `declare -p` prints it (sorted)
_dbt_flux_vars() {
  local V
  for V in $(compgen -v | LC_ALL=C grep -E '^(DBT_V4_FLUX|_DBT_FLUX)' | LC_ALL=C sort); do declare -p "$V" 2>/dev/null; done
}

# _dbt_flux_changed BEFORE — (dbt_load_conf, after dbt.conf) the DBT_V4_FLUX* / _DBT_FLUX* variables dbt.conf set,
# added, changed or exported since BEFORE (_dbt_flux_vars): their names, or "DBT_V4_FLUX*"; nothing: none
_dbt_flux_changed() {
  local A N
  A="$(_dbt_flux_vars)"
  [ "$A" = "${1:-}" ] && return 0
  N="$(diff <(printf '%s\n' "${1:-}") <(printf '%s\n' "$A") 2>/dev/null \
    | LC_ALL=C sed -nE 's/^[<>] declare -[^ ]* ([A-Za-z_][A-Za-z0-9_]*).*/\1/p' | LC_ALL=C sort -u | paste -sd' ' -)"
  printf '%s' "${N:-DBT_V4_FLUX*}"
}

_dbt_upper() { printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]'; }

# _dbt_flux_parse FILE — prints the flux FILE declares (nothing when there is no FILE), or returns 1: FILE is not a
# regular file (a link included, even dangling), holds a NUL byte (bash's read would drop it: D0<NUL>05 is not D005),
# or holds anything but ONE line DBT_V4_FLUX=<A999> or DBT_V4_FLUX=H, blank lines and # comments aside (a CRLF line is
# not one; the last
# line counts even without its newline). Read byte by byte (LC_ALL=C: any byte in a comment, whatever the locale — as
# the Python mirror of the fleet reads it). Parsed, never sourced.
_dbt_flux_parse() {
  local F="${1:-}" L N=0 X="" LC_ALL=C
  [ -e "$F" ] || [ -L "$F" ] || return 0
  { [ -f "$F" ] && [ ! -L "$F" ] && [ -r "$F" ]; } || return 1
  [ "$(tr -d '\000' < "$F" | wc -c)" = "$(wc -c < "$F")" ] || return 1
  while IFS= read -r L || [ -n "$L" ]; do
    [[ "$L" =~ $_DBT_FLUX_BLANK_RE ]] && continue
    [[ "$L" =~ $_DBT_FLUX_LINE_RE ]] || return 1
    X="${BASH_REMATCH[1]}"; N=$((N + 1))
  done < "$F"
  [ "$N" = 1 ] || return 1
  printf '%s' "$X"
}

# _dbt_flux_read — (dbt_load_conf, after dbt.conf) DBT_V4_FLUX: the flux of this working copy, from
# .devcontainer/flux.conf — or DBT_V4_FLUX_ERR: why that declaration cannot be trusted (DBT_V4_FLUX is then empty,
# and dbt-run.sh refuses every dbt command). dbt.conf is committed and shared by every copy: a DBT_V4_FLUX* or
# _DBT_FLUX* variable set there (_DBT_CONF_FLUX_SET) is an error, never a flux nor a way to hide one. The main copy
# (DBT_V4_MAIN_WS) is never a flux.
_dbt_flux_read() {
  local F
  # DBT_V4_FLUX is "" here unless dbt.conf set it (dbt_load_conf resets it before dbt.conf: an exported one never
  # survives) — and that is an error: no flux, ever, from there
  DBT_V4_FLUX_ERR=""
  if [ -n "${_DBT_CONF_FLUX_SET:-}" ]; then
    DBT_V4_FLUX=""
    DBT_V4_FLUX_ERR="$_DBT_CONF_FLUX_SET set in .devcontainer/dbt.conf, a committed file shared by every copy: a flux belongs to one working copy (.devcontainer/flux.conf, never committed), and nothing of it is configured there"
    return 0
  fi
  if ! F="$(_dbt_flux_parse "$DBT_V4_FLUX_FILE")"; then
    DBT_V4_FLUX_ERR=".devcontainer/flux.conf is not a regular file holding one line DBT_V4_FLUX=<A999> (a capital letter, three digits) or DBT_V4_FLUX=H (the harmonized line; blank lines and # comments aside)"
    return 0
  fi
  if [ -n "$F" ] && ! dbt_is_fleet; then
    DBT_V4_FLUX_ERR=".devcontainer/flux.conf in a single-product workspace: a flux exists in a fleet only (its v4 space)"
    return 0
  fi
  if [ -n "$F" ] && _dbt_is_main_ws; then
    DBT_V4_FLUX_ERR=".devcontainer/flux.conf in the MAIN copy (DBT_V4_MAIN_WS, dbt.conf): the main copy is never a flux — a flux is another working copy"
    return 0
  fi
  DBT_V4_FLUX="$F"
  return 0
}

# _dbt_is_main_ws — this working copy is the main one: DBT_V4_MAIN_WS (dbt.conf) is an absolute path, and its real
# path (links resolved) is this copy's
_dbt_is_main_ws() {
  local A B
  case "${DBT_V4_MAIN_WS:-}" in /*) ;; *) return 1 ;; esac
  A="$(cd "$DBT_WS" 2>/dev/null && pwd -P)" && B="$(cd "$DBT_V4_MAIN_WS" 2>/dev/null && pwd -P)" || return 1
  [ -n "$A" ] && [ "$A" = "$B" ]
}

# _dbt_v4_declared — this workspace is a fleet with a v4: DBT_V4_PRODUCTS, a referent, or a v4 prefix
_dbt_v4_declared() { dbt_is_fleet && [ -n "${DBT_V4_PRODUCTS:-}${DBT_BQ_DATASET_PREFIX_V4:-}$(dbt_referents)" ]; }

# dbt_v4_role — what this working copy is (fleet only; nothing printed for a single product, nor for a fleet that
# declares no v4 and no flux — as before fluxes):
#   refused  its flux declaration cannot be trusted (DBT_V4_FLUX_ERR): every dbt command is refused;
#   flux     it declares a sound flux (.devcontainer/flux.conf);
#   main     a fleet with a v4 whose real path is DBT_V4_MAIN_WS (dbt.conf) — it declares no flux;
#   orphan   a fleet with a v4, neither: a clone, a flux whose flux.conf was erased (`git clean -X`), a main copy moved,
#            or DBT_V4_MAIN_WS empty or relative — no v4 space (every v4 command refused), and in the v1/v2/global
#            spaces, the main copy's, what a flux may do only (parse, ls, compile, show, deps).
dbt_v4_role() {
  dbt_is_fleet || return 0
  if [ -n "${DBT_V4_FLUX_ERR:-}" ]; then echo refused
  elif [ -n "${DBT_V4_FLUX:-}" ]; then echo flux
  elif ! _dbt_v4_declared; then return 0
  elif _dbt_is_main_ws; then echo main
  else echo orphan; fi
}

# The settings a flux shares with its main copy, read from the main copy's dbt.conf: where the spaces are carved (the
# sandbox, its prefixes, the main copy itself) and which engines run (the container's, the main copy's). A flux whose
# dbt.conf says otherwise would carve its space from another layout, or ask for engines it does not get.
_DBT_FLUX_SHARED="DBT_BQ_PROJECT DBT_BQ_DATASET_PREFIX DBT_BQ_DATASET_PREFIX_V4 DBT_V4_MAIN_WS DBT_V1_PINS DBT_V2_VERSION"

# The guard settings a flux may only TIGHTEN, read from the main copy's dbt.conf too (_dbt_flux_strict_problem): the
# write guard and the hooks (verrou 3 of a fleet). A flux never builds a node the main copy never builds
# (DBT_SANDBOX_NEVER_BUILD: every name of the main copy's, maybe more), never opens a hook the main copy keeps closed
# (DBT_HOOKS_COMPILE_OK: no name the main copy's does not list; DBT_HOOKS_REVIEWED, DBT_HOOKS_REVIEWED_V2: 1 only where
# the main copy says 1), never runs a macro the main copy refuses (DBT_ALLOW_RUN_OPERATION: likewise). A flux that
# lives long, on a branch of its own (the harmonized line), may lag behind its main copy: tighter passes, looser
# refuses every dbt command — e.g. a table the main copy has added to DBT_SANDBOX_NEVER_BUILD since.
_DBT_FLUX_STRICT="DBT_SANDBOX_NEVER_BUILD DBT_HOOKS_COMPILE_OK DBT_HOOKS_REVIEWED DBT_HOOKS_REVIEWED_V2 DBT_ALLOW_RUN_OPERATION"

# _dbt_conf_values DIR [NAMES] — the values of NAMES (default: _DBT_FLUX_SHARED) that DIR/.devcontainer/dbt.conf gives,
# from their defaults (dbt_load_conf), one NAME=VALUE per line; return 1: no such file. Sourced in a subshell: nothing
# leaks here, and nothing of this shell leaks there (every name of _DBT_FLUX_SHARED and _DBT_FLUX_STRICT is reset).
_dbt_conf_values() {
  local C="${1:-}/.devcontainer/dbt.conf"
  [ -f "$C" ] || return 1
  (
    _DBT_CV_NAMES="${2:-$_DBT_FLUX_SHARED}"; readonly _DBT_CV_NAMES
    DBT_BQ_PROJECT=""; DBT_BQ_DATASET_PREFIX=""; DBT_BQ_DATASET_PREFIX_V4=""; DBT_V4_MAIN_WS=""; DBT_V1_PINS=""
    DBT_V2_VERSION="latest"
    DBT_SANDBOX_NEVER_BUILD=""; DBT_HOOKS_COMPILE_OK=""; DBT_HOOKS_REVIEWED=0; DBT_HOOKS_REVIEWED_V2=0
    DBT_ALLOW_RUN_OPERATION=0
    # shellcheck disable=SC1090
    . "$C" >/dev/null 2>&1
    for V in $_DBT_CV_NAMES; do printf '%s=%s\n' "$V" "${!V:-}"; done
  )
}

# _dbt_kv NAME < NAME=VALUE lines — the VALUE of NAME (the first line of it)
_dbt_kv() { LC_ALL=C awk -v n="${1:-}" 'index($0, n "=") == 1 { print substr($0, length(n) + 2); exit }'; }

# _dbt_flux_strict_problem MAIN — (a flux) the settings of _DBT_FLUX_STRICT where this copy's dbt.conf is looser than
# the main copy's (MAIN/.devcontainer/dbt.conf), one reason per line; nothing: as strict, or stricter
_dbt_flux_strict_problem() {
  local S M W X
  local -a WL=()
  S="$(_dbt_conf_values "${1:-}" "$_DBT_FLUX_STRICT")" || return 0
  # the lists are split into words, never globbed (read -a): a name is compared as written
  M="$(_dbt_kv DBT_SANDBOX_NEVER_BUILD <<< "$S")"
  if [ "$M" != "${DBT_SANDBOX_NEVER_BUILD:-}" ]; then
    read -r -a WL <<< "$M"
    X=""; for W in ${WL[@]+"${WL[@]}"}; do case " ${DBT_SANDBOX_NEVER_BUILD:-} " in *" $W "*) ;; *) X="$X $W" ;; esac; done
    [ -z "$X" ] || echo "DBT_SANDBOX_NEVER_BUILD here lacks what the main copy's names ($1:$X): a flux never builds a node the main copy never builds — add them to .devcontainer/dbt.conf (or bring this copy up to date with the main copy)"
  fi
  M="$(_dbt_kv DBT_HOOKS_COMPILE_OK <<< "$S")"
  if [ "$M" != "${DBT_HOOKS_COMPILE_OK:-}" ]; then
    read -r -a WL <<< "${DBT_HOOKS_COMPILE_OK:-}"
    X=""; for W in ${WL[@]+"${WL[@]}"}; do case " $M " in *" $W "*) ;; *) X="$X $W" ;; esac; done
    [ -z "$X" ] || echo "DBT_HOOKS_COMPILE_OK here names what the main copy's does not ($X, not listed in $1): a flux never opens a hook the main copy keeps closed — remove them from .devcontainer/dbt.conf"
  fi
  for W in DBT_HOOKS_REVIEWED DBT_HOOKS_REVIEWED_V2 DBT_ALLOW_RUN_OPERATION; do
    M="$(_dbt_kv "$W" <<< "$S")"
    [ "${!W:-0}" = 1 ] && [ "$M" != 1 ] \
      && echo "$W=1 here, '$M' in the main copy's dbt.conf ($1): a flux never opens what the main copy keeps closed — set it back to $M"
  done
  return 0
}

# _dbt_flux_main_problem — (a flux) why its main copy does not vouch for it, one reason per line: no main copy named,
# the main copy not there, a shared setting (_DBT_FLUX_SHARED) that differs between the two dbt.conf, or a guard
# setting (_DBT_FLUX_STRICT) looser here than there
_dbt_flux_main_problem() {
  local M H V
  case "${DBT_V4_MAIN_WS:-}" in
    /*) ;;
    *) echo "DBT_V4_MAIN_WS ('${DBT_V4_MAIN_WS:-}') names no main copy by an absolute path (.devcontainer/dbt.conf): a flux's space is carved from the main copy's"; return 0 ;;
  esac
  if ! M="$(_dbt_conf_values "$DBT_V4_MAIN_WS")"; then
    echo "the main copy $DBT_V4_MAIN_WS (DBT_V4_MAIN_WS) has no .devcontainer/dbt.conf: a flux's space is carved from the main copy's"
    return 0
  fi
  H="$(for V in $_DBT_FLUX_SHARED; do printf '%s=%s\n' "$V" "${!V:-}"; done)"
  if [ "$M" != "$H" ]; then
    diff <(printf '%s\n' "$H") <(printf '%s\n' "$M") 2>/dev/null | LC_ALL=C sed -nE 's/^< ([A-Z0-9_]+)=(.*)$/\1 \2/p' \
      | while read -r V X; do
          echo "$V differs from the main copy's ($DBT_V4_MAIN_WS: '$(printf '%s\n' "$M" | LC_ALL=C sed -n "s/^$V=//p")', here: '$X'): a flux shares its sandbox, prefixes and engines with the main copy — align .devcontainer/dbt.conf"
        done
  fi
  _dbt_flux_strict_problem "$DBT_V4_MAIN_WS"
}

# _dbt_flux_vestiges — the fluxes, other than its own, this copy shows traces of: a profiles/v4-<A999>.env or
# profiles/v4-H.env, or a .env
# of the v4 space (v4/<member>/…, global-v4/) that links to one — even dangling: `git clean -X` erases the file and
# leaves the link
_dbt_flux_vestiges() {
  (
    for E in "$DBT_WS"/profiles/v4-*.env; do { [ -e "$E" ] || [ -L "$E" ]; } && basename "$E"; done
    for N in $(dbt_members); do
      dbt_use_product "$N" >/dev/null 2>&1 && dbt_v4_enabled || continue
      P="$(dbt_project_dir v4 2>/dev/null)" || continue
      [ -L "$P/.env" ] && basename "$(readlink "$P/.env")"
    done
    [ -L "$DBT_WS/global-v4/.env" ] && basename "$(readlink "$DBT_WS/global-v4/.env")"
  ) 2>/dev/null | LC_ALL=C sed -nE 's/^v4-([ABCDEFGHIJKLMNOPQRSTUVWXYZ][0123456789]{3}|H)\.env$/\1/p' \
    | LC_ALL=C grep -vxF -- "${DBT_V4_FLUX:-@}" | LC_ALL=C sort -u
}

# dbt_v4_orphan_why — why this copy is an orphan (dbt_v4_role), and the flux it was, if it shows traces of one
dbt_v4_orphan_why() {
  local A V
  A="$(cd "$DBT_WS" 2>/dev/null && pwd -P)"
  case "${DBT_V4_MAIN_WS:-}" in
    "") echo "DBT_V4_MAIN_WS is empty in .devcontainer/dbt.conf: no working copy is the main one (if this one is: DBT_V4_MAIN_WS=\"$A\", committed)" ;;
    /*) echo "this copy is $A, the main copy is DBT_V4_MAIN_WS=\"$DBT_V4_MAIN_WS\" (dbt.conf), and this copy declares no flux (.devcontainer/flux.conf)" ;;
    *)  echo "DBT_V4_MAIN_WS ('$DBT_V4_MAIN_WS', dbt.conf) is not an absolute path: no working copy is the main one (if this one is: DBT_V4_MAIN_WS=\"$A\")" ;;
  esac
  V="$(_dbt_flux_vestiges | paste -sd' ' -)"
  [ -z "$V" ] || echo "this copy WAS flux $V (traces: profiles/v4-$V.env, or a .env of the v4 space linked to it): restore its .devcontainer/flux.conf (DBT_V4_FLUX=$V) — never make it the main copy"
}

# _dbt_owns_container — this copy may write the container's state, shared by every copy: ~/.bashrc (`dbt`,
# DBT_PROFILES_DIR), the global git settings that name a path or lift a lock (core.sshCommand, url.*.insteadOf, an
# unlocked push), ~/.bigqueryrc, the two engines (/opt/dbt-v1, ~/.local/bin/dbt). A single product: yes (as before). A
# fleet: its main copy (DBT_V4_MAIN_WS) — or, while DBT_V4_MAIN_WS is empty, a copy that declares no flux (as before
# fluxes; the doctor asks for it). A flux, a refused declaration, any other copy: never — their `just setup` sets up
# their own working copy only, and leaves the container to the main copy (_dbt_guest_engines says what it found).
_dbt_owns_container() {
  dbt_is_fleet || return 0
  [ -z "${DBT_V4_FLUX:-}${DBT_V4_FLUX_ERR:-}" ] || return 1
  [ -n "${DBT_V4_MAIN_WS:-}" ] || return 0
  _dbt_is_main_ws
}

# _dbt_guest_engines — (a copy that does not own the container) the engines it found, never installed nor rebuilt
# from here: a WARNING when they are missing, or when dbt Core was not built from this copy's DBT_V1_PINS (a flux whose
# pins differ from the main copy's is refused anyway: _dbt_flux_main_problem)
_dbt_guest_engines() {
  local OWNER="${DBT_V4_MAIN_WS:-the main copy}"
  if [ -x "$DBT_V1_VENV/bin/dbt" ]; then
    echo "  dbt Core $(_dbt_v1_version || echo '?') ($DBT_V1_VENV) — the container's, built by $OWNER"
    if [ -n "${DBT_V1_PINS:-}" ] && [ "$(cat "$DBT_V1_VENV/.dbt-pins" 2>/dev/null)" != "pins:$DBT_V1_PINS" ]; then
      echo "  WARNING: this copy pins '$DBT_V1_PINS', the container's dbt Core was not built from it — never rebuilt from here: align DBT_V1_PINS with $OWNER"
    fi
  else
    echo "  WARNING: no dbt Core in $DBT_V1_VENV — never installed from here: just setup in $OWNER"
  fi
  if [ -x "$DBT_BIN_DIR/dbt" ]; then
    echo "  $("$DBT_BIN_DIR/dbt" --version 2>/dev/null | head -1) ($DBT_BIN_DIR/dbt) — the container's"
  else
    echo "  WARNING: no dbt v2 at $DBT_BIN_DIR/dbt — never installed from here: just setup in $OWNER"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Fleet: the harmonized line (flux H) in git — its own branches, its push guard
# -----------------------------------------------------------------------------

# _dbt_is_line_h — this working copy is the harmonized line: it declares flux H (.devcontainer/flux.conf, read by
# _dbt_flux_read — a declaration that cannot be trusted is no line at all: every dbt command is refused there)
_dbt_is_line_h() { [ "${DBT_V4_FLUX:-}" = H ]; }

# What the harmonized line refuses, whatever the space (dbt-run.sh, run_dbt): the commands and options that bring
# another space's relations or state into a line — `clone` (copies relations: `--state <the ISO line's manifest>` would
# copy ISO tables under <DBT_BQ_DATASET_PREFIX_V4>_H), deferral and state comparison (--defer, and --defer-state,
# --favor-state, hidden from dbt 2.0.8's help), service-backed dbt State (--manage-state) — and the environment
# variables that set them (dbt 2.0.8: its help, and the strings of its binary). Every word of the command line is read
# (`--state=x` as `--state`): a model called `clone` costs a refusal, never a missed clone. The --no-… forms, which
# turn them off, pass.
# shellcheck disable=SC2034  # both read by dbt-run.sh (run_dbt)
DBT_LINE_H_STATE_ARGS="clone --state --defer --defer-state --favor-state --manage-state"
# shellcheck disable=SC2034
DBT_LINE_H_STATE_ENV="DBT_STATE DBT_DEFER DBT_DEFER_STATE DBT_FAVOR_STATE DBT_ENGINE_MANAGE_STATE DBT_ENGINE_STATE_HOME DBT_CLOUD_DEFER_ENV_ID DBT_CLOUD_DEFER_JOB_ID"

# dbt_v4_line_h_branch_problem — (the harmonized line; after dbt_use_product) why the current product's v4 copy is not
# the harmonized line's, one line; nothing: it is, or there is no v4 copy (yet). It must be on <product>/v4-h ($P_B4),
# tracking $P_HOME/$P_HB4 — or detached at a commit of <product>/v4-h's own history (a replay: lock-checkout). Refused:
# the ISO line's <product>/v4 (or any other branch), a detached HEAD elsewhere, <product>/v4-h tracking anything else
# (its `git push` would go there).
dbt_v4_line_h_branch_problem() {
  local W B U C
  _dbt_is_line_h && dbt_v4_enabled || return 0
  W="$(_dbt_wt v4)"
  _dbt_is_worktree "$W" || return 0
  B="$(git -C "$W" symbolic-ref -q --short HEAD 2>/dev/null)"
  if [ -z "$B" ]; then
    C="$(git -C "$W" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)"
    [ -n "$C" ] && _dbt_has_ref "refs/heads/$P_B4" && git -C "$DBT_WS" merge-base --is-ancestor "$C" "refs/heads/$P_B4" 2>/dev/null && return 0
    echo "$(_dbt_show v4) is detached at ${C:0:9}, a commit outside $P_B4's history: the harmonized line works on its own branch ($P_HOME/$P_HB4) — git -C ${P_SHOW4%/} checkout $P_B4"
    return 0
  fi
  if [ "$B" != "$P_B4" ]; then
    echo "$(_dbt_show v4) is on $B, not on $P_B4: the harmonized line works on its own branch ($P_HOME/$P_HB4), never on the ISO line's — git -C ${P_SHOW4%/} checkout $P_B4"
    return 0
  fi
  U="$(git -C "$DBT_WS" rev-parse --abbrev-ref "$P_B4@{upstream}" 2>/dev/null)"
  [ "$U" = "$P_HOME/$P_HB4" ] \
    || echo "$P_B4 tracks ${U:-nothing}, not $P_HOME/$P_HB4: its pushes would go elsewhere — git -C ${P_SHOW4%/} branch -u $P_HOME/$P_HB4"
  return 0
}

# The push guard of the harmonized line: .devcontainer/git-push-garde-h.sh (template-owned), installed as this copy's
# own pre-push hook — <git common dir>/hooks/pre-push, run for every worktree of the copy. What it refuses: its header.
_dbt_push_guard_h_src() { printf '%s' "$DBT_WS/.devcontainer/git-push-garde-h.sh"; }
_dbt_push_guard_h_dst() {
  local G
  G="$(git -C "$DBT_WS" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && [ -n "$G" ] || return 1
  printf '%s/hooks/pre-push' "$G"
}
_DBT_PUSH_GUARD_H_MARK="sap-template: git-push-garde-h"

# dbt_ensure_push_guard_h — (lifecycle; the harmonized line only) the push guard installed, byte for byte: written when
# there is no pre-push hook, replaced when the one there carries the guard's marker (an older version of it); a hook of
# someone else is never touched (said: every dbt command stays refused, _dbt_push_guard_h_problem). Never removed —
# not even when flux.conf is gone: an ex-H copy keeps refusing.
dbt_ensure_push_guard_h() {
  local S D
  _dbt_is_line_h || return 0
  S="$(_dbt_push_guard_h_src)"
  if [ ! -f "$S" ]; then echo "  WARNING: flux H — no ${S#"$DBT_WS"/} (copier update): no push guard, every dbt command is refused"; return 0; fi
  D="$(_dbt_push_guard_h_dst)" || { echo "  WARNING: flux H — not a git repository: no push guard"; return 0; }
  if [ -e "$D" ] || [ -L "$D" ]; then
    if cmp -s "$S" "$D" && [ -x "$D" ] && [ ! -L "$D" ]; then
      echo "  push guard of the harmonized line: ${D} (no push to v1, v2 nor v4)"; return 0
    fi
    if [ -L "$D" ] || [ ! -f "$D" ] || ! grep -qF "$_DBT_PUSH_GUARD_H_MARK" "$D"; then
      echo "  WARNING: flux H — $D is another pre-push hook: left as it is, so every dbt command is refused (move it away, then: just setup)"
      return 0
    fi
  fi
  mkdir -p "$(dirname "$D")" && cat "$S" > "$D" && chmod 755 "$D" \
    && echo "  push guard of the harmonized line installed: $D (no push to v1, v2 nor v4; a v4-h created at the published v4 only)" \
    || echo "  WARNING: flux H — cannot install the push guard ($D): every dbt command is refused"
  return 0
}

# _dbt_push_guard_h_problem — (the harmonized line) why its push guard would not run, one reason per line; nothing: git
# runs it on every push, from the copy and from each of its worktrees. The template's file missing, the installed hook
# not byte for byte that file or not executable, or git resolving its pre-push hook elsewhere (core.hooksPath — in the
# copy's or the container's git settings, or in one worktree's own, when extensions.worktreeConfig is on).
_dbt_push_guard_h_problem() {
  local S D W WC H
  local -a WTS=()
  S="$(_dbt_push_guard_h_src)"
  [ -f "$S" ] || { echo "${S#"$DBT_WS"/} is missing (copier update): the harmonized line has no push guard"; return 0; }
  D="$(_dbt_push_guard_h_dst)" || { echo "not a git repository: the harmonized line has no push guard"; return 0; }
  { [ -f "$D" ] && [ ! -L "$D" ] && [ -x "$D" ] && cmp -s "$S" "$D"; } \
    || echo "its push guard is not installed ($D is not ${S#"$DBT_WS"/}, byte for byte, executable): a push could reach v1, v2 or v4 — just setup"
  WC="$(git -C "$DBT_WS" config --bool --get extensions.worktreeConfig 2>/dev/null)"
  WTS=("$DBT_WS")
  [ "$WC" != true ] || mapfile -t -O 1 WTS < <(git -C "$DBT_WS" worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n 's/^worktree //p')
  # the hooks directory git uses, from the copy and (worktree settings on) from each worktree: this copy's own
  for W in "${WTS[@]}"; do
    H="$(git -C "$W" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)"
    [ -n "$H" ] && [ "$(realpath -m -- "$H")" = "$(realpath -m -- "${D%/*}")" ] \
      || echo "git does not run $D from ${W#"$DBT_WS"/} (core.hooksPath: $(git -C "$W" config --get core.hooksPath 2>/dev/null || echo '?')): the push guard would not run — unset core.hooksPath"
  done
  return 0
}

# dbt_v4_prefix — the dataset prefix of THIS copy's v4 space: DBT_BQ_DATASET_PREFIX_V4, or <it>_<FLUX> in a flux
dbt_v4_prefix() { printf '%s' "${DBT_BQ_DATASET_PREFIX_V4:-}${DBT_V4_FLUX:+_$DBT_V4_FLUX}"; }

# dbt_v4_env_file — the environment of THIS copy's v4 space: profiles/v4.env, or profiles/v4-<FLUX>.env in a flux
dbt_v4_env_file() { printf '%s' "$DBT_WS/profiles/v4${DBT_V4_FLUX:+-$DBT_V4_FLUX}.env"; }

# _dbt_is_v4_env PATH — PATH resolves to an environment of the v4 space: profiles/v4.env or profiles/v4-<x>.env
_dbt_is_v4_env() {
  local L D
  L="$(readlink -f "${1:-}" 2>/dev/null)" && [ -n "$L" ] || return 1
  D="$(readlink -f "$DBT_WS/profiles" 2>/dev/null)" && [ -n "$D" ] || return 1
  [ "$L" = "$D/v4.env" ] && return 0
  case "$L" in "$D"/v4-*.env) [ "$(dirname "$L")" = "$D" ] && return 0 ;; esac
  return 1
}

# _dbt_flux_clash — in a flux, the packages of the v4 space whose name reads as the flux (<flux> or <flux>_…, any
# case): their datasets <DBT_BQ_DATASET_PREFIX_V4>_<PACKAGE>__… would be the flux's. Read from the files only (the v4
# projects of the members, global-v4/dbt_project.yml, global-v4/package-lock.yml, global-v4/dbt_packages/), in a
# subshell: the current product is left as it was.
_dbt_flux_clash() {
  local F="${DBT_V4_FLUX:-}"
  [ -n "$F" ] || return 0
  (
    G="$DBT_WS/global-v4"
    {
      for N in $(dbt_members); do
        dbt_use_product "$N" >/dev/null 2>&1 && dbt_v4_enabled || continue
        P="$(dbt_project_dir v4 2>/dev/null)" || continue
        sed -nE "s/^name:[[:space:]]*['\"]?([A-Za-z0-9_]+).*/\1/p" "$P/dbt_project.yml" | head -1
      done
      [ -f "$G/dbt_project.yml" ] && sed -nE "s/^name:[[:space:]]*['\"]?([A-Za-z0-9_]+).*/\1/p" "$G/dbt_project.yml" | head -1
      [ -f "$G/package-lock.yml" ] && sed -nE 's/^[[:space:]]+name:[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*$/\1/p' "$G/package-lock.yml"
      [ -d "$G/dbt_packages" ] && find "$G/dbt_packages" -mindepth 1 -maxdepth 1 -printf '%f\n'
    } 2>/dev/null | LC_ALL=C awk -v f="$F" '{ u = toupper($0); if (u == f || index(u, f "_") == 1) print $0 }' | LC_ALL=C sort -u
  )
}

# dbt_v4_flux_problem — prints why this copy's flux cannot be trusted, one reason per line (nothing: no flux, or a
# sound one). dbt-run.sh refuses every dbt command while it prints anything:
#   - the declaration itself (DBT_V4_FLUX_ERR, _dbt_flux_read);
#   - .devcontainer/flux.conf or profiles/v4-<FLUX>.env tracked by git, or not ignored: `git add -A` would commit the
#     flux, and merging its work would carry it into the main copy;
#   - a package of the v4 space whose name reads as the flux (_dbt_flux_clash);
#   - the harmonized line (flux H) without its push guard (_dbt_push_guard_h_problem).
dbt_v4_flux_problem() {
  local F="${DBT_V4_FLUX:-}" X C
  if [ -n "${DBT_V4_FLUX_ERR:-}" ]; then printf '%s\n' "$DBT_V4_FLUX_ERR"; return 0; fi
  [ -n "$F" ] || return 0
  for X in .devcontainer/flux.conf "profiles/v4-$F.env"; do
    if git -C "$DBT_WS" ls-files --error-unmatch -- "$X" >/dev/null 2>&1; then
      echo "$X is tracked by git: a flux is never committed — git rm --cached $X, and ignore it (.gitignore)"
    elif ! git -C "$DBT_WS" check-ignore -q -- "$X" 2>/dev/null; then
      echo "$X is not ignored by git: \`git add -A\` would commit the flux — add /$X to .gitignore"
    fi
  done
  C="$(_dbt_flux_clash)"
  [ -z "$C" ] || echo "flux $F reads as a package of the v4 space ($(printf '%s\n' "$C" | paste -sd' ' -)): its datasets ${DBT_BQ_DATASET_PREFIX_V4:-<V4>}_<PACKAGE>__… would be the flux's — choose another flux name"
  [ "$F" != H ] || _dbt_push_guard_h_problem
  _dbt_flux_main_problem
  return 0
}

# _dbt_v4_env_render [FLUX] — profiles/dbt.env, its DATASET_PREFIX line(s) replaced by the v4's (in a flux:
# <DBT_BQ_DATASET_PREFIX_V4>_<FLUX>), on stdout. Without FLUX, the very same bytes as before fluxes existed.
_dbt_v4_env_render() {
  local SRC="$DBT_WS/profiles/dbt.env" P="${DBT_BQ_DATASET_PREFIX_V4:-}${1:+_$1}"
  if [ -z "${1:-}" ]; then
    echo "# GENERATED by .devcontainer/lib-dbt.sh from profiles/dbt.env, with DATASET_PREFIX=DBT_BQ_DATASET_PREFIX_V4"
    echo "# (dbt.conf): the environment of v4/ and global-v4/. Edit those two files, never this one (just setup rewrites it)."
  else
    echo "# GENERATED by .devcontainer/lib-dbt.sh from profiles/dbt.env, with DATASET_PREFIX=DBT_BQ_DATASET_PREFIX_V4_$1: the"
    echo "# environment of v4/ and global-v4/ in flux $1 (.devcontainer/flux.conf). Never committed; just setup rewrites it."
  fi
  if grep -qE "$_DBT_PREFIX_LINE_RE" "$SRC"; then
    sed -E "s/${_DBT_PREFIX_LINE_RE}.*/DATASET_PREFIX=${P}/" "$SRC"
  else
    cat "$SRC"; printf 'DATASET_PREFIX=%s\n' "$P"
  fi
}

# _dbt_link_env DIR ENV_FILE [fix] — DIR/.env -> ENV_FILE (a relative link), created when absent. With 'fix' (the
# v4 space), a LINK that points elsewhere is re-pointed: left on dbt.env, the dbt extension would compute there —
# and its Run/Build write — the v2's tables. A regular file is reported, never touched.
_dbt_link_env() {
  local D="$1" E="$2" REL
  [ -d "$D" ] || return 0
  REL="$(realpath -m --relative-to="$D" "$E" 2>/dev/null)" || return 0
  if [ ! -e "$D/.env" ] && [ ! -L "$D/.env" ]; then
    ln -s "$REL" "$D/.env" 2>/dev/null || true
  elif [ -n "${3:-}" ] && [ -L "$D/.env" ]; then
    [ "$(readlink -f "$D/.env")" = "$(readlink -f "$E")" ] && return 0
    ln -sfn "$REL" "$D/.env" && echo "  ${D#"$DBT_WS"/}/.env -> ${E#"$DBT_WS"/} (re-pointed)"
  elif [ -n "${3:-}" ]; then
    echo "  WARNING: ${D#"$DBT_WS"/}/.env is a file, not a link to ${E#"$DBT_WS"/}: dbt v2 and its extension read it — move it away, then: just setup"
  fi
  return 0
}

# dbt_ensure_v4_env — profiles/v4.env (re)generated from profiles/dbt.env; in a flux, profiles/v4-<FLUX>.env too;
# global-v4/.env linked to this copy's one. Nothing written while DBT_BQ_DATASET_PREFIX_V4 is empty or invalid: every
# v4 command is then refused (dbt-run.sh). A flux declaration that cannot be trusted: global-v4/.env removed (a link
# left on profiles/v4.env would let the dbt extension write the main v4 space from a flux).
dbt_ensure_v4_env() {
  local SRC="$DBT_WS/profiles/dbt.env" DST="$DBT_WS/profiles/v4.env" TMP E PB
  dbt_is_fleet || return 0
  if [ -z "${DBT_BQ_DATASET_PREFIX_V4:-}" ]; then
    [ -z "${DBT_V4_PRODUCTS:-}$(dbt_referents)" ] \
      || echo "  WARNING: v4 declared (DBT_V4_PRODUCTS / referents.conf) but no DBT_BQ_DATASET_PREFIX_V4 in dbt.conf — every v4 command is refused"
    return 0
  fi
  if ! _dbt_v4_prefix_ok; then
    echo "  WARNING: DBT_BQ_DATASET_PREFIX_V4='$DBT_BQ_DATASET_PREFIX_V4' is not ${DBT_BQ_DATASET_PREFIX:-<DBT_BQ_DATASET_PREFIX>}_<x> — profiles/v4.env not written, every v4 command is refused"
    return 0
  fi
  [ -f "$SRC" ] || { echo "  WARNING: no profiles/dbt.env — profiles/v4.env not written, every v4 command is refused"; return 0; }
  TMP="$(mktemp)"
  _dbt_v4_env_render > "$TMP"
  if cmp -s "$TMP" "$DST"; then
    echo "  profiles/v4.env (DATASET_PREFIX=$DBT_BQ_DATASET_PREFIX_V4)"
  else
    cat "$TMP" > "$DST"
    echo "  profiles/v4.env written (DATASET_PREFIX=$DBT_BQ_DATASET_PREFIX_V4) — review and commit it"
  fi
  rm -f "$TMP"
  if [ -n "${DBT_V4_FLUX_ERR:-}" ]; then
    echo "  WARNING: flux — $DBT_V4_FLUX_ERR: every dbt command is refused, and no .env of the v4 space is linked"
    [ -L "$DBT_WS/global-v4/.env" ] && rm -f "$DBT_WS/global-v4/.env"
    return 0
  fi
  # neither the main copy nor a flux: no v4 space here — said, never made the main copy (dbt_v4_role)
  if [ "$(dbt_v4_role)" = orphan ]; then
    dbt_v4_orphan_why | sed 's/^/  WARNING: orphan copy — /'
    echo "  WARNING: orphan copy — no v4 space here: every v4 command is refused, v1/v2/global build nothing, and no .env of the v4 space is linked"
    [ -L "$DBT_WS/global-v4/.env" ] && rm -f "$DBT_WS/global-v4/.env"
    return 0
  fi
  E="$DST"
  if [ -n "${DBT_V4_FLUX:-}" ]; then
    E="$(dbt_v4_env_file)"
    TMP="$(mktemp)"
    _dbt_v4_env_render "$DBT_V4_FLUX" > "$TMP"
    if cmp -s "$TMP" "$E"; then
      echo "  ${E#"$DBT_WS"/} (flux $DBT_V4_FLUX: DATASET_PREFIX=$(dbt_v4_prefix))"
    else
      cat "$TMP" > "$E"
      echo "  ${E#"$DBT_WS"/} written (flux $DBT_V4_FLUX: DATASET_PREFIX=$(dbt_v4_prefix)) — never commit it"
    fi
    rm -f "$TMP"
    PB="$(dbt_v4_flux_problem)"
    [ -z "$PB" ] || printf '%s\n' "$PB" | sed "s/^/  WARNING: flux $DBT_V4_FLUX — /; s/\$/ (every dbt command is refused until then)/"
  fi
  [ -f "$DBT_WS/global-v4/dbt_project.yml" ] && _dbt_link_env "$DBT_WS/global-v4" "$E" fix
  return 0
}

# -----------------------------------------------------------------------------
# Editor + shell integration
# -----------------------------------------------------------------------------

# Files the editors need inside the worktrees. None of them belongs to the
# dbt branches: they are hidden from git through the shared info/exclude.
dbt_ensure_editor_files() {
  local V N PROJ EXCL PAT F KIND ALLOW WT ENVF ROLE
  ROLE="$(dbt_v4_role)"
  EXCL="$(git -C "$DBT_WS" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/info/exclude"
  if [ -d "$(dirname "$EXCL")" ]; then
    for PAT in ".vscode/" ".env"; do
      grep -qxF "$PAT" "$EXCL" 2>/dev/null || echo "$PAT" >> "$EXCL"
    done
  fi
  for N in $(dbt_members); do
    dbt_use_product "$N" || continue
    for V in $(dbt_versions); do
      WT="$(_dbt_wt "$V")"
      _dbt_is_worktree "$WT" || continue
      # dbt v2 and its extension read a .env from the project directory: point
      # it at the env file of the product — for a v4, at this copy's
      # profiles/v4.env (profiles/v4-<FLUX>.env in a flux), a link that points
      # elsewhere re-pointed (none rather than one on dbt.env, or on the main
      # v4 space from a flux whose declaration cannot be trusted).
      ENVF="$P_ENV"; [ "$V" = v4 ] && ENVF="$(dbt_v4_env_file)"
      if PROJ="$(dbt_project_dir "$V")"; then
        if [ "$V" != v4 ]; then
          _dbt_link_env "$PROJ" "$ENVF"
        elif [ -f "$ENVF" ] && [ -z "${DBT_V4_FLUX_ERR:-}" ] && [ "$ROLE" != orphan ]; then
          _dbt_link_env "$PROJ" "$ENVF" fix
        else
          [ -L "$PROJ/.env" ] && rm -f "$PROJ/.env"
          if [ -n "${DBT_V4_FLUX_ERR:-}" ]; then
            echo "  WARNING: ${P_TAG}flux declaration refused (.devcontainer/flux.conf): no .env in $(_dbt_show v4) — its commands are refused"
          elif [ "$ROLE" = orphan ]; then
            echo "  WARNING: ${P_TAG}orphan copy (neither the main copy nor a flux): no .env in $(_dbt_show v4) — its commands are refused"
          else
            echo "  WARNING: ${P_TAG}no ${ENVF#"$DBT_WS"/} (DBT_BQ_DATASET_PREFIX_V4, dbt.conf): no .env in $(_dbt_show v4) — its commands are refused"
          fi
        fi
      fi
      # Settings for a window opened on the worktree alone (one extension per
      # window). Rewritten as long as they carry the marker key below.
      F="$WT/.vscode/settings.json"
      if [ ! -f "$F" ] || grep -q '"dbt-project.generated"' "$F" 2>/dev/null; then
        mkdir -p "$WT/.vscode"
        if [ "$V" = "v1" ]; then KIND="v1"; ALLOW="[]"; else KIND="v2"; ALLOW='[".vscode"]'; fi
        cat > "$F" <<EOF
{
  "dbt-project.generated": "by .devcontainer/lib-dbt.sh — remove this key to own the file",
  "dbt.dbtMajorVersion": "$KIND",
  "dbt.allowListFolders": $ALLOW,
  "python.envFile": "$ENVF",
  "terminal.integrated.profiles.linux": {
    "tmux": { "path": "bash", "args": ["$DBT_WS/.devcontainer/tmux-session.sh"], "icon": "terminal-tmux" },
    "bash": { "path": "bash", "icon": "terminal-bash" }
  }
}
EOF
      fi
    done
  done
  dbt_use_product "" >/dev/null 2>&1 || true
  return 0
}

# ~/.bashrc lives in the container filesystem: the block is rewritten on
# every start (it embeds the workspace path). The container's, shared by every
# working copy: written by the copy that owns the container only
# (_dbt_owns_container) — a flux's `just setup` never points `dbt` or
# DBT_PROFILES_DIR at itself.
dbt_shell_integration() {
  local RC="${HOME:-/home/vscode}/.bashrc" TMP WHERE
  local BEGIN="# >>> dbt-project (lib-dbt.sh) >>>" END="# <<< dbt-project (lib-dbt.sh) <<<"
  if ! _dbt_owns_container; then
    echo "  ~/.bashrc (\`dbt\`, DBT_PROFILES_DIR) is the main copy's (${DBT_V4_MAIN_WS:-?}): left as it is — here: just v4|v2 … or bash .devcontainer/dbt-run.sh"
    return 0
  fi
  touch "$RC" 2>/dev/null || return 0
  TMP="$(mktemp)"
  awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$RC" > "$TMP" \
    && cat "$TMP" > "$RC"
  rm -f "$TMP"
  if dbt_is_fleet; then
    WHERE="dbt Core 1.x inside v1/<product>/, dbt v2 inside v2/<product>/ and global/ — and in the v4\n# space, v4/<product>/ and global-v4/"
  else
    WHERE="dbt Core 1.x inside v1/, dbt v2\n# inside v2/"
  fi
  cat >> "$RC" <<EOF
$BEGIN
# Belt and braces: containerEnv already gives it to every process.
export DBT_PROFILES_DIR="$DBT_WS/profiles"
# \`dbt\` picks its engine from the directory: $(printf '%b' "$WHERE") (all through the guarded dbt-run.sh), plain dbt v2 elsewhere.
# The raw engines stay reachable as \`dbt1\` and \`dbtf\`.
dbt() { bash "$DBT_WS/.devcontainer/dbt-run.sh" auto "\$@"; }
$END
EOF
  return 0
}

# Informative only — never blocks the start, never calls the network.
dbt_gcloud_status() {
  local ACCT
  if ! command -v gcloud >/dev/null 2>&1; then
    echo "  gcloud not found — rebuild the container (feature google-cloud-cli)"
    return 0
  fi
  ACCT="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)"
  if [ -n "$ACCT" ]; then echo "  gcloud/bq CLI: $ACCT"; else echo "  gcloud/bq CLI: not logged in -> just gcp-login"; fi
  if [ -f "${HOME:-}/.config/gcloud/application_default_credentials.json" ]; then
    echo "  ADC (dbt oauth): present"
  else
    echo "  ADC (dbt oauth): missing -> just gcp-login"
  fi
  # bq defaults: region + a cost guard (a query whose ESTIMATE exceeds it
  # fails before running). Created once, then yours — by the copy that owns
  # the container.
  if [ ! -f "${HOME:-}/.bigqueryrc" ] && _dbt_owns_container; then
    cat > "$HOME/.bigqueryrc" <<EOF
--location=${DBT_BQ_LOCATION:-EU}

[query]
--use_legacy_sql=false
--maximum_bytes_billed=42949672960
EOF
    echo "  ~/.bigqueryrc created (location=${DBT_BQ_LOCATION:-EU}, maximum_bytes_billed=40 GiB — does not cap DDL)"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Resolved write destinations
# -----------------------------------------------------------------------------

# dbt_destinations V [selection args…] — one line per model/seed/snapshot of
# the current product's worktree V (or of global/):
#   resource_type <TAB> database <TAB> schema <TAB> name
# Offline (dbt ls). Returns dbt's exit status: a project that does not parse
# has no known destination. Name = package.name in an assembly project
# (global/, global-v4/: several packages).
dbt_destinations() {
  local V="${1:-}" PROJ ENGINE OUT RC
  [ $# -gt 0 ] && shift
  PROJ="$(dbt_project_dir "$V")" || return 1
  ENGINE="$(dbt_engine "$V")" || return 1
  [ -x "$ENGINE" ] || return 1
  OUT="$(cd "$PROJ" && "$ENGINE" ls --resource-type model seed snapshot \
    --output json --output-keys database schema alias name resource_type package_name "$@" 2>>"$DBT_LOG")"
  RC=$?
  printf '%s\n' "$OUT" | python3 -c '
import json, sys
glob = sys.argv[1] in ("global", "global-v4")
for line in sys.stdin:
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        n = json.loads(line)
    except ValueError:
        continue
    name = n.get("name") or ""
    if glob and n.get("package_name"):
        name = n["package_name"] + "." + name
    print("\t".join(str(x) for x in (n.get("resource_type") or "", n.get("database") or "", n.get("schema") or "", name, n.get("alias") or n.get("name") or "")))
' "$V" | sort
  return $RC
}

# -----------------------------------------------------------------------------
# Hooks — SQL that runs outside any materialization
# -----------------------------------------------------------------------------

# dbt_hook_commands V — the dbt commands that execute on-run-start/end hooks
# under engine V (plus the pre/post-hooks of whatever they build).
#   v1, dbt Core 1.x: the RunTask family — run, build, seed, snapshot, test,
#       source freshness — and retry, which replays one of them. compile,
#       show, ls, parse and docs run no hook (checked in dbt-core 1.11).
#   v2 / global, dbt v2: compile and show run the on-run-start hooks too
#       (observed with 2.0.6); docs and check (dbt 2.0.8, not probed yet) are
#       counted in as a precaution. parse and ls run none.
#   v4 / global-v4 — and any V this function does not know: the same. Never an
#       empty list: it would arm no hook check at all (fail-closed).
dbt_hook_commands() {
  case "${1:-}" in
    v1) printf '%s' "run build seed snapshot test freshness retry" ;;
    *) printf '%s' "run build seed snapshot test freshness retry clone compile show docs check" ;;
  esac
}

# What a working copy that is not the main one (a flux, an orphan — dbt_v4_role) may run in the v1/v2/global spaces,
# the main copy's: an allowlist, never a list of what is refused. DBT_FLUX_READ_CMDS is the only dbt command such a
# copy may name there — as its FIRST word that is not an option (a value given to an option before the command, as in
# `--log-level debug run`, reads as the command: refused) — and no other word may name a dbt command of
# DBT_KNOWN_CMDS (a model called `run` costs a refusal, never a missed build).
DBT_FLUX_READ_CMDS="parse ls list compile show deps"
DBT_KNOWN_CMDS="build check clean clone compile debug deps docs format freshness help init lint list login ls man parse retry run run-operation seed show snapshot source system test"

# dbt_read_only_args ARGS… — the arguments name a command of DBT_FLUX_READ_CMDS, and nothing else (see above)
dbt_read_only_args() {
  local A C0=""
  for A in "$@"; do case "$A" in -*) ;; *) C0="$A"; break ;; esac; done
  case "$C0" in ""|*[!a-z-]*) return 1 ;; esac
  case " $DBT_FLUX_READ_CMDS " in *" $C0 "*) ;; *) return 1 ;; esac
  for A in "$@"; do
    case " $DBT_KNOWN_CMDS " in *" $A "*) case " $DBT_FLUX_READ_CMDS " in *" $A "*) ;; *) return 1 ;; esac ;; esac
  done
  return 0
}

# dbt_hook_sources PROJECT_DIR — files that declare hooks, relative to the
# project: its own SQL/YAML (pre/post-hook, on-run-*), and the dbt_project.yml
# of every installed package — elementary, for one, ships on-run-start/end
# hooks that write to its own tables. Commented-out lines (YAML '#', SQL '--')
# do not count. A local package (symlink) is scanned as a package.
dbt_hook_sources() {
  local PROJ="${1:-}" RE='(pre|post)[-_]hook|on-run-(start|end)' F
  [ -d "$PROJ" ] || return 0
  {
    grep -rIniE --include='*.sql' --include='*.yml' --include='*.yaml' \
      --exclude-dir=dbt_packages --exclude-dir=dbt_modules --exclude-dir=target \
      --exclude-dir=logs --exclude-dir=.venv "$RE" "$PROJ" 2>/dev/null
    for F in "$PROJ"/dbt_packages/*/dbt_project.yml "$PROJ"/dbt_modules/*/dbt_project.yml; do
      [ -f "$F" ] && grep -HniE "$RE" "$F" 2>/dev/null
    done
  } | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(#|--)' | cut -d: -f1 | sort -u \
    | while IFS= read -r F; do printf '%s\n' "${F#"$PROJ"/}"; done
  return 0
}

# dbt_hook_sources_deep PROJECT_DIR — dbt_hook_sources, plus the files of every LOCAL package the project links in
# dbt_packages/ (a member of an assembly, a vendored package), as dbt_packages/<package>/<file>: a hook declared in a
# member's model is read too, where dbt_hook_sources reads a package's dbt_project.yml only. A link that resolves to no
# directory is listed as such (its hooks cannot be read). For the copies that are not the main one (dbt-run.sh,
# guest_hooks_guard), where any hook refuses: fail-closed.
dbt_hook_sources_deep() {
  local PROJ="${1:-}" L T F
  [ -d "$PROJ" ] || return 0
  dbt_hook_sources "$PROJ"
  for L in "$PROJ"/dbt_packages/* "$PROJ"/dbt_modules/*; do
    [ -L "$L" ] || continue
    if ! T="$(readlink -f -- "$L" 2>/dev/null)" || [ ! -d "$T" ]; then
      printf '%s\n' "${L#"$PROJ"/} (a link to no directory: its hooks cannot be read)"; continue
    fi
    dbt_hook_sources "$T" | while IFS= read -r F; do printf '%s\n' "${L#"$PROJ"/}/$F"; done
  done
  return 0
}

# dbt_hook_prints MANIFEST — one line per hook dbt would run from this manifest:
#   <fingerprint> <TAB> <unique_id> <TAB> <kind>   (kind: pre-hook, post-hook, operation)
# The fingerprint covers the hook's text AND where each source() it names resolves: the same text writes
# elsewhere once a source is redeclared. on-run-start/end are the `operation` nodes.
dbt_hook_prints() {
  python3 - "${1:?manifest}" <<'PY'
import hashlib, json, re, sys
m = json.load(open(sys.argv[1]))
src = {(s.get("package_name"), s.get("source_name"), s.get("name")): f'{s.get("database")}.{s.get("schema")}.{s.get("identifier")}'
       for s in (m.get("sources") or {}).values()}
out = set()
for k, n in (m.get("nodes") or {}).items():
    pkg = n.get("package_name") or k.split(".")[1]
    if n.get("resource_type") == "operation":
        hooks = [("operation", n.get("raw_code") or "")]
    else:
        cfg = n.get("config") or {}
        hooks = [(t, h.get("sql") if isinstance(h, dict) else str(h)) for t in ("pre-hook", "post-hook") for h in (cfg.get(t) or [])]
    for t, sql in hooks:
        rel = [src.get((pkg, a, b), "?") for a, b in re.findall(r"source\(\s*['\"]([^'\"]+)['\"]\s*,\s*['\"]([^'\"]+)['\"]", sql)]
        out.add(f'{hashlib.sha256((sql + chr(0) + chr(0).join(rel)).encode()).hexdigest()[:20]}\t{k}\t{t}')
print("\n".join(sorted(out)))
PY
}

# dbt_packages_unchecked PROJECT_DIR — true when the project declares packages
# that are not installed yet: their hooks cannot be read. (dbt v2 installs
# missing packages by itself on its first parse or compile.)
dbt_packages_unchecked() {
  local PROJ="${1:-}" F
  [ -d "$PROJ/dbt_packages" ] && [ -n "$(ls -A "$PROJ/dbt_packages" 2>/dev/null)" ] && return 1
  for F in "$PROJ/packages.yml" "$PROJ/dependencies.yml"; do
    [ -f "$F" ] && grep -qE '^[[:space:]]*-[[:space:]]*(package|git|local|tarball|private):' "$F" && return 0
  done
  return 1
}

# _dbt_packages_incomplete PROJECT_DIR — the project declares packages (packages.yml, dependencies.yml or
# package-lock.yml) and dbt_packages/ does not hold them all: fewer entries than declared (_dbt_v1_packages_missing:
# the count, transitive ones included), or a name package-lock.yml locks missing (a directory, or a link to one). dbt v2
# installs what is missing by itself on its first compile: hooks no check has read. For the copies that are not the
# main one (dbt-run.sh, guest_hooks_guard), where any unread hook refuses: fail-closed. Nothing declared: complete.
_dbt_packages_incomplete() {
  local PROJ="${1:-}" X RE='^[[:space:]]*-[[:space:]]*(package|git|local|tarball|private):'
  X="$(cat "$PROJ/packages.yml" "$PROJ/dependencies.yml" "$PROJ/package-lock.yml" 2>/dev/null | grep -cE "$RE")"
  [ "${X:-0}" -gt 0 ] || return 1
  _dbt_v1_packages_missing "$PROJ" && return 0
  [ -f "$PROJ/package-lock.yml" ] || return 1
  while IFS= read -r X; do
    [ -d "$PROJ/dbt_packages/$X" ] || return 0
  done < <(sed -nE 's/^[[:space:]]+name:[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*$/\1/p' "$PROJ/package-lock.yml")
  return 1
}

# dbt_hooks_compile_name V — the name DBT_HOOKS_COMPILE_OK gives V (after dbt_use_product): `global`, `global-v4`,
# `v4/<product>`, a product's name (its v2 and v1 — never its v4), or `project` outside a fleet.
dbt_hooks_compile_name() {
  case "${1:-}" in
    global|global-v4) printf '%s' "$1" ;;
    v4) printf 'v4/%s' "${P_NAME:-}" ;;
    *) if dbt_is_fleet; then printf '%s' "${P_NAME:-}"; else printf 'project'; fi ;;
  esac
}

# -----------------------------------------------------------------------------
# The v4 space's hooks: a proof, and its seal (fleet)
# -----------------------------------------------------------------------------
# The v4 space has no approved-hooks list. DBT_HOOKS_COMPILE_OK may name `global-v4` — compile and show only — while a
# proof of its hooks, written by the fleet's own tool (outside this template) and named by DBT_HOOKS_V4_PROOF, still
# holds for the files on disk: its ONE verdict line carries the seal it was written for, and the guard recomputes the
# seal at every compile/show. Whatever decides which hooks run there, or what they do, changes the seal: the proof is
# then to be made again. A v4/<product> has no seal of its own: listed, it is refused.
#
# dbt_hooks_v4_seal — from the workspace root: prints the seal of global-v4/ (20 hex), or returns 1 (no seal). One line
# per entry, in this order, each ended by a newline — "<sha256 hex of the file, or ->  <path from the workspace root>":
#   1. global-v4/{dbt_project,packages,dependencies,package-lock}.yml, .devcontainer/hooks.approved, profiles/v4.env
#      — in a flux (.devcontainer/flux.conf, read here, never from the environment) profiles/v4-<FLUX>.env instead, the
#      environment its global-v4 runs on: its path and its DATASET_PREFIX make the seal the flux's —,
#      profiles/profiles.yml; then the dbt_project.yml, packages.yml and dependencies.yml of every member (each
#      `- local: ../<v2|v4>/<product>/<dir>` of global-v4/packages.yml, in its order);
#   2. every file of global-v4/macros/ and of global-v4/vendor/ (optional: copies of local packages), sorted by bytes;
#   3. global-v4/dbt_packages/ — what deps really installed — by package (names sorted by bytes): a link (a member, a
#      vendor/ package) as "l<sha256 hex of its target, newline included>  <path>", a directory as every file outside
#      its own .git (a .git differs from one install to the next, and dbt never reads it);
#   4. "<sha256 hex of `$DBT_BIN_DIR/dbt --version`>  dbt --version";
# the seal is the first 20 hex of the sha256 of these lines — without a flux, the very lines of the seal before fluxes
# existed: the main copy's proof keeps its seal. No seal: a flux.conf that _dbt_flux_parse refuses, a package declared
# `local` in a form other than
# `- local: ../<v2|v4>/<product>/<dir>` or `- local: vendor/<package>`, any `local` in global-v4/dependencies.yml,
# macros/ or dbt_packages/ missing (or a link), vendor/ a link or not a directory, no package-lock.yml, no engine, a
# link, a special file or a name with a newline or a backslash in macros/, vendor/ or an installed package, at the top
# of dbt_packages/ anything but a directory or a link named like a package, a link that targets neither a member nor a
# vendor/ package, names that are not exactly those of package-lock.yml. The proof tool checks what this cannot (the
# install against package-lock.yml, the packages against a reference) before writing the seal.
dbt_hooks_v4_seal() {
  local G=global-v4 L M V X T F E4=profiles/v4.env B="${DBT_BIN_DIR:-${HOME:-/home/vscode}/.local/bin}/dbt"
  local -a A=("$G/macros")
  F="$(_dbt_flux_parse .devcontainer/flux.conf)" || return 1
  [ -z "$F" ] || E4="profiles/v4-$F.env"
  L='\blocal["'"'"']?[[:space:]]*:'
  M='^[[:space:]]*-[[:space:]]*local:[[:space:]]*\.\./(v2|v4)/([^/[:space:]]+)/([^[:space:]#]+)[[:space:]]*(#.*)?$'
  V='^[[:space:]]*-[[:space:]]*local:[[:space:]]*vendor/[A-Za-z0-9_]+/?[[:space:]]*(#.*)?$'
  # captured, never `grep -q` at the end of a pipe: under pipefail an early exit would read as "no match" (fail-open)
  X="$(grep -vE '^[[:space:]]*#' "$G/packages.yml" 2>/dev/null | grep -E "$L" | grep -vE "$M" | grep -vE "$V")"
  [ -z "$X" ] || return 1
  if [ -f "$G/dependencies.yml" ]; then
    X="$(grep -vE '^[[:space:]]*#' "$G/dependencies.yml" | grep -E "$L")"
    [ -z "$X" ] || return 1
  fi
  for X in macros dbt_packages; do { [ -d "$G/$X" ] && [ ! -L "$G/$X" ]; } || return 1; done
  if [ -e "$G/vendor" ] || [ -L "$G/vendor" ]; then
    { [ -d "$G/vendor" ] && [ ! -L "$G/vendor" ]; } || return 1
    A+=("$G/vendor")
  fi
  [ -f "$G/package-lock.yml" ] && [ -x "$B" ] || return 1
  X="$(find "${A[@]}" -mindepth 1 \( ! -type d ! -type f -o -name $'*\n*' -o -name '*\\*' \) 2>&1
       find "$G/dbt_packages" -mindepth 1 -maxdepth 1 -regextype posix-extended \( ! -type d ! -type l \
         -o -name $'*\n*' -o ! -regex '.*/[A-Za-z0-9_]+' \) 2>&1
       find "$G/dbt_packages" -mindepth 1 -maxdepth 1 -type d | while IFS= read -r T; do
         find "$T" -mindepth 1 -path "$T/.git" -prune -o \( ! -type d ! -type f -o -name $'*\n*' -o -name '*\\*' \) -print 2>&1
       done)"
  [ -z "$X" ] || return 1
  T="$( { sed -nE "s@$M@\1/\2/\3@p" "$G/packages.yml" 2>/dev/null | sed 's@/$@@'
          if [ -d "$G/vendor" ]; then find "$G/vendor" -mindepth 1 -maxdepth 1 -type d; fi; } |
         while IFS= read -r X; do realpath -e -- "$X" 2>/dev/null || echo '?'; done)"
  X="$(find "$G/dbt_packages" -mindepth 1 -maxdepth 1 -type l | while IFS= read -r X; do
         realpath -e -- "$X" 2>/dev/null | grep -qxF -f <(printf '%s\n' "$T") || echo "$X"; done)"
  [ -z "$X" ] || return 1
  [ "$(find "$G/dbt_packages" -mindepth 1 -maxdepth 1 -printf '%f\n' | LC_ALL=C sort)" = \
    "$(sed -nE 's/^[[:space:]]+name:[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*$/\1/p' "$G/package-lock.yml" | LC_ALL=C sort)" ] || return 1
  { { printf '%s\n' "$G/dbt_project.yml" "$G/packages.yml" "$G/dependencies.yml" "$G/package-lock.yml" \
        .devcontainer/hooks.approved "$E4" profiles/profiles.yml
      sed -nE "s@$M@\1/\2/\3@p" "$G/packages.yml" 2>/dev/null | sed 's@/$@@' |
        while IFS= read -r X; do printf '%s\n' "$X/dbt_project.yml" "$X/packages.yml" "$X/dependencies.yml"; done
    } | while IFS= read -r X; do
          if [ -f "$X" ]; then printf '%s  %s\n' "$(sha256sum < "$X" | cut -d' ' -f1)" "$X"
          else printf -- '-  %s\n' "$X"; fi
        done
    find "${A[@]}" -type f | LC_ALL=C sort | xargs -r -d '\n' sha256sum --
    find "$G/dbt_packages" -mindepth 1 -maxdepth 1 | LC_ALL=C sort | while IFS= read -r X; do
      if [ -L "$X" ]; then printf 'l%s  %s\n' "$(readlink -- "$X" | sha256sum | cut -d' ' -f1)" "$X"
      else find "$X" -mindepth 1 -path "$X/.git" -prune -o -type f -print | LC_ALL=C sort | xargs -r -d '\n' sha256sum --
      fi
    done
    printf '%s  dbt --version\n' "$("$B" --version 2>/dev/null | sha256sum | cut -d' ' -f1)"
  } | sha256sum | cut -c1-20
}

# dbt_hooks_v4_verdict PROOF SEAL [FLUX] — does the proof hold for SEAL (the seal now)? Required: exactly one line
# naming « VERDICT HOOKS GLOBAL-V4 », and it is exactly — anchored, nothing before or after, LF —
#   VERDICT HOOKS GLOBAL-V4 : PREUVE OK ; TÉMOINS OK ; sceau <20 hex>                 (the main copy)
#   VERDICT HOOKS GLOBAL-V4 FLUX <FLUX> : PREUVE OK ; TÉMOINS OK ; sceau <20 hex>     (in flux FLUX)
# no « PREUVE HOOKS » line (an older banner), no other seal quoted anywhere (« sceau », then spaces, colons or
# backquotes, then 20 hex — any case), and that seal is SEAL. Both conditions of the proof (PREUVE OK: every hook is an
# approved one; TÉMOINS OK: the proof was seen refusing) stand on the seal's line. A proof written for the main copy
# never holds in a flux, nor one written for a flux anywhere else (the seals differ too). return 1: it does not hold.
dbt_hooks_v4_verdict() {
  local F="$1" S X="GLOBAL-V4"
  if [ -n "${3:-}" ]; then [[ "$3" =~ $DBT_V4_FLUX_RE ]] || return 1; X="GLOBAL-V4 FLUX $3"; fi
  [ -f "$F" ] && [ "$(grep -c 'VERDICT HOOKS GLOBAL-V4' "$F")" = 1 ] && [ "$(grep -c 'PREUVE HOOKS' "$F")" = 0 ] \
    && [ "$(grep -oiE 'sceau[ :`]*[0-9a-f]{20}' "$F" | wc -l)" = 1 ] || return 1
  S="$(sed -nE "s/^VERDICT HOOKS $X : PREUVE OK ; TÉMOINS OK ; sceau ([0-9a-f]{20})\$/\\1/p" "$F")"
  [ -n "$S" ] && [ "$S" = "${2:-}" ]
}

# dbt_hooks_v4_verdict_line SEAL [FLUX] — the one verdict line a proof writes for SEAL (and FLUX): what the proof tool
# of the fleet prints, and what dbt_hooks_v4_verdict accepts
dbt_hooks_v4_verdict_line() { printf 'VERDICT HOOKS GLOBAL-V4%s : PREUVE OK ; TÉMOINS OK ; sceau %s\n' "${2:+ FLUX $2}" "${1:-}"; }

# dbt_hooks_v4_proof_path [FLUX] — the proof of global-v4's hooks THIS copy reads, from the workspace root: the main
# copy's is DBT_HOOKS_V4_PROOF; a flux's (FLUX, default DBT_V4_FLUX) is its own file, the same path with -<FLUX> before
# the extension of its last component (docs/global-v4/HOOKS_V4.md -> docs/global-v4/HOOKS_V4-H.md; no extension:
# -<FLUX> appended). Each verdict needs ONE verdict line in its file (dbt_hooks_v4_verdict): the harmonized line's
# proof written into the main copy's file would refuse the main copy's compile the day the two branches meet. Empty
# while DBT_HOOKS_V4_PROOF is.
dbt_hooks_v4_proof_path() {
  local P="${DBT_HOOKS_V4_PROOF:-}" F="${1-${DBT_V4_FLUX:-}}" D="" B
  if [ -z "$P" ] || [ -z "$F" ]; then printf '%s' "$P"; return 0; fi
  case "$P" in */*) D="${P%/*}/" ;; esac
  B="${P##*/}"
  case "$B" in
    ?*.*) printf '%s%s-%s.%s' "$D" "${B%.*}" "$F" "${B##*.}" ;;
    *)    printf '%s%s-%s' "$D" "$B" "$F" ;;
  esac
}

# -----------------------------------------------------------------------------
# Lifecycle entry point
# -----------------------------------------------------------------------------

# _dbt_v1_deps — v1 only: dbt Core installs what package-lock.yml says. dbt v2
# would re-resolve and rewrite that tracked file — a migration step, not a
# hook's.
# _dbt_v1_packages_missing PROJ — fewer directories in dbt_packages/ than
# packages declared (the count dbt Core itself compares: "found 3 package(s)
# specified in packages.yml, but only 2 package(s) installed"), or than
# package-lock.yml lists, transitive ones included (an installed transitive
# package would otherwise hide a missing declared one). A failed deps (a
# private git host refused) leaves the hub packages in place: the directory
# alone does not mean the install is complete.
_dbt_v1_packages_missing() {
  local PROJ="$1" F N=0 L=0 I RE='^[[:space:]]*-[[:space:]]*(package|git|local|tarball|private):'
  [ -d "$PROJ/dbt_packages" ] || return 0
  for F in "$PROJ/packages.yml" "$PROJ/dependencies.yml"; do
    [ -f "$F" ] || continue
    N=$((N + $(grep -cE "$RE" "$F")))
  done
  [ -f "$PROJ/package-lock.yml" ] && L="$(grep -cE "$RE" "$PROJ/package-lock.yml")"
  [ "$L" -gt "$N" ] && N="$L"
  I="$(find "$PROJ/dbt_packages" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) 2>/dev/null | wc -l)"
  [ "$I" -lt "$N" ]
}

_dbt_v1_deps() {
  local PROJ
  [ -x "$DBT_V1_VENV/bin/dbt" ] && PROJ="$(dbt_project_dir v1)" || return 0
  [ -f "$PROJ/packages.yml" ] || [ -f "$PROJ/dependencies.yml" ] || return 0
  _dbt_v1_packages_missing "$PROJ" || return 0
  echo "[dbt] ${P_TAG}v1 packages (dbt deps)..."
  # one retry: a git host may refuse a burst of SSH connections (several
  # products installing private packages in a row) — observed, transient
  if ( cd "$PROJ" && GIT_TERMINAL_PROMPT=0 DBT_PROFILES_DIR="$DBT_WS/profiles" "$DBT_V1_VENV/bin/dbt" deps >>"$DBT_LOG" 2>&1 ) \
     || { sleep 5; ( cd "$PROJ" && GIT_TERMINAL_PROMPT=0 DBT_PROFILES_DIR="$DBT_WS/profiles" "$DBT_V1_VENV/bin/dbt" deps >>"$DBT_LOG" 2>&1 ); }; then
    echo "  dbt deps done"
  else
    echo "  WARNING: dbt deps failed twice (details: $DBT_LOG) — retry: $(dbt_just_cmd v1) deps"
  fi
}

# dbt_engines WORKSPACE — only the two engines, from onCreateCommand: the
# editor connects (and the dbt extensions start, dbt Power User spawning
# /opt/dbt-v1/bin/python) once onCreateCommand is done, while
# postCreateCommand still runs. Both engines live in the container
# filesystem, gone at each rebuild: installed here they are in place before
# the extensions look for them; dbt_process then finds them up to date.
dbt_engines() {
  dbt_load_conf "${1:-}"
  [ -f "$DBT_CONF" ] || return 0
  if ! _dbt_owns_container; then
    echo "[dbt] engines: the container's, installed by the main copy (${DBT_V4_MAIN_WS:-?}) — never from this copy"
    _dbt_guest_engines
    return 0
  fi
  export PATH="${HOME:-/home/vscode}/.local/bin:$PATH"
  if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh 2>/dev/null | sh >/dev/null 2>&1 \
      || echo "  WARNING: uv install failed — the dbt Core venv is left to post-create"
  fi
  echo "[dbt] engine v1 — dbt Core 1.x..."
  dbt_ensure_v1_venv
  echo "[dbt] engine v2 — dbt v2..."
  dbt_ensure_v2
  return 0
}

# dbt_process WORKSPACE MODE — MODE 'create' also installs the v1 packages.
dbt_process() {
  local MODE="${2:-start}" N
  dbt_load_conf "${1:-}"
  if [ ! -f "$DBT_CONF" ]; then
    echo "[dbt] no .devcontainer/dbt.conf — nothing to manage"
    return 0
  fi
  _dbt_load_token
  case "$(dbt_v4_role)" in
    flux)    echo "[dbt] working copy: flux $DBT_V4_FLUX — this copy only; the container (engines, ~/.bashrc, global git settings) is the main copy's (${DBT_V4_MAIN_WS:-?})"
             [ "$DBT_V4_FLUX" != H ] || echo "[dbt] flux H: the HARMONIZED line — its v4 writes under $(dbt_v4_prefix) only, where the main copy's ISO line never writes"
             [ "$DBT_V4_FLUX" != H ] || echo "[dbt] flux H, in git: its v4 worktrees follow <product>/v4-h (v4-h where the products' branches live), no push of it reaches v1, v2 nor v4 (pre-push guard), its lock is products-h.lock" ;;
    refused) echo "[dbt] working copy: flux declaration refused — this copy only; the container is left to the main copy (${DBT_V4_MAIN_WS:-?})" ;;
    orphan)  echo "[dbt] working copy: ORPHAN — neither the main copy (DBT_V4_MAIN_WS) nor a flux: no v4 space here$( _dbt_owns_container || echo "; the container is left to the main copy")" ;;
  esac
  echo "[dbt] upstream access..."
  dbt_git_setup
  if _dbt_is_line_h; then
    echo "[dbt] push guard of the harmonized line (pre-push)..."
    dbt_ensure_push_guard_h
  fi
  if dbt_is_fleet; then
    echo "[dbt] data products (.devcontainer/products.conf)..."
    [ -n "$(dbt_products)" ] || echo "  none yet — add one: just product-add <name> <git-url> [branch] [subdir]"
    for N in $(dbt_products); do
      if ! printf '%s' "$N" | grep -Eq "$DBT_PRODUCT_RE"; then
        echo "  WARNING: invalid product name '$N' in products.conf (lowercase, digits, '-') — skipped"
        continue
      fi
      dbt_use_product "$N" && dbt_ensure_worktrees
    done
    for N in $(dbt_referents); do
      if ! printf '%s' "$N" | grep -Eq "$DBT_PRODUCT_RE"; then
        echo "  WARNING: invalid referent name '$N' in referents.conf (lowercase, digits, '-') — skipped"
        continue
      fi
      if _dbt_products_lines | awk -v n="$N" '$1==n {f=1} END {exit !f}'; then
        echo "  WARNING: '$N' is declared in products.conf AND referents.conf — the referent is ignored"
        continue
      fi
      dbt_use_product "$N" && dbt_ensure_worktrees
    done
    # a worktree branch (<product>/v2) and its counterpart in the product's
    # own repository (v2) differ by name: \`git push\` must follow the upstream
    git -C "$DBT_WS" config push.default upstream 2>/dev/null || true
    if [ "$MODE" = "start" ] && [ "${DBT_SYNC_ON_START:-1}" != "0" ]; then
      echo "[dbt] sync with where the products' branches live..."
      for N in $(dbt_members); do dbt_use_product "$N" && dbt_sync; done
    fi
  else
    echo "[dbt] worktrees..."
    dbt_use_product "" && dbt_ensure_worktrees
  fi
  dbt_use_product "" >/dev/null 2>&1 || true
  if _dbt_owns_container; then
    echo "[dbt] engine v1 — dbt Core 1.x..."
    dbt_ensure_v1_venv
    echo "[dbt] engine v2 — dbt v2..."
    dbt_ensure_v2
  else
    echo "[dbt] engines — the container's, the main copy's (never installed nor rebuilt from this copy)..."
    _dbt_guest_engines
  fi
  if dbt_is_fleet; then
    echo "[dbt] global project..."
    dbt_ensure_global
    echo "[dbt] v4 space (profiles/v4.env)..."
    dbt_ensure_v4_env
  fi
  echo "[dbt] profile hub..."
  dbt_ensure_profiles
  dbt_ensure_editor_files
  dbt_shell_integration
  if [ "$MODE" = "create" ]; then
    for N in $(dbt_products); do dbt_use_product "$N" && _dbt_v1_deps; done
    dbt_use_product "" >/dev/null 2>&1 || true
  fi
  echo "[dbt] BigQuery auth..."
  dbt_gcloud_status
  if [ "$MODE" = "create" ]; then
    # the dbt extensions looked for projects and engines when the window
    # opened, i.e. before this hook had put them (back) in place
    echo "[dbt] ready -> reload the VS Code window (Developer: Reload Window) so both dbt extensions see the worktrees and the engines"
  fi
  return 0
}
