{%- if secrets_source == 'keyvault' -%}
# =============================================================================
# {{ project_name }} — PAS DE .env : les secrets viennent d'Azure Key Vault
# =============================================================================
# Ce projet lit ses variables dans .env.refs (versionné, aucune valeur
# secrète), résolu EN MÉMOIRE par le lanceur `secrets` avec ton identité az.
# Ne crée pas de .env : un .env restant est ignoré par les scripts du
# container (jamais supprimé d'office) ; supprime-le quand .env.refs couvre tout.
#
# Une fois par Docker host (la session survit au rebuild, volume
# devcontainer-azure-profils) :
#   az login --use-device-code --tenant 53a0f5d2-129f-454e-9ed3-1f5fed0e66e5
#   secrets qui                      # ton compte et ton coffre perso
#   secrets set kv://perso/github-pat   # ton jeton GitHub (saisie masquée) :
#                                       # gh et git https le lisent, plus de PAT partagé
#   secrets check                    # chaque référence se résout ? (noms seulement)
#   bash .devcontainer/post-start.sh # (re)démarre serveurs MCP et hooks avec les secrets
#
# Container partagé à deux : kv://perso/… lit le coffre de CELUI QUI A FAIT
# `az login`. Chacun peut prendre sa propre session dans son terminal :
#   profil <alias>        # alias de personnes.conf (jbmack, gvarga…)
#   az login …            # la première fois dans ce profil
# Puis `claude`, `gh`, `git` et `secrets` de ce terminal utilisent ton identité,
# et tes commits sont signés à ton nom GitHub.
#
# Tous les jours :
#   claude                           # = secrets run -- claude (repli sans secrets si az KO)
#   secrets run -- just dev          # toute autre commande qui a besoin des variables
#
# Détails : .devcontainer/README.md (« Secrets Key Vault »).
{%- else -%}
# =============================================================================
# {{ project_name }} — Variables d'environnement
# Copier vers .env et remplir les valeurs. Ne jamais committer .env.
{%- if enable_ecc_stack | default(false) %}
#
# Stack S/4HANA (sap-adt-mcp sur port 8000). Pour la seconde instance ECC
# EHP8 (port 8001), voir .env.ecc.example → .env.ecc.
{%- endif %}
# =============================================================================

# --- GitHub ---
GITHUB_PERSONAL_ACCESS_TOKEN=
{%- if project_type != "base" %}

# --- SAP Connexion (HTTP/ADT) ---
SAP_URL=https://192.168.50.112:44300
SAP_USER=DEVELOPER
SAP_PASSWORD=
SAP_CLIENT=100
SAP_LANGUAGE=FR
SAP_VERIFY_SSL=false

# Mode de déploiement (adt, rfc, local)
DEPLOYMENT_MODE=adt

# Désactiver la vérification TLS (certificat auto-signé SAP dev)
NODE_TLS_REJECT_UNAUTHORIZED=0
{%- endif %}
{%- if project_type == "mcp-server" or project_type == "abap-project" %}

# --- SAP RFC (pyrfc / node-rfc) ---
SAP_ASHOST=192.168.50.112
SAP_SYSNR=00
# Liste blanche des fonctions RFC autorisées (séparées par virgules, vide = toutes)
SAP_RFC_ALLOWLIST=
{%- endif %}
{%- if project_type == "mcp-server" %}

# --- SAP GUI VM (Windows) — héberge sap-gui-mcp (remote) ---
# L'URL du serveur sap-gui-mcp se règle dans .mcp.json (entrée sap-gui-mcp),
# pas ici. MCP_VM_USER/MCP_VM_PORT servent à l'outillage VM (WinRM/Ansible).
MCP_VM_USER=
MCP_VM_PORT=8001

# SAP WebGUI (transaction browser) — quotes obligatoires (le fichier est
# sourcé par les hooks : un '&' non quoté casse le chargement du .env)
SAP_WEBGUI_URL="https://192.168.50.112:44300/sap/bc/gui/sap/its/webgui?sap-client=100&sap-language=FR"

# Connexion SAP GUI (format: "nom_connexion" dans saplogon.ini)
SAP_CONNECTION=

# --- Serveur MCP ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- sap-adt-mcp — SAP Docs semantic search (optionnel) ---
# Activé automatiquement si data/sap_docs.sqlite existe + une de ces clés est
# définie. Sans clé, fallback BM25 (plein-texte, sans embeddings).
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
{%- endif %}
{%- if project_type == "abap-project" or project_type == "fabric-pipeline" %}

# --- HANA Direct ---
SAP_HANA_HOST=192.168.50.111
SAP_HANA_PORT=30041
SAP_HANA_USER=SAPHANADB
SAP_HANA_PASSWORD=
SAP_HANA_SCHEMA=SAPHANADB
{%- endif %}
{%- if project_type == "fabric-pipeline" %}

# --- Azure / Microsoft Fabric ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
{%- if enable_iac %}
AZURE_SUBSCRIPTION_ID_DEV=
AZURE_SUBSCRIPTION_ID_PRD=
{%- else %}
AZURE_SUBSCRIPTION_ID=
{%- endif %}

# OneLake / Fabric
ONELAKE_WORKSPACE_ID=
ONELAKE_LAKEHOUSE_ID=
FABRIC_CAPACITY_ID=

# ADLS Gen2 (accès direct)
AZURE_STORAGE_ACCOUNT=
AZURE_ADLS_ENDPOINT=
AZURE_SAS_TOKEN=
{%- endif %}
{%- if enable_iac and project_type != "fabric-pipeline" %}

# --- Azure IaC (souscriptions DEV / PRD) ---
AZURE_SUBSCRIPTION_ID_DEV=
AZURE_SUBSCRIPTION_ID_PRD=
{%- endif %}
{%- if enable_iac %}

# --- OpenTofu State Storage (généré par bootstrap) ---
TF_STATE_RESOURCE_GROUP_DEV=rg-{{ iac_short_name }}-tfstate-dev
TF_STATE_STORAGE_ACCOUNT_DEV=st{{ iac_short_name }}tfstatedev
TF_STATE_RESOURCE_GROUP_PRD=rg-{{ iac_short_name }}-tfstate-prd
TF_STATE_STORAGE_ACCOUNT_PRD=st{{ iac_short_name }}tfstateprd
{%- endif %}
{%- endif %}
